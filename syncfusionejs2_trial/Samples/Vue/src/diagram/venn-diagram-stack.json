{"public/index.html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n\r\n<head>\r\n    <meta charset=\"utf-8\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\r\n    <link rel=\"icon\" href=\"<%= BASE_URL %>favicon.ico\">\r\n    <title>\r\n        <%= htmlWebpackPlugin.options.title %>\r\n    </title>\r\n    <link href=\"https://cdn.syncfusion.com/ej2/33.1.44/{{theme}}.css\" rel=\"stylesheet\">\r\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\" />\r\n</head>\r\n\r\n<body>\r\n    <noscript>\r\n        <strong>We're sorry but <%= htmlWebpackPlugin.options.title %> doesn't work properly without JavaScript enabled.\r\n        Please enable it to continue.</strong>\r\n    </noscript>\r\n    <div id=\"app\"></div>\r\n    <style>\r\n            .control-section\r\n            {\r\n                margin-top: 100px;\r\n            }\r\n    </style>\r\n    <!-- built files will be auto injected -->\r\n</body>\r\n\r\n</html>\r\n","src/App.vue":"<template>\n\n  <div class=\"col-lg-12 control-section\">\n    <div id=\"wrapper-diagram\">\n      <ejs-diagram ref=\"diagramObject\" id=\"diagram\" :width='width' :height='height' :nodes='nodes'\n        :connectors='connectors' :snapSettings='snapSettings' :tool='tool' @created='created' @load='load'>\n      </ejs-diagram>\n    </div>\n  </div>\n\n</template>\n<style scoped></style>\n<script>\nimport {\n  DiagramComponent, SnapConstraints, DiagramTools, PortVisibility,\n} from \"@syncfusion/ej2-vue-diagrams\";\n\nexport default {\n  components: {\n    'ejs-diagram': DiagramComponent\n  },\n  data: function () {\n    return {\n      width: '100%',\n      height: '700px',\n      nodes: [],\n      connectors: [],\n      snapSettings: { constraints: SnapConstraints.None },\n      tool: DiagramTools.ZoomPan,\n      diagram: null,\n      diagramCreated: false\n    };\n  },\n  mounted: function () {\n    this.initializeDiagram();\n  },\n  methods: {\n    initializeDiagram() {\n      //Annotation Content\n      const trigonometryContent = 'Trigonometry is a branch \\nof mathematics that studies \\nthe relationship between \\nthe sides and angles of triangles.';\n      const assemblyContent = 'An assembly is a collection \\n of types and resources \\nbuilt to work together as \\na logical and functional unit.';\n      const middlewareContent = 'Software that acts as \\na bridge between an operating system\\n or database and applications,\\n especially over a network.';\n      const thesisContent = 'A statement or theory\\n put forward as a premise \\nto be maintained or proved.';\n      const expertiseContent = 'Expert skill or knowledge \\nin a particular field.';\n      const programmingContent = 'Programming is the process \\nof writing code that tells \\na computer application or \\nsoftware program what to do.';\n\n      // Path Shapes\n      const assemblyPath = 'M24.3267 27.4281H1.99727C0.894207 27.4281 0 26.551 0 25.469V2.93873C0 1.31571 1.34131 0 2.9959 0H8.10891C8.78495 0.0022957 9.44005 0.230314 9.96637 0.646519L13.9609 3.70279C14.1374 3.83974 14.3551 3.91551 14.5801 3.9183H23.0485C24.7031 3.9183 26.0444 5.23401 26.0444 6.85703V9.79575H29.0003C30.0366 9.80121 30.9975 10.3282 31.5449 11.1913C32.0923 12.0545 32.1496 13.1328 31.6966 14.0471L26.1642 26.331C25.8219 27.0166 25.1048 27.4448 24.3267 27.4281ZM2.61621 25.469H24.3265L29.819 13.2243C30.0052 12.9162 30.0052 12.5331 29.819 12.2251C29.6396 11.9284 29.3118 11.7489 28.9602 11.7549H10.2458C9.86524 11.7587 9.51861 11.9703 9.347 12.3035L2.61621 25.469ZM2.99668 1.95911C2.44515 1.95911 1.99805 2.39768 1.99805 2.93868V22.4126L7.55045 11.5198C8.05333 10.5213 9.0915 9.89056 10.2268 9.89366H23.988V6.95494C23.9773 6.41831 23.5364 5.98579 22.9893 5.97536H14.5209C13.8475 5.97709 13.1932 5.75624 12.6635 5.34844L8.66892 2.27257C8.49247 2.13563 8.27475 2.05985 8.04977 2.05706L2.99668 1.95911Z';\n      const middlewarePath = 'M28 12.56V32H8V26H0V0H13.44L19.44 6H21.44L28 12.56ZM8 6H16.58L12.58 2H2V24H8V6ZM26.001 14H20.001V8H10.001V30H26.001V14ZM21.999 12H24.579L21.999 9.41998V12Z';\n      const thesisPath = 'M22.7097 24.7742L24.7742 22.7097V28.9032H0V8.25806H2.06452V26.8387H22.7097V24.7742ZM20.6452 16.5161C19.2688 16.5161 17.9194 16.6559 16.5968 16.9355C15.2849 17.2043 14.0161 17.6075 12.7903 18.1452C11.5645 18.672 10.3925 19.3226 9.27419 20.0968C8.16667 20.8602 7.13978 21.7312 6.19355 22.7097V20.6452C6.19355 19.3118 6.36559 18.0323 6.70968 16.8065C7.05376 15.5699 7.53763 14.4194 8.16129 13.3548C8.7957 12.2796 9.54839 11.3065 10.4194 10.4355C11.3011 9.55376 12.2742 8.80107 13.3387 8.17742C14.414 7.54301 15.5645 7.05376 16.7903 6.70968C18.0269 6.36559 19.3118 6.19355 20.6452 6.19355V0L32 11.3548L20.6452 22.7097V16.5161ZM22.7097 8.25806C22.0538 8.25806 21.4409 8.26344 20.871 8.27419C20.3011 8.27419 19.7419 8.30107 19.1935 8.35484C18.6559 8.4086 18.1129 8.50538 17.5645 8.64516C17.0161 8.77419 16.4355 8.96774 15.8226 9.22581C14.8871 9.6129 14.0161 10.1075 13.2097 10.7097C12.414 11.3118 11.6989 12 11.0645 12.7742C10.4409 13.5376 9.9086 14.371 9.46774 15.2742C9.03763 16.1667 8.72043 17.1075 8.51613 18.0968C10.3226 16.8925 12.2527 15.9839 14.3065 15.371C16.3602 14.7581 18.4731 14.4516 20.6452 14.4516H22.7097V17.7258L29.0806 11.3548L22.7097 4.98387V8.25806Z';\n      const calendarPath = 'M9.0833333,10.083334 L11,10.083334 11,12 9.0833333,12 z M1,5 L1,14 13,14 13,5 z M1,2 L1,4 13,4 13,2 12,2 12,2.5 C12,2.776 11.776,3 11.5,3 11.224,3 11,2.776 11,2.5 L11,2 3,2 3,2.5 C3,2.776 2.776,3 2.5,3 2.224,3 2,2.776 2,2.5 L2,2 z M2.5,0 C2.776,0 3,0.22399998 3,0.5 L3,1 11,1 11,0.5 C11,0.22399998 11.224,0 11.5,0 11.776,0 12,0.22399998 12,0.5 L12,1 14,1 14,4 14,5 14,15 0,15 0,5 0,4 0,1 2,1 2,0.5 C2,0.22399998 2.224,0 2.5,0 z';\n      const notesPath = 'M11,4.7110004 L11,6 12.289001,6 z M5,4 L5,15 13,15 13,7 10,7 10,4 z M1,1 L1,12 4,12 4,3 8.2890015,3 6.2890015,1 z M0,0 L6.7109985,0 9.7109985,3 10.710999,3 14,6.2890015 14,16 4,16 4,13 0,13 z';\n      const pastePath = 'M24 32H0V3.99981H8C8.01001 3.469 8.12559 2.94549 8.34 2.4598C8.55076 1.99273 8.84184 1.56626 9.2 1.19979C9.56763 0.828696 10.0019 0.530157 10.48 0.319788C11.4554 -0.106596 12.5646 -0.106596 13.54 0.319788C14.4839 0.757643 15.2421 1.51586 15.68 2.4598C15.8875 2.9469 15.9963 3.47036 16 3.99981H24V32ZM22 11.9999V5.99983H20V9.99985H4V5.99983H2V30H22M6 5.99988V7.99989H18V5.99988H14V4.25987C13.9895 3.96985 13.9493 3.68167 13.88 3.39986C13.816 3.13337 13.7005 2.88198 13.54 2.65986C13.3845 2.4358 13.1791 2.25094 12.94 2.11986C12.6391 2.01205 12.3183 1.9711 12 1.99986C11.5422 1.94796 11.084 2.09343 10.74 2.39986C10.4674 2.68388 10.2623 3.02569 10.14 3.39986C10.0201 3.829 9.97282 4.27514 10 4.71987V5.99988H6Z';\n\n      // --- Create Ports ---\n      const programmingPort1 = this.createPort('port1', 0.82, 0.35);\n      const programmingPort2 = this.createPort('port2', 0.50, 0.8);\n      const thesisPort = this.createPort('port1', -0.5, 0.5);\n      const middlewarePort = this.createPort('port1', 1.5, 0.5);\n      const assemblyPort = this.createPort('port1', -0.5, 0.5);\n      const trigonometryPort = this.createPort('port1', 0.50, 0.8);\n\n      // --- Create Annotations ---\n      const trigonometryAnnotation = this.createAnnotations('Trigonometry', trigonometryContent, { x: 0.86, y: 0.30 }, { x: 0.46, y: 0.44 }, 'Right', undefined, 'Left');\n      const assemblyAnnotation = this.createAnnotations('Assembly', assemblyContent, { x: 1.3, y: 0.2 }, { x: 1.3, y: 1.9 }, 'Left', undefined, 'Left', undefined, 'Left', 240, 150);\n      const middlewareAnnotation = this.createAnnotations('Middleware', middlewareContent, { x: -0.4, y: 0.1 }, { x: -0.3, y: 1.7 }, 'Right', undefined, 'Right', undefined, 'Right', 240, 150);\n      const thesisAnnotation = this.createAnnotations('Thesis', thesisContent, { x: 1.3, y: 0.2 }, { x: 1.3, y: 2 }, 'Left', undefined, 'Left', undefined, 'Left', 240, 150);\n      const expertiseAnnotation = this.createAnnotations('Expertise', expertiseContent, { x: 0.5, y: 0.7 }, { x: 0.5, y: 0.80 });\n      const programmingAnnotation = this.createAnnotations('Programming', programmingContent, { x: 0.24, y: 0.3 }, { x: 0.18, y: 0.44 }, 'Left', undefined, 'Left', undefined);\n      programmingAnnotation.push({\n        content: 'Data\\n Science',\n        offset: { x: 0.91, y: 0.7 },\n        horizontalAlignment: 'Right',\n        style: { bold: true, fontFamily: 'Roboto', fontSize: 16 }\n      });\n\n      // --- Create Nodes ---\n      this.nodes = [\n        this.createNode('trigonometry', 615, 255, 350, 350, '#4582F966', '#4582F966', 'Basic', undefined, trigonometryAnnotation, [trigonometryPort]),\n        this.createNode('expertise', 500, 465, 350, 350, '#E86F6D66', '#E86F6D66', 'Basic', undefined, expertiseAnnotation),\n        this.createNode('programming', 390, 255, 350, 350, '#2DC28666', '#2DC28666', 'Basic', undefined, programmingAnnotation, [programmingPort1, programmingPort2]),\n        this.createNode('assemblyNode', 760, 35, 32, 28, '#1D747A', '#1D747A', 'Path', assemblyPath, assemblyAnnotation, [assemblyPort]),\n        this.createNode('middlewareNode', 250, 500, 28, 32, '#1E7649', '#1E7649', 'Path', middlewarePath, middlewareAnnotation, [middlewarePort]),\n        this.createNode('thesisNode', 800, 500, 32, 28, '#3A2C7D', '#3A2C7D', 'Path', thesisPath, thesisAnnotation, [thesisPort]),\n        this.createNode('calendarNode', 495, 500, 32, 32, '#952B2A', '#952B2A', 'Path', calendarPath),\n        this.createNode('notesNode', 338, 150, 22, 28, '#187851', '#187851', 'Path', notesPath),\n        this.createNode('pasteNode', 690, 150, 24, 32, '#213895', '#213895', 'Path', pastePath)\n      ];\n\n      // --- Create Connectors ---\n      const middlewareToProgramming = this.createConnector('middlewareToProgramming', '', 'middlewareNode', 'programming', '#494949', 1, 'port1', 'port2');\n      const assemblyToProgramming = this.createConnector('assemblyToProgramming', '', 'assemblyNode', 'programming', '#494949', 1, 'port1', 'port1');\n      assemblyToProgramming.segments = [{\n        type: 'Bezier',\n        vector1: { angle: 190, distance: 100 },\n        vector2: { angle: 280, distance: 100 }\n      }];\n      const thesisToTrigonometry = this.createConnector('thesisToTrigonometry', '', 'thesisNode', 'trigonometry', '#494949', 1, 'port1', 'port1');\n\n      this.connectors = [middlewareToProgramming, assemblyToProgramming, thesisToTrigonometry];\n    },\n    /**\n     * Creates a ConnectorModel object for the diagram.\n     * @param id The unique identifier for the connector.\n     * @param lineDashArray The dash array for the connector's stroke.\n     * @param source The ID of the source node.\n     * @param target The ID of the target node.\n     * @param lineColor The color of the connector's stroke.\n     * @param lineWidth The width of the connector's stroke.\n     * @param sourcePortId The ID of the source port.\n     * @param targetPortId The ID of the target port.\n     * @returns A ConnectorModel object configured with the provided properties.\n     */\n    createConnector(id, lineDashArray, source, target,\n      lineColor, lineWidth, sourcePortId, targetPortId) {\n      const connector = {\n        id: id,\n        sourceID: source,\n        targetID: target,\n        type: 'Bezier',\n        bezierSettings: { allowSegmentsReset: false },\n        style: {\n          strokeColor: lineColor,\n          strokeWidth: lineWidth,\n          strokeDashArray: lineDashArray\n        },\n        targetDecorator: {\n          shape: 'Circle',\n          width: 6,\n          height: 6,\n          style: {\n            strokeColor: '#1D747A',\n            fill: '#1D747A'\n          }\n        },\n        sourceDecorator: {\n          shape: 'Circle',\n          width: 6,\n          height: 6,\n          style: {\n            strokeColor: '#1D747A',\n            fill: '#1D747A'\n          }\n        },\n        sourcePortID: sourcePortId,\n        targetPortID: targetPortId\n      };\n      return connector;\n    },\n    /**\n     * Creates a node object for the Vue Diagram.\n     * @param id The unique identifier for the node.\n     * @param offsetX The x-coordinate of the node's position.\n     * @param offsetY The y-coordinate of the node's position.\n     * @param width The width of the node.\n     * @param height The height of the node.\n     * @param fill The background color of the node.\n     * @param strokeColor The border color of the node.\n     * @param shape The shape type of the node ('Basic' or 'Path').\n     * @param pathData The data for the path shape (if applicable).\n     * @param annotations An array of annotation objects for the node.\n     * @param ports An array of port objects for the node.\n     * @returns A NodeModel object configured with the provided properties.\n     */\n    createNode(id, offsetX, offsetY, width, height,\n      fill, strokeColor, shape, pathData, annotations, ports) {\n      const style = {\n        fill: fill,\n        strokeColor: strokeColor\n      };\n\n      const node = {\n        id: id,\n        offsetX: offsetX,\n        offsetY: offsetY,\n        width: width,\n        height: height,\n        annotations: annotations,\n        ports: ports,\n        style: style\n      };\n\n      if (shape === 'Basic') {\n        node.shape = {\n          type: 'Basic',\n          shape: 'Ellipse'\n        };\n      }\n      else {\n        node.shape = {\n          type: 'Path',\n          data: pathData\n        };\n        node.style.strokeWidth = 0;\n      }\n      return node;\n    },\n    /**\n     * Creates an array of ShapeAnnotationModel objects for a diagram node.\n     * @param content1 The content for the first primary annotation.\n     * @param content2 The content for the second annotation.\n     * @param offset1 The offset for the first annotation.\n     * @param offset2 The offset for the second annotation.\n     * @param hAlign1 Horizontal alignment for the first annotation.\n     * @param vAlign1 Vertical alignment for the first annotation.\n     * @param hAlign2 Horizontal alignment for the second annotation.\n     * @param vAlign2 Vertical alignment for the second annotation.\n     * @param textAlign Text alignment for the second annotation's style.\n     * @param width The width for the second annotation.\n     * @param height The height for the second annotation.\n     * @returns An array of ShapeAnnotationModel objects.\n     */\n    createAnnotations(content1, content2, offset1, offset2,\n      hAlign1, vAlign1, hAlign2, vAlign2,\n      textAlign = 'Center', width = 0, height = 0) {\n\n      const annotations = [\n        // First annotation\n        {\n          content: content1,\n          offset: offset1,\n          style: {\n            bold: true,\n            fontFamily: 'Roboto',\n            fontSize: 16\n          }\n        },\n        // Second annotation\n        {\n          content: content2,\n          offset: offset2,\n          style: {\n            fontFamily: 'Roboto',\n            fontSize: 12\n          }\n        }\n      ];\n\n      if (width > 0 && annotations[1]) {\n        annotations[1].width = width;\n        annotations[1].height = height;\n      }\n\n      if (hAlign1 && annotations[0]) {\n        annotations[0].horizontalAlignment = hAlign1;\n      }\n      if (hAlign2 && annotations[1]) {\n        annotations[1].horizontalAlignment = hAlign2;\n      }\n\n      if (vAlign1 && annotations[0]) {\n        annotations[0].verticalAlignment = vAlign1;\n      }\n      if (vAlign2 && annotations[1]) {\n        annotations[1].verticalAlignment = vAlign2;\n      }\n\n      if (textAlign !== 'Center' && annotations[1].style) {\n        (annotations[1].style).textAlign = textAlign;\n      }\n      return annotations;\n    },\n    /**\n     * Creates a PointPortModel object for a diagram node.\n     * @param id The unique identifier for the port.\n     * @param x The x-coordinate of the port's offset relative to the node.\n     * @param y The y-coordinate of the port's offset relative to the node.\n     * @returns A PointPortModel object configured with the provided properties.\n     */\n    createPort(id, x, y) {\n      return {\n        id: id,\n        offset: { x: x, y: y },\n        visibility: PortVisibility.Hidden\n      };\n    },\n    created() {\n      this.diagramCreated = true;\n      this.diagram = this.$refs.diagramObject.ej2Instances;\n      setTimeout(() => this.diagram.fitToPage(), 10);\n    },\n    load() {\n      if (this.diagramCreated) {\n        this.diagram.fitToPage();\n      }\n    }\n  }\n}\n</script>","dependencies":"{\"vue\":\"3.3.4\",\"@syncfusion/ej2-base\":\"*\",\"@syncfusion/ej2-vue-base\":\"*\",\"@syncfusion/ej2-diagrams\":\"*\",\"@syncfusion/ej2-vue-diagrams\":\"*\",\"@syncfusion/ej2-vue-charts\":\"*\",\"@syncfusion/ej2-vue-grids\":\"*\",\"@syncfusion/ej2-vue-maps\":\"*\",\"@syncfusion/ej2-vue-calendars\":\"*\",\"@syncfusion/ej2-data\":\"*\"}","src/main.js":"import { createApp } from 'vue'\nimport App from './App.vue'\ncreateApp(App).mount('#app')"}