for nodes/connectors */\nfunction createTextNode(id, width, height, offsetX, offsetY, content, style, constraints = NodeConstraints.None) {\n  return {\n    id, width, height, offsetX, offsetY,\n    constraints,\n    shape: { type: 'Text', content },\n    style\n  };\n}\nfunction createNativeNode(id, width, height, offsetX, offsetY, svgContent, constraints = NodeConstraints.None) {\n  return {\n    id, width, height, offsetX, offsetY,\n    constraints,\n    shape: { type: 'Native', content: svgContent }\n  };\n}\nfunction createImageNode(id, width, height, offsetX, offsetY, source, rotateAngle, constraints, pivotX, pivotY) {\n  const node = {\n    id, width, height, offsetX, offsetY,\n    shape: { type: 'Image', source },\n    style: { fill: 'transparent', strokeColor: 'transparent' }\n  };\n  if (typeof rotateAngle === 'number') node.rotateAngle = rotateAngle;\n  if (typeof constraints === 'number') node.constraints = constraints;\n  if (typeof pivotX === 'number' && typeof pivotY === 'number') node.pivot = { x: pivotX, y: pivotY };\n  if (!node.constraints) node.constraints = NodeConstraints.None;\n  return node;\n}\nfunction createEllipseNode(id, width, height, offsetX, offsetY, fill, strokeColor, strokeWidth, constraints = NodeConstraints.None) {\n  return {\n    id, width, height, offsetX, offsetY,\n    constraints,\n    shape: { type: 'Basic', shape: 'Ellipse' },\n    style: { fill, strokeColor, strokeWidth }\n  };\n}\nfunction createHtmlNode(id, width, height, offsetX, offsetY, html, constraints = NodeConstraints.None) {\n  return {\n    id, width, height, offsetX, offsetY,\n    constraints,\n    shape: { type: 'HTML', content: html }\n  };\n}\nfunction createRectNode(id, width, height, offsetX, offsetY, fill, strokeColor, strokeWidth, constraints = NodeConstraints.None) {\n  return {\n    id, width, height, offsetX, offsetY,\n    constraints,\n    style: { fill, strokeColor, strokeWidth }\n  };\n}\nfunction createConnectorBezier(id, spx, spy, tpx, tpy, c1x, c1y, c2x, c2y, strokeColor, strokeWidth, dash, opacity) {\n  return {\n    id,\n    zIndex: 1,\n    type: 'Bezier',\n    constraints: ConnectorConstraints.None,\n    sourcePoint: { x: spx, y: spy },\n    targetPoint: { x: tpx, y: tpy },\n    segments: [{ type: 'Bezier', point1: { x: c1x, y: c1y }, point2: { x: c2x, y: c2y } }],\n    style: { strokeColor, strokeWidth, strokeDashArray: dash, opacity },\n    sourceDecorator: { shape: 'None' },\n    targetDecorator: { shape: 'None' }\n  };\n}\nfunction getLocationHtml() {\n  return `\n    <div class=\"angle-control-section\" style=\"height:150px; width:300px\">\n      <div class=\"angle-control-label\" style=\"font-size:18px; font-weight:600\">\n        Select location\n      </div>\n      <div id=\"locationDropdown\"></div>\n    </div>`;\n}\nfunction getEfficiencyHtml() {\n  return `\n    <div class=\"efficiency-section\" style=\"width:300px; height:345px;\">\n      <h3 class=\"angle-control-label\" style=\"font-size:18px; font-weight:600\">\n        System Efficiency\n      </h3>\n      <div style=\"width: 210px; height:180px; margin:auto;\">\n        <div id=\"efficiencyGauge\"></div>\n      </div>\n      <div style=\"width:250px;\">\n        <div id=\"performanceMessage\"></div>\n      </div>\n    </div>`;\n}\nfunction getAngleHtml() {\n  // Keep initial text same as original: \"Medium Tilt\"\n  return `\n    <div class=\"angle-control-section\" style=\"width: 300px; height: 185px;\">\n      <div class=\"angle-control-label\" style=\"font-size:18px; font-weight:600\">\n        Tilt Angle\n      </div>\n      <div>\n        <input id=\"angleValue\" style=\"height:40px !important; font-size:large\" />\n      </div>\n      <div class=\"angle-description\" id=\"angleDescription\">Medium Tilt</div>\n    </div>`;\n}\nfunction createNodes(solarData) {\n  return [\n    // Title\n    createTextNode(\n      'title',\n      450,\n      80,\n      485,\n      135,\n      'SMART SOLAR PANEL TILT SYSTEM',\n      {\n        color: '#2c3e50',\n        fill: 'transparent',\n        fontFamily: 'Segoe UI',\n        fontSize: 26,\n        bold: true\n      },\n      NodeConstraints.None\n    ),\n    // East sun\n    createNativeNode('eastSun', 60, 60, 221, 422, eastSunSvg, NodeConstraints.None),\n    // Center sun\n    createNativeNode('centerSun', 60, 60, 483, 293, centerSunSvg, NodeConstraints.None),\n    // West sun\n    createNativeNode('westSun', 60, 45, 731, 422, westSunSvg, NodeConstraints.None),\n    // Labels\n    createTextNode(\n      'eastLabel',\n      60,\n      30,\n      238,\n      365,\n      'EAST',\n      {\n        color: '#34495e',\n        fill: 'transparent',\n        fontFamily: 'Segoe UI',\n        fontSize: 14,\n        bold: true\n      },\n      NodeConstraints.None\n    ),\n    createTextNode(\n      'westLabel',\n      60,\n      30,\n      725,\n      365,\n      'WEST',\n      {\n        color: '#34495e',\n        fill: 'transparent',\n        fontFamily: 'Segoe UI',\n        fontSize: 14,\n        bold: true\n      },\n      NodeConstraints.None\n    ),\n    // Ground line\n    createRectNode('groundLine', 500, 5, 489, 657, '#2E485F', '#2E485F', 2, NodeConstraints.None),\n    // Support structure\n    createImageNode('supportPost', 215, 185, 465, 565, 'https://ej2.syncfusion.com/vue/demos/src/diagram/Images/angle/panelSupport.png', undefined, NodeConstraints.None),\n    // Solar panel (interactive)\n    createImageNode('solarPanelFrame', 260, 50, 478.25, 485, 'https://ej2.syncfusion.com/vue/demos/src/diagram/Images/angle/solarPanel.png', solarData.currentAngle, (NodeConstraints.Default | NodeConstraints.ReadOnly) & ~NodeConstraints.Drag, 0.5, 0.8),\n    // Pivot point\n    createEllipseNode('pivotPoint', 16, 16, 478.5, 488, '#FF5F1F', '#2E485F', 1, NodeConstraints.None),\n    // Location selector\n    createHtmlNode('location', 300, 150, 1130, 100, getLocationHtml(), NodeConstraints.None),\n    // Efficiency\n    createHtmlNode('efficiency', 300, 350, 1130, 383, getEfficiencyHtml(), NodeConstraints.None),\n    // Angle input\n    createHtmlNode('angle', 300, 185, 1130, 680, getAngleHtml(), NodeConstraints.None)\n  ];\n}\nfunction createConnectors() {\n  return [\n    createConnectorBezier('sunPath', 221, 422, 731, 422, 350, 260, 610, 260, '#3498db', 3, '10,5', 0.8)\n  ];\n}\n\nexport default {\n  name: 'AngleDiagram',\n  components: {\n    'ejs-diagram': DiagramComponent\n  },\n  data: function () {\n    // Solar calculation data\n    const solarData = {\n      currentAngle: 303,       // diagram rotateAngle (0..360)\n      efficiency: 78,          // display percentage\n      selectedLocation: 'New York',\n      selectedDateTime: new Date(),\n      sunElevation: 0,\n      sunAzimuth: 0,\n      optimalTilt: 0,\n      solarIrradiance: 0,\n      incidenceAngle: 0,\n      intPanelAngleDeg: 0      // internal 0..100 mapping of currentAngle\n    };\n\n    const nodes = createNodes(solarData);\n    const connectors = createConnectors();\n\n    return {\n      solarData,\n      width: '100%',\n      height: '750px',\n      nodes,\n      connectors,\n      snapSettings: { constraints: SnapConstraints.None },\n      selectedItems: { constraints: SelectorConstraints.Rotate },\n      pageSettings: {\n        width: 1300,\n        height: 820,\n        background: { source: 'https://ej2.syncfusion.com/vue/demos/src/diagram/Images/angle/background.png', scale: 'Meet' }\n      },\n      diagramCreated: false,\n      diagram: null,\n      locationDropdown: null,\n      efficiencyGauge: null,\n      performanceMessage: null,\n      // new for NumericTextBox control\n      angleNumeric: null,\n      suppressAngleChange: false,\n      lastValidRelativeAngle: 0\n    };\n  },\n  methods: {\n    // Restrict rotation to [303..360] and [0..44]\n    onRotationChange(args) {\n      if (args.state === 'Completed') {\n        if (args.source && args.source.nodes && args.source.nodes[0]) {\n          const node = args.source.nodes[0];\n          if (node.id === 'solarPanelFrame') {\n            this.solarData.currentAngle = parseInt(args.newValue.rotateAngle.toString());\n            this.angleCalculation();\n            this.calculateSolarPosition();\n            this.calculateEfficiency();\n            this.updateUI();\n          }\n        }\n      } else if (args.state === 'Progress') {\n        if (args.source && args.source.nodes && args.source.nodes[0]) {\n          const selectedNode = args.source.nodes[0];\n          if (selectedNode.id === 'solarPanelFrame') {\n            const proposedAngle = args.newValue.rotateAngle;\n            let normalizedAngle = proposedAngle % 360;\n            if (normalizedAngle < 0) normalizedAngle += 360;\n            if (\n              !(\n                (normalizedAngle >= 303 && normalizedAngle <= 360) ||\n                (normalizedAngle >= 0 && normalizedAngle <= 44)\n              )\n            ) {\n              args.cancel = true;\n            }\n          }\n        }\n      }\n    },\n\n    scrollChange() {\n      if (this.locationDropdown?.isPopupOpen) {\n        this.locationDropdown.hidePopup();\n      }\n    },\n\n    created() {\n      this.diagramCreated = true;\n      this.diagram = this.$refs.diagramObj.ej2Instances;\n\n      // Initialize UI controls\n      this.initializeLocationDropdown();\n      this.initializeEfficiencyGauge();\n      this.initializePerformanceMessage();\n      this.initializeAngleControls();\n\n      // Initial calculations and UI\n      this.calculateSolarPosition();\n      this.angleCalculation();\n      this.calculateEfficiency();\n      this.updateUI();\n\n      this.diagram.fitToPage();\n    },\n\n    diagramClick() {\n      // Prevent losing selection of the solar panel node\n      const solarPanelNode = this.diagram.getObject('solarPanelFrame');\n      if (solarPanelNode) this.diagram.select([solarPanelNode]);\n    },\n\n    // Re-initialize controls when the diagram content is reloaded\n    load() {\n      setTimeout(() => {\n        if (this.diagramCreated && this.$refs.diagramObj.ej2Instances) {\n          this.initializeLocationDropdown();\n          this.initializeEfficiencyGauge();\n          this.initializePerformanceMessage();\n          this.initializeAngleControls();\n          this.updateUI();\n          this.diagram.fitToPage();\n        }\n      });\n    },\n\n    initializeLocationDropdown() {\n      const locationOptions = locationData.map((location) => ({\n        text: location.name,\n        value: location.name\n      }));\n      if (this.locationDropdown) this.locationDropdown.destroy();\n\n      this.locationDropdown = new DropDownList({\n        dataSource: locationOptions,\n        fields: { text: 'text', value: 'value' },\n        value: this.solarData.selectedLocation,\n        placeholder: 'Select a location',\n        popupWidth: '212px',\n        change: this.onLocationChanged.bind(this)\n      });\n      this.locationDropdown.appendTo('#locationDropdown');\n    },\n\n    onLocationChanged(args) {\n      this.solarData.selectedLocation = args.value;\n      const loc = this.getLocationData(this.solarData.selectedLocation);\n      if (loc) {\n        // map 0..100 to diagram allowed range 303..360, 0..43\n        const locationAngle = Math.min(100, loc.angle);\n        if (locationAngle <= 57) {\n          this.solarData.currentAngle = 303 + locationAngle; // 0..57 -> 303..360\n        } else {\n          this.solarData.currentAngle = locationAngle - 57; // 58..100 -> 1..43\n        }\n\n        this.angleCalculation();\n        this.calculateSolarPosition();\n        this.calculateEfficiency();\n        this.updateDiagram();\n        this.updateUI();\n      }\n    },\n\n    initializeEfficiencyGauge() {\n      if (this.efficiencyGauge) this.efficiencyGauge.destroy();\n\n      this.efficiencyGauge = new CircularGauge({\n        width: '200px',\n        height: '200px',\n        background: 'transparent',\n        axes: [\n          {\n            startAngle: 225,\n            endAngle: 45,\n            minimum: 0,\n            maximum: 100,\n            radius: '95%',\n            lineStyle: { width: 15, color: '#F2F4F6' },\n            majorTicks: { height: 0 },\n            minorTicks: { height: 0 },\n            labelStyle: { font: { size: '0px' } },\n            ranges: [\n              { start: 0, end: 40, color: '#EF5B2E', startWidth: 18, endWidth: 18 },\n              { start: 40, end: 60, color: '#FEA714', startWidth: 18, endWidth: 18 },\n              { start: 60, end: 90, color: '#3ABA47', startWidth: 18, endWidth: 18 }\n            ],\n            pointers: [\n              {\n                type: 'Marker',\n                value: this.solarData.efficiency,\n                markerShape: 'Triangle',\n                markerHeight: 25,\n                markerWidth: 6,\n                radius: '85%',\n                color: '#111',\n                animation: { enable: false }\n              }\n            ],\n            annotations: [\n              {\n                angle: 90,\n                radius: '0%',\n                zIndex: '1',\n                content: `\n                  <div style=\"text-align: center;\">\n                    <div style=\"font-size: 20px; font-weight: bold; color: #1A2A3B;\" id=\"gaugeEfficiencyValue\">\n                      ${Math.round(this.solarData.efficiency)}<span style=\"font-size:20px; font-weight:500;\">%</span>\n                    </div>\n                    <div style=\"font-size: 14px; font-weight: 500; color: #888; margin-top: 5px; text-align: right; padding-left: 10px; text-transform: uppercase;\">\n                      EFFICIENCY\n                    </div>\n                  </div>`\n              }\n            ]\n          }\n        ]\n      });\n\n      this.efficiencyGauge.appendTo('#efficiencyGauge');\n    },\n\n    initializePerformanceMessage() {\n      if (this.performanceMessage) this.performanceMessage.destroy();\n\n      const efficiencyMsg = this.getPerformanceMessage();\n      this.performanceMessage = new Message({\n        content: efficiencyMsg.message,\n        severity: efficiencyMsg.severity,\n        showIcon: true,\n        cssClass: 'performance-message',\n        visible: true,\n        showCloseIcon: false\n      });\n      this.performanceMessage.appendTo('#performanceMessage');\n    },\n\n    // New: NumericTextBox-based angle control\n    initializeAngleControls() {\n      // Destroy previous instance if any\n      if (this.angleNumeric) {\n        this.angleNumeric.destroy();\n        this.angleNumeric = null;\n      }\n\n      const relativeAngle = this.solarData.intPanelAngleDeg - 57; // -57..43\n      this.lastValidRelativeAngle = relativeAngle;\n\n      this.angleNumeric = new NumericTextBox({\n        min: -57,\n        max: 43,\n        strictMode: true,\n        step: 1,\n        decimals: 0,\n        format: 'n0',\n        value: relativeAngle,\n        showSpinButton: true,\n        change: (args) => {\n          if (this.suppressAngleChange) return;\n          const val =\n            typeof args.value === 'number' ? args.value : this.angleNumeric.value;\n          if (typeof val === 'number') {\n            this.applyRelativeAngle(val);\n          }\n        }\n      });\n\n      this.angleNumeric.appendTo('#angleValue');\n\n      // Prevent diagram interaction when editing input\n      const inputEl = document.getElementById('angleValue');\n      if (inputEl) {\n        ['pointerdown', 'mousedown', 'touchstart', 'click'].forEach((evt) => {\n          inputEl.addEventListener(evt, (e) => e.stopPropagation());\n        });\n        inputEl.addEventListener('keydown', (e) => {\n          if (e.key === 'Enter') {\n            e.preventDefault();\n            inputEl.blur(); // commit & clamp with strictMode\n            setTimeout(() => inputEl.focus(), 0);\n          }\n          e.stopPropagation();\n        });\n      }\n\n      // Shortcut: if user types numeric keys while diagram focused, focus the input\n      // Note: keep a single listener; guard re-adding if needed.\n      if (!this._docKeydownAttached) {\n        document.addEventListener(\n          'keydown',\n          (e) => {\n            const input = document.getElementById('angleValue');\n            const active = document.activeElement;\n            if (active && (active === input || active?.closest('.e-input-group') === input?.closest('.e-input-group'))) return;\n\n            const key = e.key;\n            const isEditKey =\n              (key >= '0' && key <= '9') ||\n              key === '+' ||\n              key === '-' ||\n              key === 'Backspace' ||\n              key === 'Delete';\n            if (isEditKey) {\n              e.stopPropagation();\n              e.preventDefault();\n              if (input) {\n                input.focus();\n                setTimeout(() => {\n                  try {\n                    input.select && input.select();\n                  } catch { }\n                }, 0);\n              }\n            }\n          },\n          { capture: true }\n        );\n        this._docKeydownAttached = true;\n      }\n    },\n\n    // Convert relative angle (-57..43) to diagram rotateAngle [303..360,0..43]\n    applyRelativeAngle(val) {\n      if (typeof val !== 'number') return;\n\n      let r = Math.round(val);\n      if (r < -57) r = -57;\n      if (r > 43) r = 43;\n      this.lastValidRelativeAngle = r;\n\n      const rotateAngle = r < 0 ? r + 360 : r;\n      this.solarData.currentAngle = rotateAngle % 360;\n\n      this.updateDiagram();\n      this.angleCalculation();\n      this.calculateSolarPosition();\n      this.calculateEfficiency();\n      this.updateUI();\n    },\n\n    // Compute intPanelAngleDeg 0..100 from currentAngle\n    angleCalculation() {\n      const a = this.solarData.currentAngle;\n      if (a >= 303 && a <= 360) {\n        // 303..360 -> 0..57\n        this.solarData.intPanelAngleDeg = a - 303;\n      } else if (a >= 0 && a <= 43) {\n        // 0..43 -> 57..100\n        this.solarData.intPanelAngleDeg = 57 + a;\n      } else {\n        // keep within [0,100] if out of band\n        this.solarData.intPanelAngleDeg = Math.max(\n          0,\n          Math.min(100, this.solarData.intPanelAngleDeg)\n        );\n      }\n    },\n\n    calculateSolarPosition() {\n      const location = this.getLocationData(this.solarData.selectedLocation);\n      if (!location) return;\n\n      const lat = (location.latitude * Math.PI) / 180;\n      const selectedDate = new Date(this.solarData.selectedDateTime);\n      const startOfYear = new Date(selectedDate.getFullYear(), 0, 1);\n      const dayOfYear =\n        Math.ceil(\n          (selectedDate.getTime() - startOfYear.getTime()) / (1000 * 60 * 60 * 24)\n        ) + 1;\n\n      const declination =\n        ((23.45 * Math.PI) / 180) * Math.sin((2 * Math.PI * (284 + dayOfYear)) / 365);\n      const hourAngle = 0; // noon\n      const elevation = Math.asin(\n        Math.sin(declination) * Math.sin(lat) +\n        Math.cos(declination) * Math.cos(lat) * Math.cos(hourAngle)\n      );\n\n      this.solarData.sunElevation = Math.max(0, (elevation * 180) / Math.PI);\n      this.solarData.sunAzimuth = 180.0;\n      this.solarData.optimalTilt = Math.max(0, Math.min(60, Math.abs(location.latitude)));\n\n      if (this.solarData.sunElevation > 0) {\n        const elevationRad = elevation;\n        let airMass = 1.0 / Math.sin(elevationRad);\n        airMass = Math.max(1.0, Math.min(40.0, airMass));\n        this.solarData.solarIrradiance =\n          1353 * Math.pow(0.7, Math.pow(airMass, 0.678)) * Math.sin(elevationRad);\n        this.solarData.solarIrradiance = Math.max(0, this.solarData.solarIrradiance);\n      } else {\n        this.solarData.solarIrradiance = 0;\n      }\n    },\n\n    calculateEfficiency() {\n      if (this.solarData.sunElevation <= 0) {\n        this.solarData.efficiency = 0;\n        this.solarData.incidenceAngle = 90;\n        return;\n      }\n\n      // Base calculations\n      const panelTiltRad = (this.solarData.intPanelAngleDeg * Math.PI) / 180.0;\n      const sunElevRad = (this.solarData.sunElevation * Math.PI) / 180.0;\n      const azimuthDiff = 0;\n\n      let cosIncidence =\n        Math.sin(sunElevRad) * Math.cos(panelTiltRad) +\n        Math.cos(sunElevRad) * Math.sin(panelTiltRad) * Math.cos(azimuthDiff);\n      cosIncidence = Math.max(0, Math.min(1, cosIncidence));\n      this.solarData.incidenceAngle = (Math.acos(cosIncidence) * 180.0) / Math.PI;\n\n      const irradianceFactor = Math.min(1.0, this.solarData.solarIrradiance / 900.0);\n      const temperatureFactor = 0.95;\n      const systemLossFactor = 0.95;\n      const optimalAngleDiff = Math.abs(\n        this.solarData.intPanelAngleDeg - this.solarData.optimalTilt\n      );\n      const optimalAngleFactor = Math.max(\n        0.9,\n        1.0 - (optimalAngleDiff / 90.0) * 0.2\n      );\n\n      let eff =\n        100.0 *\n        cosIncidence *\n        irradianceFactor *\n        temperatureFactor *\n        systemLossFactor *\n        optimalAngleFactor;\n\n      if (optimalAngleDiff < 5) eff = Math.min(100, eff * 1.08);\n\n      // Gradual noon uplift\n      const noonAngle = this.solarData.currentAngle;\n      const d = Math.min(noonAngle, 360 - noonAngle);\n      const strongFloorWindowDeg = 10;\n      const noonWindowDeg = 15;\n\n      if (d <= noonWindowDeg) {\n        const weight = 0.5 * (1 + Math.cos((Math.PI * d) / noonWindowDeg));\n        const t = Math.min(1, d / strongFloorWindowDeg);\n        const minAtD = 65 + (60 - 65) * t;\n        const maxAtD = 75 + (68 - 75) * t;\n        const noonTarget = minAtD + (maxAtD - minAtD) * irradianceFactor;\n\n        const blended = eff + (noonTarget - eff) * weight;\n        let uplifted = Math.max(eff, blended);\n        if (d <= strongFloorWindowDeg)\n          uplifted = Math.max(uplifted, irradianceFactor);\n\n        eff = Math.min(100, uplifted);\n      }\n\n      this.solarData.efficiency = Math.max(0, Math.min(100, eff));\n    },\n\n    updateDiagram() {\n      if (this.diagram) {\n        const panel = this.diagram.getObject('solarPanelFrame');\n        if (panel) {\n          panel.rotateAngle = this.solarData.currentAngle;\n          this.diagram.dataBind();\n        }\n      }\n    },\n\n    // Keep NumericTextBox synchronized with model without recursive events\n    syncAngleInputFromModel() {\n      if (!this.angleNumeric) return;\n      const relative = this.solarData.intPanelAngleDeg - 57;\n      this.suppressAngleChange = true;\n      this.angleNumeric.value = relative;\n      this.angleNumeric.dataBind();\n      this.suppressAngleChange = false;\n      this.lastValidRelativeAngle = relative;\n    },\n\n    updateUI() {\n      // Sync numeric input from model\n      this.syncAngleInputFromModel();\n\n      // Angle description\n      const descEl = document.getElementById('angleDescription');\n      if (descEl) {\n        descEl.textContent = this.getAngleDescription();\n      }\n\n      // Efficiency gauge\n      if (this.efficiencyGauge) {\n        this.efficiencyGauge.axes[0].pointers[0].value = this.solarData.efficiency;\n        this.efficiencyGauge.axes[0].annotations[0].content = `\n          <div style=\"text-align: center;\">\n            <div style=\"font-size: 20px; font-weight: bold; color: #1A2A3B;\" id=\"gaugeEfficiencyValue\">\n              ${Math.round(this.solarData.efficiency)}<span style=\"font-size:20px; font-weight:500;\">%</span>\n            </div>\n            <div style=\"font-size: 14px; font-weight: 500; color: #888; margin-top: 5px; text-align: right; padding-left: 10px; text-transform: uppercase;\">\n              EFFICIENCY\n            </div>\n          </div>`;\n        this.efficiencyGauge.dataBind();\n      }\n\n      // Performance message\n      if (this.performanceMessage) {\n        const msg = this.getPerformanceMessage();\n        this.performanceMessage.content = msg.message;\n        this.performanceMessage.severity = msg.severity;\n        this.performanceMessage.dataBind();\n      }\n      if (this.diagram) {\n        setTimeout(() => {\n          this.diagram.select([this.diagram.getObject('solarPanelFrame')]);\n        }, 10);\n      }\n    },\n\n    getAngleDescription() {\n      // relative 0 (intPanelAngleDeg==57) is “Horizontal”\n      const relative = Math.abs(this.solarData.intPanelAngleDeg - 57);\n      if (relative <= 5) return 'Horizontal';\n      else if (relative < 15) return 'Low Tilt';\n      else if (relative < 25) return 'Medium Tilt';\n      else if (relative < 40) return 'High Tilt';\n      else return 'Steep Tilt';\n    },\n\n    getPerformanceMessage() {\n      if (this.solarData.efficiency > 60) {\n        return { message: 'Excellent Performance', severity: Severity.Success };\n      } else if (this.solarData.efficiency > 40) {\n        return { message: 'Fair Performance', severity: Severity.Warning };\n      } else {\n        return { message: 'Poor Performance', severity: Severity.Error };\n      }\n    },\n\n    getLocationData(name) {\n      return locationData.find((loc) => loc.name.toLowerCase() === name.toLowerCase());\n    }\n  }\n};\n</script>\n\n<style>\n.angle-diagram-container .e-ddl.e-input-group .e-input-group-icon,\n.e-ddl.e-input-group.e-control-wrapper .e-input-group-icon:hover {\n  color: #9CA3AF;\n}\n\n.angle-diagram-container .e-ddl.e-input-group.e-control-wrapper .e-input {\n  color: #9CA3AF;\n  font-size: 16px;\n  font-weight: 500;\n}\n\n.angle-diagram-container .angle-control-section {\n  margin-bottom: 25px;\n  background: linear-gradient(145deg, #ffffff, #f8f9fa);\n  border-radius: 15px;\n  padding: 25px;\n  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n\n.angle-diagram-container .angle-control-label {\n  display: flex;\n  align-items: center;\n  font-weight: 600;\n  font-size: 18px;\n  color: #2c3e50;\n  margin-bottom: 15px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.angle-diagram-container .angle-description {\n  font-size: 14px;\n  color: #7f8c8d;\n  font-weight: 500;\n  margin-top: 10px;\n}\n\n.angle-diagram-container .efficiency-section {\n  text-align: center;\n  margin-bottom: 30px;\n  background: linear-gradient(145deg, #ffffff, #f1f3f4);\n  border-radius: 20px;\n  padding: 25px;\n  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);\n}\n\n.angle-diagram-container .e-diagram-selector {\n  stroke-width: 0;\n}\n</style>","dependencies":"{\"vue\":\"3.3.4\",\"@syncfusion/ej2-base\":\"*\",\"@syncfusion/ej2-vue-base\":\"*\",\"@syncfusion/ej2-diagrams\":\"*\",\"@syncfusion/ej2-vue-diagrams\":\"*\",\"@syncfusion/ej2-data\":\"*\",\"@syncfusion/ej2-inputs\":\"*\",\"@syncfusion/ej2-lists\":\"*\",\"@syncfusion/ej2-navigations\":\"*\",\"@syncfusion/ej2-notifications\":\"*\",\"@syncfusion/ej2-popups\":\"*\",\"markdown-spellcheck\":\"^1.3.1\",\"@syncfusion/ej2-dropdowns\":\"*\",\"@syncfusion/ej2-pdf-export\":\"*\",\"@syncfusion/ej2-svg-base\":\"*\",\"@syncfusion/ej2-circulargauge\":\"*\",\"@syncfusion/ej2-buttons\":\"*\",\"@syncfusion/ej2-splitbuttons\":\"*\",\"@syncfusion/ej2-vue-charts\":\"*\",\"@syncfusion/ej2-vue-grids\":\"*\",\"@syncfusion/ej2-vue-maps\":\"*\"}","src/main.js":"import { createApp } from 'vue'\nimport App from './App.vue'\ncreateApp(App).mount('#app')"}