{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"control-section\">\n    <div class=\"col-lg-8 control-section\">\n        <div class=\"menu-control\">\n            <div id=\"layoutcontainer\" class=\"deviceLayout\">\n                <div class=\"speaker\">\n                    <div class=\"camera\"></div>\n                </div>\n                <div class=\"displayLayout\">\n                    <div id=\"container\">\n                        <ul id=\"menu\"></ul>\n                    </div>\n                </div>\n                <div class=\"outerButton\"> </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"col-lg-4 menu-section property-section\">\n            <table id=\"property\" title=\"Properties\" style=\"width: 100%\">\n                <tbody>\n                    <tr>\n                        <td style=\"width: 50%;padding-top:10px\">\n                            <div>View Mode</div>\n                        </td>\n                        <td style=\"width: 50%;padding-top:10px\">\n                            <div style=\"max-width: 200px\">\n                                <select id=\"ddlViewMode\">\n                                    <option value=\"mobile\">Mobile</option>\n                                    <option value=\"tablet\">Tablet</option>\n                                    <option value=\"desktop\">Desktop</option>\n                                </select>\n                            </div>\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n</div>\n\n\n<style>\n    /**\n    * ej2 Menu styles customization\n    */\n    .deviceLayout #menu {\n        -ms-overflow-style: none;\n        scrollbar-width: none;\n        height: 363px;\n    }\n    .deviceLayout #menu::-webkit-scrollbar {\n        width: 0;\n    }\n\n    /**\n    * ej2 Menu styles\n    */\n    .menu-control {\n        text-align: center;\n    }\n\n    #layoutcontainer:not(.deviceLayout) {\n        margin-top: 45px;\n    }\n    \n    .deviceLayout {\n        line-height: initial;\n        border: 1px solid black;\n        width: 285px;\n        height: 505px;\n        margin: auto;\n        margin-bottom: 15px;\n        border-radius: 28px;\n        position: relative;\n        background-image: linear-gradient(to top, #ffffff, #f5f5f5);\n    }\n\n    .fluent-dark .e-menu-wrapper.e-hamburger.e-lib.e-keyboard {\n        background-color: black;\n    }\n    \n    .material3-dark .e-menu-wrapper.e-hamburger.e-lib.e-keyboard {\n        background: #1c1b1f;\n        border-radius: 0;\n    }\n\n    .fluent-dark .e-menu-wrapper.e-lib.e-keyboard {\n        background-color: black;\n    }\n\n    .deviceLayout.tabletview {\n        width: 767px;\n        z-index: 1;\n    }\n\n    .deviceLayout .speaker {\n        border: 1px solid black;\n        border-radius: 5px;\n        width: 20%;\n        height: 5px;\n        margin: 15px auto 0px auto;\n        position: relative;\n    }\n\n    .deviceLayout .outerButton {\n        width: 30px;\n        height: 30px;\n        border: 1px solid black;\n        border-radius: 50%;\n        position: absolute;\n        bottom: calc(0% + 10px);\n        left: calc(50% - 15px);\n    }\n\n    .deviceLayout .camera {\n        position: absolute;\n        left: calc(-15% - 10px);\n        top: -100%;\n        width: 10px;\n        height: 10px;\n        border-radius: 50%;\n        border: 1px solid black;\n    }\n\n    .deviceLayout .displayLayout {\n        border: 1px solid black;\n        margin: 20px 13px 0px 13px;\n    }\n\n    .displayLayout #container {\n        height: 405px;\n        background-color: white;\n        overflow: hidden;\n    }\n\n    .fluent2-dark .displayLayout #container,\n    .fluent2-highcontrast .displayLayout #container {\n        background-color: black;\n    }\n\n    #header {\n        width: 100%;\n        background-color: #7b8cfb;\n    }\n\n    .fluent2-highcontrast .displayLayout #container,\n    .highcontrast .displayLayout #container,\n    .material3-dark .displayLayout #container,\n    .bootstrap5\\.3-dark .displayLayout #container,\n    .fluent2-dark .displayLayout #container,\n    .fluent2-highcontrast .displayLayout #container,\n    .bootstrap-dark .displayLayout #container,\n    .bootstrap5-dark .displayLayout #container,\n    .material-dark .displayLayout #container,\n    .fluent-dark .displayLayout #container,\n    .tailwind-dark .displayLayout #container,\n    .fabric-dark  .displayLayout #container {\n        background-color: black;\n    }\n\n    /**\n    * ej2 Menu Tailwind 3 styles\n    */\n    .tailwind3-dark .displayLayout #container {\n        background: #111827;\n    }\n    .tailwind3-dark .deviceLayout {\n        border-color: #374151;\n        background-image: none;\n    }\n    .tailwind3-dark .deviceLayout .displayLayout {\n        border-color: #374151;\n    }\n    .tailwind3-dark .deviceLayout .camera,\n    .tailwind3 .deviceLayout .camera {\n        display: none;\n    }\n    .tailwind3-dark .deviceLayout .speaker,\n    .tailwind3-dark .deviceLayout .outerButton {\n        border-color: #282F3C;\n        background: #282F3C;\n    }\n    .tailwind3 .deviceLayout {\n        border-color: #D1D5DB;\n        background-image: none;\n    }\n    .tailwind3 .deviceLayout .displayLayout {\n        border-color: #D1D5DB;\n    }\n    .tailwind3 .deviceLayout .speaker,\n    .tailwind3 .deviceLayout .outerButton {\n        border-color: #E5E7EB;\n        background: #E5E7EB;\n    }\n</style>\n</div></body></html>"}