{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"col-lg-12 control-section\">\n    <div class=\"e-sample-resize-container\">\n        <div id=\"toolbar_template\">\n        </div>\n    </div>\n</div>\n\n\n<style>\n    /* Toolbar Styles */\n    .control-wrapper {\n        flex-direction: inherit;   \n    }\n    .e-sample-resize-container {\n        height: 42px;\n        margin-top: 100px;\n    }\n    .template.e-toolbar .total-page {\n        padding-left: 4px;\n        cursor: default;\n        font-size:14px;\n        vertical-align: middle;\n    }\n    .template.e-toolbar .e-toolbar-items .e-toolbar-item:not(.e-separator) {\n        padding-left: 2px;\n        line-height: 1;\n    }\n    .template.e-toolbar .e-toolbar-pop .page-count,\n    .template.e-toolbar .e-toolbar-pop .selection-tool,\n    .template.e-toolbar .e-toolbar-pop .pan-mode,    \n    .template.e-toolbar .e-toolbar-pop .percentage,\n    .template.e-toolbar .e-toolbar-pop .find  {\n        display: none;\n    }\n</style></div></body></html>"}