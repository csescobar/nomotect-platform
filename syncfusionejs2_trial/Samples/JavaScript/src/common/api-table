on":{"name":"description","description":"<p>description for title.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/smithchart/title#description"},"enableTrim":{"name":"enableTrim","description":"<p>trim the title.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/smithchart/title#enabletrim"},"font":{"name":"font","description":"<p>options for customizing title font.</p>\n","type":"SmithchartFontModel","link":"//ej2.syncfusion.com/javascript/documentation/api/smithchart/title#font"},"maximumWidth":{"name":"maximumWidth","description":"<p>maximum width of the sub title.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/smithchart/title#maximumwidth"},"subtitle":{"name":"subtitle","description":"<p>options for customizing sub title.</p>\n","type":"SubtitleModel","link":"//ej2.syncfusion.com/javascript/documentation/api/smithchart/title#subtitle"},"textAlignment":{"name":"textAlignment","description":"<p>text alignment for title.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/smithchart/title#textalignment"},"visible":{"name":"visible","description":"<p>visibility for title.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/smithchart/title#visible"}},"TooltipBorder":{"color":{"name":"color","description":"<p>Specifies the color of the border that accepts value in hex and rgba as a valid CSS color string.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/heatmap/tooltipBorder#color"},"width":{"name":"width","description":"<p>Sets and gets the width of the border in pixels.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/heatmap/tooltipBorder#width"}},"CellSettings":{"border":{"name":"border","description":"<p>Sets and gets the options to customize the cell border style.</p>\n","type":"BorderModel","link":"//ej2.syncfusion.com/javascript/documentation/api/heatmap/cellSettings#border"},"bubbleSize":{"name":"bubbleSize","description":"<p>Specifies the minimum and maximum radius value of the cell in percentage.</p>\n","type":"BubbleSizeModel","link":"//ej2.syncfusion.com/javascript/documentation/api/heatmap/cellSettings#bubblesize"},"bubbleType":{"name":"bubbleType","description":"<p>Specifies the type of the bubble heatmap. The available types are,</p>\n<ul>\n<li>Size: The bubble heatmap will be rendered in size variations based on the provided data.</li>\n<li>Color: The bubble heatmap will be rendered in color variations based on the provided data.</li>\n<li>Sector: The bubble heatmap will be rendered as sectors based on the provided data.</li>\n<li>SizeAndColor: The bubble heatmap will be rendered in size and color variations based on the provided data.</li>\n</ul>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/heatmap/cellSettings#bubbletype"},"enableCellHighlighting":{"name":"enableCellHighlighting","description":"<p>Enable or disable the cell highlighting on mouse hover.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/heatmap/cellSettings#enablecellhighlighting"},"format":{"name":"format","description":"<p>Used to format the label in the heatmap cells.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/heatmap/cellSettings#format"},"isInversedBubbleSize":{"name":"isInversedBubbleSize","description":"<p>Enable or disable the bubble to display in inverse when <code>Size</code> and <code>SizeAndColor</code> bubble types are set.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/heatmap/cellSettings#isinversedbubblesize"},"labelTemplate":{"name":"labelTemplate","description":"<p>Gets or sets the template that will be used to render custom elements for cell values.</p>\n","type":"string|Function","link":"//ej2.syncfusion.com/javascript/documentation/api/heatmap/cellSettings#labeltemplate