lumn#textalign"},"type":{"name":"type","description":"<p>Defines the data type of the column.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#type"},"width":{"name":"width","description":"<p>The width of the column as a string accepts input both as '100px' and '100%'.\nIf specified as '100%', the column renders to the full width of its chart.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/column#width"},"displayAsCheckBox":{"name":"displayAsCheckBox","description":"<p>If <code>displayAsCheckBox</code> is set to true, it displays the column value as a check box instead of Boolean value.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#displayascheckbox"},"header":{"name":"header","description":"<p>Defines the header text of column which is used to display in column header.\nIf headerText is not defined, then field name value will be assigned to header text.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/multicolumn-combobox/column#header"},"allowEditing":{"name":"allowEditing","description":"<p>If <code>allowEditing</code> set to false, then it disables editing of a particular column.\nBy default all columns are editable.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#allowediting"},"allowFiltering":{"name":"allowFiltering","description":"<p>If <code>allowFiltering</code> set to false, then it disables filtering option and filter bar element of a particular column.\nBy default all columns are filterable.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#allowfiltering"},"allowReordering":{"name":"allowReordering","description":"<p>If <code>allowReordering</code> set to false, then it disables reorder of a particular column.\nBy default all columns can be reorder.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#allowreordering"},"columns":{"name":"columns","description":"<p>Used to render multiple header rows(stacked headers) on the Grid header.</p>\n","type":"Column[]|string[]|ColumnModel[]","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#columns"},"commands":{"name":"commands","description":"<p><code>commands</code> provides an option to display command buttons in every cell.\nThe available built-in command buttons are</p>\n<ul>\n<li>Edit - Edit the record.</li>\n<li>Delete - Delete the record.</li>\n<li>Save - Save the record.</li>\n<li>Cancel - Cancel the edit state.</li>\n</ul>\n","type":"CommandModel[]","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#commands"},"defaultValue":{"name":"defaultValue","description":"<p>Defines default values for the component when adding a new record to the Grid.</p>\n","type":"string|number|Date|boolean|null","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#defaultvalue"},"disableHtmlEncode":{"name":"disableHtmlEncode","description":"<p>If <code>disableHtmlEncode</code> is set to true, it encodes the HTML of the header and content cells.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#disablehtmlencode"},"edit":{"name":"edit","description":"<p>Defines the <code>IEditCell</code> object to customize default edit cell.</p>\n","type":"IEditCell","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#edit"},"editTemplate":{"name":"editTemplate","description":"<p>Defines the cell edit template that used as editor for a particular column.\nIt accepts either template string or HTML element ID.</p>\n","type":"string|Function","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#edittemplate"},"editType":{"name":"editType","description":"<p>Defines the type of component for editable.</p>\n","type":"string|string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#edittype"},"enableColumnSpan":{"name":"enableColumnSpan","description":"<p>Allows grid to perform column spanning on the specified column.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#enablecolumnspan"},"enableRowSpan":{"name":"enableRowSpan","description":"<p>Allows grid to perform row spanning on the specified column.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#enablerowspan"},"filter":{"name":"filter","description":"<p>It is used to customize the default filter options for a specific columns.</p>\n<ul>\n<li>type -  Specifies the filter type as menu or checkbox.</li>\n<li>ui - to render custom component for specific column it has following functions.</li>\n<li>ui.create – It is used for creating custom components.</li>\n<li>ui.read -  It is used for read the value from the component.</li>\n<li>ui.write - It is used to apply component model as dynamically.</li>\n</ul>\n<blockquote>\n<p>Check the <a href=\"../../grid/filtering/filter-menu/#custom-component-in-filter-menu\"><code>Filter UI</code></a> for its customization.</p>\n</blockquote>\n","type":"IFilter","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#filter"},"filterBarTemplate":{"name":"filterBarTemplate","description":"<p>The <code>filterBarTemplate</code> is used to add a custom component instead of default input component for filter bar.\nIt have create and read functions.</p>\n<ul>\n<li>create: It is used for creating custom components.</li>\n<li>read: It is used to perform custom filter action.</li>\n</ul>\n","type":"IFilterUI","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#filterbartemplate"},"filterTemplate":{"name":"filterTemplate","description":"<p>Defines the filter template/UI that used as filter for a particular column.\nIt accepts either template string or HTML element ID.</p>\n","type":"string|Function","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#filtertemplate"},"formatter":{"name":"formatter","description":"<p>Defines the method which is used to achieve custom formatting from an external function.\nThis function triggers before rendering of each cell.</p>\n","type":"Object|ICellFormatter|Function","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#formatter"},"freeze":{"name":"freeze","description":"<p>defines which side the column need to freeze\nThe available built-in freeze directions are</p>\n<ul>\n<li>Left - Freeze the column at left side.</li>\n<li>Right - Freeze the column at right side.</li>\n<li>Fixed - Freeze the column at Center.</li>\n<li>None - Does not freeze the column.</li>\n</ul>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#freeze"},"isFrozen":{"name":"isFrozen","description":"<p>You can use this property to freeze selected columns in grid</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#isfrozen"},"isIdentity":{"name":"isIdentity","description":"<p>If <code>isIdentity</code> is set to true, then this column is considered as identity column.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#isidentity"},"lockColumn":{"name":"lockColumn","description":"<p>Defines the mapping column name of the foreign data source.\nIf it is not defined then the <code>columns.field</code> will be considered as mapping column name</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#lockcolumn"},"showCheckbox":{"name":"showCheckbox","description":"<p>When set to <code>true</code>, checkboxes are displayed within the column.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/treegrid/column#showcheckbox"},"showColumnMenu":{"name":"showColumnMenu","description":"<p>If <code>showColumnMenu</code> set to false, then it disable the column menu of a particular column.\nBy default column menu will show for all columns</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#showcolumnmenu"},"showInColumnChooser":{"name":"showInColumnChooser","description":"<p>If <code>showInColumnChooser</code> set to false, then hide the particular column in column chooser.\nBy default all columns are displayed in column Chooser.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#showincolumnchooser"},"uid":{"name":"uid","description":"<p>Gets the unique identifier value of the column. It is used to get the column object.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#uid"},"validationRules":{"name":"validationRules","description":"<p>Defines rules to validate data before creating and updating.</p>\n","type":"Object","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#validationrules"},"valueAccessor":{"name":"valueAccessor","description":"<p>Defines the method used to apply custom cell values from external function and display this on each cell rendered.</p>\n","type":"string|string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#valueaccessor"},"visible":{"name":"visible","description":"<p>If <code>visible</code> is set to false, hides the particular column. By default, columns are displayed.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#visible"},"allowGrouping":{"name":"allowGrouping","description":"<p>If <code>allowGrouping</code> set to false, then it disables grouping of a particular column.\nBy default all columns are groupable.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/column#allowgrouping"},"allowSearching":{"name":"allowSearching","description":"<p>If <code>allowSearching</code> set to false, then it disables Searching of a particular column.\nBy default all columns allo