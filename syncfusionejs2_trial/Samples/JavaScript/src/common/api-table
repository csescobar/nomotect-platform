neType","description":"<p>Specifies the line type for the crosshair.\nThe available modes are:</p>\n<ul>\n<li>None: Both vertical and horizontal crosshair lines are hidden.</li>\n<li>Both: Displays both the vertical and horizontal crosshair lines.</li>\n<li>Vertical: Shows only the vertical crosshair line.</li>\n<li>Horizontal: Shows only the horizontal crosshair line.</li>\n</ul>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/crosshairSettings#linetype"},"highlightCategory":{"name":"highlightCategory","description":"<p>If set to true, highlights the entire category range when hovered over.\nThis property applies only to category axes.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/crosshairSettings#highlightcategory"},"horizontalLineColor":{"name":"horizontalLineColor","description":"<p>The color of the horizontal crosshair line accepts values in hex and rgba as valid CSS color strings.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/crosshairSettings#horizontallinecolor"},"opacity":{"name":"opacity","description":"<p>Specifies the opacity level for the crosshair, which controls its transparency.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/crosshairSettings#opacity"},"snapToData":{"name":"snapToData","description":"<p>Enables or disables the crosshair snap behavior.\nWhen set to <code>true</code>, the crosshair line and its labels snap\nto the nearest visible data point, ensuring precise\nalignment and accurate value reading.</p>\n<p>When set to <code>false</code>, the crosshair moves freely along\nthe axis without snapping, showing interpolated values\nbased on the pointer position.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/crosshairSettings#snaptodata"},"verticalLineColor":{"name":"verticalLineColor","description":"<p>The color of the vertical crosshair line accepts values in hex and rgba as valid CSS color strings.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/crosshairSettings#verticallinecolor"}},"CrosshairTooltip":{"enable":{"name":"enable","description":"<p>If set to true, the crosshair tooltip will be visible on the chart when interacting with the crosshair.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/crosshairTooltip#enable"},"fill":{"name":"fill","description":"<p>The fill color of the tooltip accepts values in hex and rgba as valid CSS color string.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/crosshairTooltip#fill"},"textStyle":{"name":"textStyle","description":"<p>Options for customizing the crosshair tooltip text, including font settings such as family, size, style, weight, and color.</p>\n","type":"FontModel","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/crosshairTooltip#textstyle"}},"EmptyPointSettings":{"border":{"name":"border","description":"<p>Options to customize the border for empty points in the series, including color and width.</p>\n","type":"BorderModel","link":"//ej2.syncfusion.com/javascript/documentation/api/common/emptyPointSettings#border"},"fill":{"name":"fill","description":"<p>Customizes the fill color for empty points in the series.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/common/emptyPointSettings#fill"},"mode":{"name":"mode","description":"<p>Defines the mode for handling empty or missing data points in the series.\nThe available modes are:</p>\n<ul>\n<li>Gap - Displays empty points as gaps in the series.</li>\n<li>Zero - Displays empty points as zero values.</li>\n<li>Drop - Ignores empty points while rendering the series.</li>\n<li>Average - Displays empty points as the average of the previous and next points.</li>\n</ul>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/common/emptyPointSettings#mode"}},"ErrorBarCapSettings":{"color":{"name":"color","description":"<p>The stroke color of the cap, which accepts values in hex or rgba as valid CSS color strings.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarCapSettings#color"},"length":{"name":"length","description":"<p>The length of the caps on the error bars, measured in pixels.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarCapSettings#length"},"opacity":{"name":"opacity","description":"<p>The opacity of the error bar caps in the chart.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarCapSettings#opacity"},"width":{"name":"width","description":"<p>The width of the error bar cap in pixels.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarCapSettings#width"}},"ErrorBarSettings":{"color":{"name":"color","description":"<p>The color of the error bar's stroke, which accepts values in hex, rgba, or as a valid CSS color string.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarSettings#color"},"direction":{"name":"direction","description":"<p>Specifies the direction of the error bar.\nThe available options are:</p>\n<ul>\n<li>Both - Renders error bars in both directions (positive and negative).</li>\n<li>Minus - Renders error bars in the negative direction.</li>\n<li>Plus - Renders error bars in the positive direction.</li>\n</ul>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarSettings#direction"},"errorBarCap":{"name":"errorBarCap","description":"<p>The <code>errorBarCap</code> property allows customization of the appearance and behavior of the caps at the ends of error bars in a chart series.</p>\n","type":"ErrorBarCapSettingsModel","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarSettings#errorbarca