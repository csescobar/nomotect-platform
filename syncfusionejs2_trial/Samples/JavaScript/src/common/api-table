/grid/#setrowdata"},"setRowDataAsync":{"name":"setRowDataAsync","description":"<p>Updates a full row (by primary key) and resolves after an optional delay.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#setrowdataasync"},"showAdaptiveFilterDialog":{"name":"showAdaptiveFilterDialog","description":"<p>To manually show the vertical row mode filter dialog</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#showadaptivefilterdialog"},"showAdaptiveSortDialog":{"name":"showAdaptiveSortDialog","description":"<p>To manually show the vertical row sort filter dialog</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#showadaptivesortdialog"},"showColumns":{"name":"showColumns","description":"<p>Shows a column by its column name.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#showcolumns"},"showMaskRow":{"name":"showMaskRow","description":"","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#showmaskrow"},"showSpinner":{"name":"showSpinner","description":"<p>By default, grid shows the spinner for all its actions. You can use this method to show spinner at your needed time.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#showspinner"},"sortColumn":{"name":"sortColumn","description":"<p>Sorts a column with the given options.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#sortcolumn"},"sortColumnAsync":{"name":"sortColumnAsync","description":"<p>Sorts a column and resolves when sorting finishes.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#sortcolumnasync"},"startEdit":{"name":"startEdit","description":"<p>Starts edit the selected row. At least one row must be selected before invoking this method.\n<code>editSettings.allowEditing</code> should be true.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#startedit"},"undoEdit":{"name":"undoEdit","description":"<p>Undo the last edit action and restore the grid to its previous state.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#undoedit"},"ungroupColumn":{"name":"ungroupColumn","description":"<p>Ungroups a column by column name.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#ungroupcolumn"},"ungroupColumnAsync":{"name":"ungroupColumnAsync","description":"<p>Ungroups a column and resolves when ungrouping completes.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#ungroupcolumnasync"},"unpinRows":{"name":"unpinRows","description":"<p>Unpin the rows using data</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#unpinrows"},"updateCell":{"name":"updateCell","description":"<p>To update the specified cell by given value without changing into edited state.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#updatecell"},"updateExternalMessage":{"name":"updateExternalMessage","description":"<p>Defines the text of external message.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#updateexternalmessage"},"updateRow":{"name":"updateRow","description":"<p>To update the specified row by given values without changing into edited state.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#updaterow"},"updateRowAsync":{"name":"updateRowAsync","description":"<p>Updates a row by index (without entering edit mode) and resolves when saved.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#updaterowasync"},"updateRowValue":{"name":"updateRowValue","description":"","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#updaterowvalue"},"Inject":{"name":"Inject","description":"<p>Dynamically injects the required modules to the component.</p>\n","type":"Method","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/#inject"}},"GroupSettings":{"allowReordering":{"name":"allowReordering","description":"<p>If <code>allowReordering</code> is set to true, Grid allows the grouped elements to be reordered.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/groupSettings#allowreordering"},"captionTemplate":{"name":"captionTemplate","description":"<p>The Caption Template allows user to display the string or HTML element in group caption.</p>\n<blockquote>\n<p>It accepts either the\n<a href=\"../../common/template/\">template string</a> or the HTML element ID.</p>\n</blockquote>\n","type":"string|Object|Function","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/groupSettings#captiontemplate"},"columns":{"name":"columns","description":"<p>Specifies the column names to group at initial rendering of the Grid.\nYou can also get the currently grouped columns.</p>\n","type":"string[]","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/groupSettings#columns"},"disablePageWiseAggregates":{"name":"disablePageWiseAggregates","description":"<p>If <code>disablePageWiseAggregates</code> set to true, then the group aggregate value will\nbe calculated from the whole data instead of paged data and two requests will be made for each page\nwhen Grid bound with remote service.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/groupSettings#disablepagewiseaggregates"},"enableLazyLoading":{"name":"enableLazyLoading","description":"<p>The Lazy load grouping, allows the Grid to render only the initial level caption rows in collapsed state while grouping.\nThe child rows of each caption will render only when we expand the captions.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/groupSettings#enablelazyloading"},"showDropArea":{"name":"showDropArea","description":"<p>If <code>showDropArea</code> is set to true, the group drop area element will be visible at the top of the Grid.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/groupSettings#showdroparea"},"showGroupedColumn":{"name":"showGroupedColumn","description":"<p>If <code>showGroupedColumn</code> is set to false, it hides the grouped column after grouping.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/groupSettings#showgroupedcolumn"},"showToggleButton":{"name":"showToggleButton","description":"<p>If <code>showToggleButton</code> set to true, then the toggle button will be showed in the column headers which can be used to group\nor ungroup columns by clicking them.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/groupSettings#showtogglebutton"},"showUngroupButton":{"name":"showUngroupButton","description":"<p>If <code>showUngroupButton</code> set to false, then ungroup button is hidden in dropped element.\nIt can be used to ungroup the grouped column when click on ungroup button.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/groupSettings#showungroupbutton"},"caption":{"name":"caption","description":"<p>It allows to set the caption to custom field that will be used to created from custom group fields in the pivot table.</p>\n<blockquote>\n<p>It is applicable only for custom grouping.</p>\n</blockquote>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/model/groupSettings#caption"},"customGroups":{"name":"customGroups","description":"<p>It allows to set the custom group information to create custom group fields.</p>\n<blockquote>\n<p>It is applicable only for custom grouping.</p>\n</blockquote>\n","type":"ICustomGroups[]","link":"//ej2.syncfusion.com/javascript/documentation/api/model/groupSettings#customgroups"},"endingAt":{"name":"endingAt","description":"<p>It allows to set the start value/date to group fields to the specified range that to be displayed in the pivot table.</p>\n","type":"string|Date|number","link":"//ej2.syncfusion.com/javascript/documentation/api/model/groupSettings#endingat"},"groupInterval":{"name":"groupInterval","description":"<p>It allows to specify the date group intervals such as years or quarter or months or days or hours or minutes or seconds to group fields based on that in the pivot table. They options are:</p>\n<ul>\n<li>Years - Defines group field as 'Years' for date type field.</li>\n<li>Quarters - Defines group field as 'Quarters' for date type field.</li>\n<li>QuarterYear - Defines group field as 'Quarter Year' for date type field.</li>\n<li>Months - Defines group field as 'Months' for date type field.</li>\n<li>Days - Defines group field as 'Days' for date type field.</li>\n<li>Hours - Defines group field as 'Hours' for date type field.</li>\n<li>Minutes - Defines group field as 'Minutes' for date type field.</li>\n<li>Seconds - Defines group field as 'Seconds' for date type field.</li>\n</ul>\n<blockquote>\n<p>It is applicable only for date type grouping.</p>\n</blockquote>\n","type":"DateGroup[]","link":"//ej2.syncfusion.com/javascript/documentation/api/model/groupSettings#groupinterval"},"name":{"name":"name","description":"<p>It allows to set the specific field name to apply group settings.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/model/groupSettings#name"},"rangeInterval":{"name":"rangeInterval","description":"<p>It allows to set the interval range to group field based on the specified range.</p>\n<blockquote>\n<p>It is applicable only of number type grouping.</p>\n</blockquote>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/model/groupSettings#rangeinterval"},"startingAt":{"name":"startingAt","description":"<p>It allows to set the start value/date to group fields from the specified range that to be displayed in the pivot table.</p>\n","type":"string|Date|number","link":"//ej2.syncfusion.com/javascript/documentation/api/model/groupSettings#startingat"},"type":{"name":"type","description":"<p>It allows to set the type as date or number or custom to the specified field for apply grouping. The types are:</p>\n<ul>\n<li>Date - Defines group type as 'Date' for date type field</li>\n<li>Number - Defines group type as 'Number' for numeric type field.</li>\n<li>Custom - Defines group type as 'Custom' for custom group field.</li>\n</ul>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/model/groupSettings#type"}},"ResizeSettings":{"mode":{"name":"mode","description":"<p>Defines the mode of Grid column resizing. The available modes are:\n<code>Normal</code>: Columns will not be adjusted to fit the remaining space.\n<code>Auto</code>: Resized column width will be adjusted by other columns automatically.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/resizeSettings#mode"}},"CommandColumnModel":{"buttonOption":{"name":"buttonOption","description":"<p>Define the button model</p>\n","type":"CommandButtonOptions","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/commandColumnModel#buttonoption"},"title":{"name":"title","description":"<p>Define the command Button tooltip.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/commandColumnModel#title"},"type":{"name":"type","description":"<p>Define the command Button type.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/commandColumnModel#type"}},"GridColumn":{"allowEditing":{"name":"allowEditing","description":"<p>If <code>allowEditing</code> set to false, then it disables editing of a particular column.\nBy default all columns are editable.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#allowediting"},"allowFiltering":{"name":"allowFiltering","description":"<p>If <code>allowFiltering</code> set to false, then it disables filtering option and filter bar element of a particular column.\nBy default all columns are filterable.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#allowfiltering"},"allowGrouping":{"name":"allowGrouping","description":"<p>If <code>allowGrouping</code> set to false, then it disables grouping of a particular column.\nBy default all columns are groupable.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#allowgrouping"},"allowReordering":{"name":"allowReordering","description":"<p>If <code>allowReordering</code> set to false, then it disables reorder of a particular column.\nBy default all columns can be reorder.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#allowreordering"},"allowResizing":{"name":"allowResizing","description":"<p>If <code>allowResizing</code> is set to false, it disables resize option of a particular column.\nBy default all the columns can be resized.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#allowresizing"},"allowSearching":{"name":"allowSearching","description":"<p>If <code>allowSearching</code> set to false, then it disables Searching of a particular column.\nBy default all columns allow Searching.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#allowsearching"},"allowSorting":{"name":"allowSorting","description":"<p>If <code>allowSorting</code> set to false, then it disables sorting option of a particular column.\nBy default all columns are sortable.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#allowsorting"},"autoFit":{"name":"autoFit","description":"<p>If <code>autoFit</code> set to true, then the particular column content width will be\nadjusted based on its content in the initial rendering itself.\nSetting this property as true is equivalent to calling <code>autoFitColumns</code> method in the <code>dataBound</code> event.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#autofit"},"clipMode":{"name":"clipMode","description":"<p>Defines the cell content's overflow mode. The available modes are</p>\n<ul>\n<li><code>Clip</code> -  Truncates the cell content when it overflows its area.</li>\n<li><code>Ellipsis</code> -  Displays ellipsis when the cell content overflows its area.</li>\n<li><code>EllipsisWithTooltip</code> - Displays ellipsis when the cell content overflows its area\nalso it will display tooltip while hover on ellipsis applied cell.</li>\n</ul>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#clipmode"},"columns":{"name":"columns","description":"<p>Defines stacked columns</p>\n","type":"string[]|ColumnModel[]","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#columns"},"commands":{"name":"commands","description":"<p><code>commands</code> provides an option to display command buttons in every cell.\nThe available built-in command buttons are</p>\n<ul>\n<li>Edit - Edit the record.</li>\n<li>Delete - Delete the record.</li>\n<li>Save - Save the record.</li>\n<li>Cancel - Cancel the edit state.</li>\n</ul>\n","type":"CommandModel[]","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#commands"},"customAttributes":{"name":"customAttributes","description":"<p>The CSS styles and attributes of the content cells of a particular column can be customized.</p>\n","type":"Object","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#customattributes"},"dataSource":{"name":"dataSource","description":"<p>Defines the column data source which will act as foreign data source.</p>\n","type":"Object[]|DataManager|DataResult","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#datasource"},"defaultValue":{"name":"defaultValue","description":"<p>Defines default values for the component when adding a new record to the Grid.</p>\n","type":"string|number|Date|boolean|null","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#defaultvalue"},"disableHtmlEncode":{"name":"disableHtmlEncode","description":"<p>If <code>disableHtmlEncode</code> is set to true, it encodes the HTML of the header and content cells.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#disablehtmlencode"},"displayAsCheckBox":{"name":"displayAsCheckBox","description":"<p>If <code>displayAsCheckBox</code> is set to true, it displays the column value as a check box instead of Boolean value.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#displayascheckbox"},"edit":{"name":"edit","description":"<p>Defines the <code>IEditCell</code> object to customize default edit cell.</p>\n","type":"IEditCell","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#edit"},"editTemplate":{"name":"editTemplate","description":"<p>Defines the cell edit template that used as editor for a particular column.\nIt accepts either template string or HTML element ID.</p>\n","type":"string|Function","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#edittemplate"},"editType":{"name":"editType","description":"<p>Defines the type of component for editable.</p>\n","type":"string|string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#edittype"},"enableColumnSpan":{"name":"enableColumnSpan","description":"<p>Allows grid to perform column spanning on the specified column.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#enablecolumnspan"},"enableGroupByFormat":{"name":"enableGroupByFormat","description":"<p>If <code>enableGroupByFormat</code> set to true, then it groups the particular column by formatted values.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#enablegroupbyformat"},"enableRowSpan":{"name":"enableRowSpan","description":"<p>Allows grid to perform row spanning on the specified column.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#enablerowspan"},"field":{"name":"field","description":"<p>Defines the field name of column which is mapped with mapping name of DataSource.\nThe bounded columns can be sort, filter and group etc.,\nThe <code>field</code> name must be a valid JavaScript identifier,\nthe first character must be an alphabet and should not contain spaces and special characters.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#field"},"filter":{"name":"filter","description":"<p>It is used to customize the default filter options for a specific columns.</p>\n<ul>\n<li>type -  Specifies the filter type as menu or checkbox.</li>\n<li>ui - to render custom component for specific column it has following functions.</li>\n<li>ui.create – It is used for creating custom components.</li>\n<li>ui.read -  It is used for read the value from the component.</li>\n<li>ui.write - It is used to apply component model as dynamically.</li>\n</ul>\n<blockquote>\n<p>Check the <a href=\"../../grid/filtering/filter-menu/#custom-component-in-filter-menu\"><code>Filter UI</code></a> for its customization.</p>\n</blockquote>\n","type":"IFilter","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#filter"},"filterBarTemplate":{"name":"filterBarTemplate","description":"<p>The <code>filterBarTemplate</code> is used to add a custom component instead of default input component for filter bar.\nIt have create and read functions.</p>\n<ul>\n<li>create: It is used for creating custom components.</li>\n<li>read: It is used to perform custom filter action.</li>\n</ul>\n","type":"IFilterUI","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#filterbartemplate"},"filterTemplate":{"name":"filterTemplate","description":"<p>Defines the filter template/UI that used as filter for a particular column.\nIt accepts either template string or HTML element ID.</p>\n","type":"string|Function","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#filtertemplate"},"foreignKeyField":{"name":"foreignKeyField","description":"<p>Defines the mapping column name of the foreign data source.\nIf it is not defined then the <code>columns.field</code> will be considered as mapping column name</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#foreignkeyfield"},"foreignKeyValue":{"name":"foreignKeyValue","description":"<p>Defines the display column name from the foreign data source which will be obtained from comparing local and foreign data.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#foreignkeyvalue"},"format":{"name":"format","description":"<p>It is used to change display value with the given format and does not affect the original data.\nGets the format from the user which can be standard or custom\n<code>number</code> and <code>date</code> formats.</p>\n","type":"string|NumberFormatOptions|DateFormatOptions","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#format"},"formatter":{"name":"formatter","description":"<p>Defines the method which is used to achieve custom formatting from an external function.\nThis function triggers before rendering of each cell.</p>\n","type":"Object|ICellFormatter|Function","link":"//ej2.syncfusion.com/javascript/documentation/api/grid/gridColumn#formatter"},"freeze":{"name":"freeze","description":"<p>defines which side the column need to freeze\nThe available built-in freeze directions are</p>\n<ul>\n<li>Left - Freeze the column at left sid