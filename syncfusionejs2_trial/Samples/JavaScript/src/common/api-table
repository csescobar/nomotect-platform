|string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarSettings#verticalerror"},"verticalNegativeError":{"name":"verticalNegativeError","description":"<p>The vertical negative error of the point can be mapped from the data source as well.</p>\n","type":"number|string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarSettings#verticalnegativeerror"},"verticalPositiveError":{"name":"verticalPositiveError","description":"<p>The vertical positive error of the point can be mapped from the data source as well.</p>\n","type":"number|string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarSettings#verticalpositiveerror"},"visible":{"name":"visible","description":"<p>If set to true, the error bar for the data will be rendered.</p>\n","type":"boolean","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarSettings#visible"},"width":{"name":"width","description":"<p>The <code>width</code> property determines the thickness of the error bars rendered in the chart series.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarSettings#width"},"errorBarColorMapping":{"name":"errorBarColorMapping","description":"<p>Defines the color for the error bar, which is mapped to the data source mapping name.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/errorBarSettings#errorbarcolormapping"}},"Indexes":{"point":{"name":"point","description":"<p>Specifies the index of the data point within the series.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/common/indexes#point"},"series":{"name":"series","description":"<p>Specifies the index of the series.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/common/indexes#series"}},"LabelBorder":{"color":{"name":"color","description":"<p>The color of the border, which accepts values in hex and rgba as valid CSS color strings.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/labelBorder#color"},"type":{"name":"type","description":"<p>Specifies the border type for the labels.\nThe available types include:</p>\n<ul>\n<li>Rectangle</li>\n<li>Without Top Border</li>\n<li>Without Top and Bottom Border</li>\n<li>Without Border</li>\n<li>Brace</li>\n<li>Curly Brace</li>\n</ul>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/labelBorder#type"},"width":{"name":"width","description":"<p>The <code>width</code> property specifies the thickness of the border in pixels.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/labelBorder#width"}},"MajorGridLines":{"color":{"name":"color","description":"<p>Specifies the color of the major grid line, accepting hex and rgba values as valid CSS color strings.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/majorGridLines#color"},"dashArray":{"name":"dashArray","description":"<p>The dash array of the grid lines, defining the pattern of dashes and gaps for the major grid lines on the axis.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/majorGridLines#dasharray"},"width":{"name":"width","description":"<p>The width of the major grid lines in pixels, determining the thickness of the lines on the axis.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/majorGridLines#width"}},"MajorTickLines":{"color":{"name":"color","description":"<p>Specifies the color of the major tick line, accepting hex and rgba values as valid CSS color strings.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/majorTickLines#color"},"height":{"name":"height","description":"<p>The height of the ticks in pixels, which defines their length on the axis.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/majorTickLines#height"},"width":{"name":"width","description":"<p>The width of the major tick lines in pixels, determining the thickness of the lines on the axis.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/majorTickLines#width"}},"MinorGridLines":{"color":{"name":"color","description":"<p>Specifies the color of the minor grid line, accepting hex and rgba values as valid CSS color strings.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/minorGridLines#color"},"dashArray":{"name":"dashArray","description":"<p>The dash array of the grid lines, defining the pattern of dashes and gaps for the minor grid lines on the chart's axis.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/minorGridLines#dasharray"},"width":{"name":"width","description":"<p>The width of the minor grid lines in pixels, determining the thickness of the lines on the axis.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/minorGridLines#width"}},"MinorTickLines":{"color":{"name":"color","description":"<p>Specifies the color of the minor tick line, accepting hex and rgba values as valid CSS color strings.</p>\n","type":"string","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/minorTickLines#color"},"height":{"name":"height","description":"<p>The height of the ticks in pixels, which defines their length on the axis.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/minorTickLines#height"},"width":{"name":"width","description":"<p>The width of the minor tick lines in pixels, determining the thickness of the lines on the axis.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documentation/api/chart/minorTickLines#width"}},"Offset":{"x":{"name":"x","description":"<p>Specifies the x value of the marker's position.</p>\n","type":"number","link":"//ej2.syncfusion.com/javascript/documenta