{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"control-section col-md-8\" align=\"center\">\n    <div id=\"dotCustomization\"></div>\n</div>\n   <div class=\"col-md-4 property-section\">\n        <div class=\"property-panel-header\">Properties</div>\n       <table title=\"Properties\" style=\"width: 100%; height: 100%;\">\n            <tbody><tr>\n            <td style=\"width: 60%\">\n                    <div class=\"prop-text\">Actual Value:</div>\n                </td>\n                <td style=\"width: 40%\">\n                    <div id=\"actualValue\">\n                    </div>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 60%\">\n                    <div class=\"prop-text\">Target Value:</div>\n                </td>\n                <td style=\"width: 40%;\">\n                    <div id=\"targetValue\">\n                    </div>\n                </td>\n            </tr>\n           <tr style=\"height: 50px\">\n               <td style=\"width: 40%\">\n                   <div>Feature Bar Type:</div>\n               </td>\n               <td style=\"width: 60%;\">\n                    <div id=\"featureType\">\n                    </div>\n               </td>\n           </tr>\n           <tr style=\"height: 50px\">\n               <td style=\"width: 60%\">\n                   <div>Feature Bar Color:</div>\n               </td>\n               <td style=\"width: 40%;\">\n                   <div>\n                       <input id=\"color-picker\" type=\"color\">\n                   </div>\n               </td>\n           </tr>\n           <tr style=\"height: 50px\">\n               <td style=\"width: 60%\">\n                   <div>Target Color:</div>\n               </td>\n               <td style=\"width: 40%;\">\n                   <div>\n                       <input id=\"color-picker1\" type=\"color\">\n                   </div>\n               </td>\n           </tr>\n       </tbody></table>\n   </div>\n</div>\n\n\n\n<style>\n#control-container {\n   padding: 0px !important;\n}\n</style></body></html>"}