{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"control-section\">\n    <div class=\"control_wrapper\">\n        <div class=\"pane\">\n            <div class=\"tabs-wrap\">\n                <div class=\"wrap\">\n                    <input type=\"text\" id=\"start\">\n                </div>\n            </div>\n            <div class=\"tabs-wrap\" style=\"clear: both\">\n                <div class=\"wrap\">\n                    <input type=\"text\" id=\"end\">\n                </div>\n            </div>\n            <div class=\"tabs-wrap\" style=\"clear: both;padding: 14px 10px;\">\n                <div class=\"wrap\">\n                    <input type=\"checkbox\" id=\"dayRange\">\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n<!-- custom code start -->\n<style>\n    .control_wrapper {\n        padding: 2%;\n        margin: 0 auto;\n        max-width: 400px;\n    }\n\n    .e-bigger .control-section {\n        margin-top: 60px;\n    }\n\n    .tabs-wrap {\n        padding: 10px;\n    }\n</style>\n<!-- custom code end--></div></body></html>"}