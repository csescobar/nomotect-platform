{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"col-lg-12 control-section e-img-editor-sample\">\n    <div id=\"imageeditor\" class=\"row\">\n    </div>\n</div>\n\n\n\n<style>\n    .e-img-editor-sample {\n        height: 80vh;\n        width: 100%;\n    }\n\n    @media only screen and (max-width: 700px) {\n        .e-img-editor-sample {\n            height: 75vh;\n            width: 100%;\n        }\n    }\n\n    .control-wrapper {\n        height: 100%;\n    }\n\n    .e-image-editor {\n      margin: 0 auto;\n    }\n</style>\n</div></body></html>"}