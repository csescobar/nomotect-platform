{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"col-lg-12 control-section\">\n    <div id=\"signature-control\">\n        <div class=\"e-sign-heading\">\n            <span id=\"signdescription\">Sign below</span>\n            <span class=\"e-btn-options\">\n                <button id=\"signsave\" title=\"Save signature as PNG\" class=\"e-control e-btn e-primary e-sign-save\">SAVE</button>\n                <button id=\"signclear\" class=\"e-control e-btn e-primary e-sign-clear\">CLEAR</button>\n            </span>\n        </div>\n        <canvas id=\"signature\" style=\"height: 90%; width: 100%;\"></canvas>\n    </div>\n</div>\n\n\n</div></body></html>"}