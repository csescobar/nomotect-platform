{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"control-section\">\n    <div class=\"fab-default-container\">\n        <div class=\"row\">\n            <div class=\"col-xs-6 col-sm-6 col-lg-6 col-md-6\">\n                <div id=\"target1\" class=\"col-xs-12 col-sm-12 col-lg-6 col-md-6 fab-index\">\n                </div>\n                <div id=\"target2\" class=\"col-xs-12 col-sm-12 col-lg-6 col-md-6 fab-index\">\n                </div>\n            </div>\n            <div class=\"col-xs-6 col-sm-6 col-lg-6 col-md-6\">\n                <div id=\"target3\" class=\"col-xs-12 col-sm-12 col-lg-6 col-md-6 fab-index\">\n                </div>\n                <div id=\"target4\" class=\"col-xs-12 col-sm-12 col-lg-6 col-md-6 fab-index\">\n                </div>\n            </div>\n        </div>\n\n        <button id=\"fab1\" title=\"Contact\"></button>\n        <button id=\"fab2\"></button>\n        <button id=\"fab3\"></button>\n        <button id=\"fab4\"></button>\n    </div>\n</div>\n\n\n<style>\n    .fab-default-container {\n        width: 90%;\n        margin: 8% auto;\n        text-align: center;\n        max-width: 600px;\n    }\n    .fab-index{\n        z-index:500 !important;\n    }\n\n    .fab-default-container .col-xs-12 {\n        position: relative;\n        margin: 15px 0;\n        min-height: 100px;\n    }\n\n    .fab-default-container .col-md-6 {\n        padding: 0;\n    }\n</style></div></body></html>"}