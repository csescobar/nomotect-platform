{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"col-lg-8 control-section inplace-control-section drop-down-layout\">\n    <div class=\"control_wrapper\">\n        <table>\n            <tbody><tr>\n                <td>\n                    <label class=\"control-label\">\n                        DropDownList </label>\n                </td>\n                <td>\n                    <div id=\"dropdownEle\"></div>\n                </td>\n            </tr>\n            <tr>\n                <td>\n                    <label class=\"control-label\">\n                        AutoComplete </label>\n                </td>\n                <td>\n                    <div id=\"autoCompleteEle\"></div>\n                </td>\n            </tr>\n            <tr>\n                <td>\n                    <label class=\"control-label\"> ComboBox\n                    </label>\n                </td>\n                <td>\n                    <div id=\"comboBoxEle\"></div>\n                </td>\n            </tr>\n            <tr>\n                <td>\n                    <label class=\"control-label\"> MultiSelect\n                    </label>\n                </td>\n                <td>\n                    <div id=\"multiSelectEle\"></div>\n                </td>\n            </tr>\n        </tbody></table>\n    </div>\n</div>\n<div class=\"col-lg-4 property-section\">\n    <table id=\"property\" title=\"Properties\">\n        <tbody><tr>\n            <td>\n                <div> Mode</div>\n            </td>\n            <td>\n                <div>\n                    <select id=\"editorMode_dropdowns\" class=\"form-control\">\n                        <option value=\"Inline\">Inline</option>\n                        <option value=\"Popup\">Popup</option>\n                    </select>\n                </div>\n            </td>\n        </tr>\n    </tbody></table>\n</div>\n    \n    \n\n    <style>\n\n    .inplace-control-section.drop-down-layout .e-inplaceeditor .e-editable-component .e-clear-icon-hide,\n    .e-inplaceeditor-tip .e-editable-component .e-input-group .e-clear-icon.e-clear-icon-hide {\n        display: block;\n        visibility: hidden;\n    }\n\n    </style>\n\n    </div></body></html>"}