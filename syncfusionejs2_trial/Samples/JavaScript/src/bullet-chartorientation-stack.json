{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"control-section col-md-8\">\n    <div id=\"orientation\" align=\"center\"></div>\n</div>\n<div class=\"col-md-4 property-section\">\n    <div class=\"property-panel-header\">Properties</div>\n    <table title=\"Properties\" style=\"width: 100%; height: 100%;\">\n            <tbody><tr>\n                <td style=\"width: 60%\">\n                    <div>Orientation</div>\n                </td>\n                <td style=\"width: 40%\">\n                    <div id=\"orientationSelect\">\n                    </div>\n                </td>\n            </tr>\n    </tbody></table>\n</div>\n\n\n\n<style>\n#control-container {\n    padding: 0px !important;\n}\n</style></div></body></html>"}