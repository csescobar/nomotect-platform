{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"control-section row\">\n<div class=\"col-lg-6\">\n    <div id=\"wrapper\">\n        <label class=\"example-label\">DateTime Restriction</label>\n        <input id=\"datetimepicker1\" type=\"text\"><br><br>\n    </div>\n</div>\n<div class=\"col-lg-6\">\n    <div id=\"wrapper\">\n        <label class=\"example-label\">Time Restriction</label>\n        <input id=\"datetimepicker2\" type=\"text\"><br><br>\n    </div>\n</div>\n</div>\n\n\n<!-- custom code start -->\n<style>\n    #wrapper {\n        max-width: 250px;\n        padding: 30px 0px 0px;\n        margin: 0 auto;\n    }\n</style>\n<!-- custom code end--></div></body></html>"}