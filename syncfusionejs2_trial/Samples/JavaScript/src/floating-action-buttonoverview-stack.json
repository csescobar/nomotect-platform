{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\"><div class=\"control-section\">\n     <div id=\"target\" class=\"fab-grid-container fab-index\">\n        <div id=\"Grid\"></div>\n        <button id=\"fab\" title=\"Add Record\"></button>\n     </div>\n</div>\n\n\n<style>\n    .fab-grid-container {\n        position: relative;\n    }\n    .fab-index{\n        z-index:500 !important;\n    }\n</style>\n</div></body></html>"}