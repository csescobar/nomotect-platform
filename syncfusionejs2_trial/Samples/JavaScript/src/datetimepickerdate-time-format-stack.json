{"index.html":"<html><head><script src=\"https://cdn.syncfusion.com/ej2/28.1.33/dist/ej2.min.js\" type=\"text/javascript\"></script>\n    <link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n    \n<div class=\"col-lg-8 control-section\">\n    <div id=\"wrapper\">\n        <input id=\"datetimepicker\" type=\"text\">\n        <br>\n        <br>\n    </div>\n</div>\n\n<div class=\"col-lg-4 property-section\">\n            <propertypane title=\"Properties\">\n                <div class=\"property-panel-header\">Properties</div>\n                <div class=\"property-panel-content\">\n                    <label class=\"example-label\">Choose a display format</label>\n                    <input id=\"datetimeformats\" placeholder=\"Select a format\">\n                </div>\n                <div class=\"property-panel-content\">\n                    <label class=\"example-label\">Choose input formats</label>\n                    <input id=\"inputFormatsDateTimePicker\" placeholder=\"e.g. MM/dd/yyyy hh:mm a\">\n                </div>\n            </propertypane>\n</div>\n\n    \n\n    \n    \n\n\n\n    \n\n</div></body></html><!-- custom code end -->"}