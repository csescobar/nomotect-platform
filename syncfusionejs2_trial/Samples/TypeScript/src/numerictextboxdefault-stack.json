{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"col-lg-12 control-section\">\n    <div class=\"content-wrapper\">\n        <div class=\"control-label\">Numeric TextBox\n        </div>\n        <input id=\"numeric\" type=\"text\">\n        <div class=\"control-label\">Percentage TextBox\n        </div>\n        <input id=\"percent\" type=\"text\">\n        <div class=\"control-label\">Currency TextBox\n        </div>\n        <input id=\"currency\" type=\"text\">\n    </div>\n</div>\n\n\n\n\n\n\n<style>\n    .content-wrapper {\n        width: 35%;\n        margin: 0 auto;\n        min-width: 185px;\n    }\n    \n    .e-float-input.e-numeric.e-input-group {\n        margin-top: 40px;\n    }\n    .control-label {\n        padding: 24px 0px 10px 0px;\n        font-size: 12px;\n    }\n</style>\n</div></body></html>"}