{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<style>\n    .recurrence-editor-wrap {\n        margin: 0 25%;\n    }\n\n    .rule-output-container {\n        height: auto;\n        border: 1px solid #969696;\n    }\n\n    #rule-output {\n        padding: 8px 4px;\n        text-align: center;\n        min-height: 20px;\n        overflow: hidden;\n        overflow-wrap: break-word;\n    }\n\n    @media (max-width: 580px) {\n        .recurrence-editor-wrap {\n            margin: 0 5%;\n        }\n    }\n</style>\n<div class=\"control-section\">\n    <div class=\"content-wrapper recurrence-editor-wrap\">\n        <div style=\"padding-bottom:15px;\">\n            <label>Rule Output</label>\n            <div class=\"rule-output-container\">\n                <div id=\"rule-output\"></div>\n            </div>\n        </div>\n        <div id=\"RecurrenceEditor\">\n        </div>\n    </div>\n</div>\n\n\n\n\n</div></body></html>"}