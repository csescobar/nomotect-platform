{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"col-lg-8 control-section\">\n    <div class=\"content-wrapper\">\n        <div class=\"sliderwrap\">\n            <label class=\"userselect\">Default Slider</label>\n            <div id=\"default\"></div>\n        </div>\n        <div class=\"sliderwrap\">\n            <label class=\"userselect\">Range Slider</label>\n            <div id=\"range\"></div>\n        </div>\n    </div>\n</div>\n\n<div class=\"col-lg-4 property-section\">\n    <table id=\"property\" title=\"Properties\">\n        <tbody>\n            <tr>\n                <td style=\"width: 50%\">\n                    <div class=\"userselect\">Placement</div>\n                </td>\n                <td style=\"width: 50%;padding-right: 10px\">\n                    <div>\n                        <select id=\"placement\">\n                            <option value=\"Before\">Before</option>\n                            <option value=\"After\">After</option>\n                        </select>\n                    </div>\n                </td>\n            </tr>\n            <tr id=\"slider-showon\">\n                <td style=\"width: 50%\">\n                    <div class=\"userselect\">ShowOn</div>\n                </td>\n                <td style=\"width: 50%;padding-right: 10px\">\n                    <div>\n                        <select id=\"showon\">\n                            <option value=\"Auto\">Auto</option>\n                            <option value=\"Focus\">Focus</option>\n                            <option value=\"Hover\">Hover</option>\n                            <option value=\"Always\">Always</option>\n                        </select>\n                    </div>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n</div>\n\n\n\n\n\n<style>\n    .material #property tr#slider-showon {\n        display: none;\n    }\n\n    .content-wrapper {\n        width: 52%;\n        margin: 0 auto;\n        min-width: 185px;\n    }\n\n    .sliderwrap {\n        margin-top: 45px;\n        margin-left: -20%;\n    }\n\n    .sliderwrap label {\n        padding-bottom: 26px;\n        font-size: 13px;\n        font-weight: 500;\n        margin-top: 15px;\n    }\n\n    .userselect {\n        -webkit-user-select: none;\n        /* Safari 3.1+ */\n        -moz-user-select: none;\n        /* Firefox 2+ */\n        -ms-user-select: none;\n        /* IE 10+ */\n        user-select: none;\n        /* Standard syntax */\n    }\n</style>\n</div></body></html>"}