{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"control-section api-carousel-section\">\n    <div class=\"col-lg-9 content-wrapper\">\n        <div class=\"carousel-sample\">\n            <div id=\"carousel\"></div>\n        </div>\n    </div>\n    <div class=\"col-lg-3 property-section\">\n        <div id=\"property\" class=\"property-panel-table\" title=\"Properties\">\n            <table id=\"property\" title=\"Properties\" style=\"width: 100%\">\n                <tbody>\n                    <tr>\n                        <td>Enable Autoplay</td>\n                        <td>\n                            <input id=\"autoPlay\" type=\"checkbox\">\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>Infinite Looping</td>\n                        <td>\n                            <input id=\"loop\" type=\"checkbox\">\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>Show Indicators</td>\n                        <td>\n                            <input id=\"showIndicators\" type=\"checkbox\">\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>Show Play Button</td>\n                        <td>\n                            <input id=\"showPlayButton\" type=\"checkbox\">\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>Show Arrows</td>\n                        <td>\n                            <select id=\"showButtons\" class=\"form-control\">\n                                <option value=\"Hidden\">Hidden</option>\n                                <option value=\"Visible\" selected=\"\">Visible</option>\n                                <option value=\"VisibleOnHover\">On Hover</option>\n                            </select>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>Slide Interval</td>\n                        <td>\n                            <select id=\"interval\" class=\"form-control\">\n                                <option value=\"3000\" selected=\"\">3 seconds</option>\n                                <option value=\"5000\">5 seconds</option>\n                                <option value=\"7000\">7 seconds</option>\n                            </select>\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n    </div>\n</div>\n<style>\n    .api-carousel-section .carousel-sample {\n        margin: 0 auto 2em;\n        max-width: 500px;\n        height: 300px;\n    }\n\n    .api-carousel-section .property-panel-table td {\n        margin: 0;\n        padding-bottom: 1em;\n    }\n\n    .api-carousel .e-carousel-items .e-carousel-item .img-container {\n        height: 100%;\n    }\n\n    .api-carousel .e-carousel-items .e-carousel-item .img-container .img-caption {\n        color: rgba(255, 255, 255);\n        font-style: oblique;\n        font-size: 1.5rem;\n        margin: 0;\n        left: 1.5rem;\n        position: absolute;\n        text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.5);\n        top: 1.5rem;\n    }\n</style>\n<script type=\"text/x-template\" id=\"itemTemplate1\">\n    <figure class=\"img-container\">\n        <img src=\"//npmci.syncfusion.com/development/demos/src/carousel/images/bridge.jpg\" alt=\"bridge\" style=\"height:100%;width:100%;\" />\n        <figcaption class=\"img-caption\">Showing 1 of 5</figcaption>\n    </figure>\n</script>\n<script type=\"text/x-template\" id=\"itemTemplate2\">\n    <figure class=\"img-container\">\n        <img src=\"//npmci.syncfusion.com/development/demos/src/carousel/images/trees.jpg\" alt=\"spring_trees\" style=\"height:100%;width:100%;\" />\n        <figcaption class=\"img-caption\">Showing 2 of 5</figcaption>\n    </figure>\n</script>\n<script type=\"text/x-template\" id=\"itemTemplate3\">\n    <figure class=\"img-container\">\n        <img src=\"//npmci.syncfusion.com/development/demos/src/carousel/images/waterfall.jpg\" alt=\"waterfall\" style=\"height:100%;width:100%;\" />\n        <figcaption class=\"img-caption\">Showing 3 of 5</figcaption>\n    </figure>\n</script>\n<script type=\"text/x-template\" id=\"itemTemplate4\">\n    <figure class=\"img-container\">\n        <img src=\"//npmci.syncfusion.com/development/demos/src/carousel/images/sea.jpg\" alt=\"sea\" style=\"height:100%;width:100%;\" />\n        <figcaption class=\"img-caption\">Showing 4 of 5</figcaption>\n    </figure>\n</script>\n<script type=\"text/x-template\" id=\"itemTemplate5\">\n    <figure class=\"img-container\">\n        <img src=\"//npmci.syncfusion.com/development/demos/src/carousel/images/rocks.jpeg\" alt=\"rocks\" style=\"height:100%;width:100%;\" />\n        <figcaption class=\"img-caption\">Showing 5 of 5</figcaption>\n    </figure>\n</script>\n\n\n</div></body></html>"}