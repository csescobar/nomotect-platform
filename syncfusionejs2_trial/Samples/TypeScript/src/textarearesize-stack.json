{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div id=\"textarea-resize\" class=\"col-lg-8 control-section resize\">\n    <div class=\"content-wrapper\">\n        <div class=\"resize-row\">\n            <textarea id=\"resize\" rows=\"5\" cols=\"300\"></textarea>\n        </div>\n    </div>\n</div>\n\n<div class=\"col-lg-4 property-section\">\n    <table id=\"property\" title=\"Properties\" class=\"resize-property\">\n        <tbody><tr>\n            <td class=\"left-side\">Resize Mode</td>\n            <td>\n                <select id=\"select\">\n                    <option value=\"Vertical\">Vertical</option>\n                    <option value=\"Horizontal\">Horizontal</option>\n                    <option value=\"Both\">Both</option>\n                    <option value=\"None\">None</option>\n                </select>\n            </td>\n        </tr>\n    </tbody></table>\n</div>\n\n\n<style>\n    .content-wrapper div.resize-row {\n        margin: 30px 150px;\n    }\n\n    .resize-property .left-side {\n        font-size: 14px;\n        padding: 8px;\n    }\n\n    #textarea-resize .e-multi-line-input {\n        max-width: 100%;\n    }\n</style>\n</div></body></html>"}