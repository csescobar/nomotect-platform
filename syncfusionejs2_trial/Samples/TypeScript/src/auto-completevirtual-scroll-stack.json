{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"control-section col-lg-12\">\n    <div id=\"local-data\" class=\"col-lg-6\" style=\"padding-top:15px\">\n        <div class=\"content\">\n            <label class=\"h4\">Local Data</label>\n            <input type=\"text\" id=\"local\" tabindex=\"1\">\n        </div>\n    </div>\n    <div id=\"remote-data\" class=\"col-lg-6\" style=\"padding-top:15px\">\n        <div class=\"content\">\n            <label class=\"h4\">Remote Data</label>\n            <input type=\"text\" id=\"remote\" tabindex=\"1\">\n        </div>\n    </div>\n    <div id=\"group-data\" class=\"col-lg-6\" style=\"padding-top:15px\">\n        <div class=\"content\">\n            <label class=\"h4\">Grouping</label>\n            <input type=\"text\" id=\"group\" tabindex=\"1\">\n        </div>\n    </div>\n</div>\n\n\n\n\n<!-- custom code start -->\n<style>\n     .content {\n        margin: 0 auto; \n        width: 320px;\n    }\n    .content .h4 {\n        font-size: 16px;\n        margin: 0 0 10px;\n        font-weight: bold;\n    }\n</style>\n<!-- custom code end-->\n</div></body></html>"}