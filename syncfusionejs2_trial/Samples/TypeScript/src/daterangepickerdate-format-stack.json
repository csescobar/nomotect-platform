{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"col-lg-8 control-section\">\n    <div id=\"wrapper\">\n        <input id=\"daterangepicker\" type=\"text\">\n        <br>\n        <br>\n    </div>\n</div>\n\n<div class=\"col-lg-4 property-section\">\n\n    <div>\n        <input type=\"text\" id=\"dateformats\">\n    </div>\n\n</div>\n\n\n<!-- custom code start -->\n<style>\n    #wrapper {\n        max-width: 352px;\n        margin: 30px auto;\n        padding-top: 50px;\n    }\n\n    .property-section {\n        top: 55px;\n        width: 200px;\n        margin-left: 80px;\n    }\n</style>\n<!-- custom code end-->\n</div></body></html>"}