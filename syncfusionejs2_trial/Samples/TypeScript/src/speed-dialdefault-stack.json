{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"control-section\">\n    <div id=\"speed-dial-wrapper\">\n        <div id=\"target\" class=\"speeddial-default-target custom-index\">\n            <button id=\"btn1\" title=\"Menu\"></button>\n        </div>\n    </div>\n</div>\n\n\n\n<style>\n    .speeddial-default-target {\n        min-height: 300px;\n        position: relative;\n        margin-bottom: 35px;\n    }\n\n    .custom-index {\n        z-index:500 !important;\n    }\n</style>\n</div></body></html>"}