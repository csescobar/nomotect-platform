{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"control-section\">\n    <div class=\"control-wrapper\">\n        <div id=\"content\">\n            <div class=\"control-styles\">\n                <label class=\"h4\"> Default Mode</label>\n                <select id=\"default\"> \n                <option value=\"Game1\">American Football</option>\n                <option value=\"Game2\">Badminton</option>\n                <option value=\"Game3\">Basketball</option>\n                <option value=\"Game4\">Cricket</option>\n                <option value=\"Game5\">Football</option>\n                <option value=\"Game6\">Golf</option>\n                <option value=\"Game7\">Hockey</option>\n                <option value=\"Game8\">Rugby</option>\n                <option value=\"Game9\">Snooker</option>\n                <option value=\"Game10\">Tennis</option>\n            </select>\n            </div>\n            <div class=\"control-styles\">\n                <label class=\"h4\">Box Mode</label>\n                <select id=\"box\"> \n                <option value=\"Game1\">American Football</option>\n                <option value=\"Game2\">Badminton</option>\n                <option value=\"Game3\">Basketball</option>\n                <option value=\"Game4\">Cricket</option>\n                <option value=\"Game5\">Football</option>\n                <option value=\"Game6\">Golf</option>\n                <option value=\"Game7\">Hockey</option>\n                <option value=\"Game8\">Rugby</option>\n                <option value=\"Game9\">Snooker</option>\n                <option value=\"Game10\">Tennis</option>\n            </select>\n\n            </div>\n\n            <div class=\"control-styles\">\n                <label class=\"h4\">Delimiter Mode</label>\n                <select id=\"delimiter\"> \n                <option value=\"Game1\">American Football</option>\n                <option value=\"Game2\">Badminton</option>\n                <option value=\"Game3\">Basketball</option>\n                <option value=\"Game4\">Cricket</option>\n                <option value=\"Game5\">Football</option>\n                <option value=\"Game6\">Golf</option>\n                <option value=\"Game7\">Hockey</option>\n                <option value=\"Game8\">Rugby</option>\n                <option value=\"Game9\">Snooker</option>\n                <option value=\"Game10\">Tennis</option>\n            </select>\n\n            </div>\n        </div>\n    </div>\n</div>\n\n\n\n\n<!-- custom code start -->\n\n<style>\n    .control-section .control-wrapper {\n        width: 80%;\n        margin: 0 auto;\n        min-width: 185px;\n    }\n    .control-styles .h4 {\n        font-size: 16px;\n        margin: 0 0 10px;\n        font-weight: bold;\n    }\n   .e-bigger .control-section .control-wrapper {\n        width: 100%;\n    }\n    .control-styles {\n        padding-top: 30px\n    }\n</style>\n<!-- custom code end-->\n</div></body></html>"}