{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"control-section\">\n    <div class=\"content-wrapper\">\n        <div id=\"Schedule\">\n        </div>\n    </div>\n</div>\n\n\n\n\n\n<style>\n    .e-schedule .e-month-view .e-work-cells {\n        position: relative;\n    }\n\n    .e-schedule .templatewrap {\n        text-align: center;\n        position: absolute;\n        width: 100%;\n    }\n\n    .e-schedule .templatewrap img {\n        width: 30px;\n        height: 30px;\n    }\n\n    .e-schedule .caption {\n        overflow: hidden;\n        text-overflow: ellipsis;\n        vertical-align: middle;\n    }\n</style>\n</div></body></html>"}