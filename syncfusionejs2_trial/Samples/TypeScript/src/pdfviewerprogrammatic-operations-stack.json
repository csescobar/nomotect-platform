{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div>\n    <div class=\"col-lg-9 control-section pdfviewer-control-section\"> \n        <div class=\"content-wrapper\">\n            <div class=\"flex-container\">\n                <label class=\"switchLabel\" for=\"checked\">Standalone PDF Viewer</label>\n                <div class=\"e-message render-mode-info\">\n                    <span class=\"e-msg-icon render-mode-info-icon\" title=\"Turn OFF to render the PDF Viewer as server-backed\"></span>\n                </div>\n                <div><input cssclass=\"buttonSwitch\" id=\"checked\" change=\"change\" type=\"checkbox\"></div>\n            </div>\n            <div id=\"pdfViewer\" style=\"height:640px; width:100%; display: block;\"></div>\n        </div>\n    </div>\n    <div class=\"col-lg-3 pv-property-section main-panel d-block\">\n        <div class=\"property-panel-header header-panel sb-content-tab-header\" id=\"pv-property-header\">\n            Properties\n            <button class=\"e-btn e-lib e-flat e-icon-btn\" id=\"resetbutton\" click=\"resetAnnotationProperties()\">\n                <span class=\"e-icons e-refresh e-btn-icon\"></span>\n            </button>\n        </div>\n        <!-- property panel staring here -->\n        <div class=\"pv-property-panel-content\">\n            <div class=\"pdfviewer-text-content\"><span>Annotation Type</span></div>\n            <div class=\"input-item\">\n                <select id=\"annotationsList\">\n                    <option value=\"Highlight\">Highlight</option>\n                    <option value=\"Underline\">Underline</option>\n                    <option value=\"Strikethrough\">Strikethrough</option>\n                    <option value=\"Line\">Line</option>\n                    <option value=\"Arrow\">Arrow</option>\n                    <option value=\"Rectangle\">Rectangle</option>\n                    <option value=\"Circle\">Circle</option>\n                    <option value=\"Polygon\">Polygon</option>\n                    <option value=\"Distance\">Distance</option>\n                    <option value=\"Perimeter\">Perimeter</option>\n                    <option value=\"Area\">Area</option>\n                    <option value=\"Radius\">Radius</option>\n                    <option value=\"Volume\">Volume</option>\n                    <option value=\"StickyNotes\">Sticky Notes</option>\n                    <option value=\"Ink\">Ink</option>\n                    <option value=\"Stamp\">Stamp</option>\n                    <option value=\"CustomStamp\">Custom Stamp</option>\n                    <option value=\"FreeText\">Free Text</option>\n                </select>\n            </div>\n            <!-- this is for selection of stamp type annotatoion -->\n            <div class=\"inner-container\" id=\"stampClickedIStrue\" style=\"display: none;\">\n                <div class=\"pdfviewer-input-title\" style=\"margin-top: 0%;\"><span>Stamp Type</span></div>\n                <div class=\"input-item\">\n                    <select id=\"stampTypeList\">\n                        <option value=\"Dynamic\">Dynamic</option>\n                        <option value=\"SignHere\">Sign Here</option>\n                        <option value=\"StandardBusiness\">Standard Business</option>\n                    </select>\n                </div>\n                <div class=\"input-title\">\n                    <div class=\"pdfviewer-input-title\"><span>Comments</span></div>\n                    <div class=\"input-item\" id=\"dynamicstampListElement\" style=\"display: none;\">\n                        <select id=\"dynamicstampList\">\n                            <option value=\"Approved\">Approved</option>\n                            <option value=\"Confidential\">Confidential</option>\n                            <option value=\"NotApproved\">Not Approved</option>\n                            <option value=\"Received\">Received</option>\n                            <option value=\"Reviewed\">Reviewed</option>\n                            <option value=\"Revised\">Revised</option>\n                        </select>\n                    </div>\n                    <div class=\"input-item\" id=\"signHerestampListElement\" style=\"display: none;\">\n                        <select id=\"signHerestampList\">\n                            <option value=\"Accepted\">Accepted</option>\n                            <option value=\"InitialHere\">Initial Here</option>\n                            <option value=\"Rejected\">Rejected</option>\n                            <option value=\"SignHere\">Sign Here</option>\n                            <option value=\"Witness\">Witness</option>\n                        </select>\n                    </div>\n                    <div class=\"input-item\" id=\"standardBussinessStampListElement\" style=\"display: none;\">\n                        <select id=\"standardBussinessStampList\">\n                            <option value=\"Approved\">Approved</option>\n                            <option value=\"NotApproved\">Not Approved</option>\n                            <option value=\"Completed\">Completed</option>\n                            <option value=\"Confidential\">Confidential</option>\n                            <option value=\"Draft\">Draft</option>\n                            <option value=\"ForPublicRelease\">For Public Release</option>\n                            <option value=\"InformationOnly\">Information Only</option>\n                            <option value=\"NotForPublicRelease\">Not For Public Release</option>\n                            <option value=\"PreliminaryResults\">Preliminary Results</option>\n                            <option value=\"Void\">Void</option>\n                            <option value=\"ForComment\">For Comment</option>\n                        </select>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- ends here -->\n        <!-- uploader need to here -->\n        <div class=\"pdfviewer-input-title\" id=\"fileUploaderIsTrue\" style=\"display: none;\">\n            <div class=\"control_wrapper\">\n                <!-- Initialize Uploader -->\n                <div id=\"dropArea\" style=\"height: auto; overflow: auto\">\n                    <input type=\"file\" name=\"Browser\" id=\"fileupload\">\n                    <span id=\"drop\"> </span>\n                </div>\n            </div>\n        </div>\n        <!--  -->\n        <div class=\"pdfviewer-input-title\"><span>Page Number</span></div>\n        <div class=\"input-item\">\n            <input id=\"pageNumber\" type=\"text\">\n        </div>\n        <!--  -->\n        <div class=\"pdfviewer-input-title\"><span>Settings:</span></div>\n        <div class=\"inner-container\" style=\"padding: 0 0 12px 0px;\">\n            <table class=\"inner-table setting-table\">\n                <tbody><tr id=\"XYRowIstrue\" class=\"table-row\">\n                    <td class=\"left-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>X Position</span>\n                            <div class=\"input-item\">\n                                <input id=\"Xposition\" type=\"text\">\n                            </div>\n                        </div>\n                    </td>\n                    <td class=\"right-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>Y Position</span>\n                            <div class=\"input-item\">\n                                <input id=\"Yposition\" type=\"text\">\n                            </div>\n                        </div>\n                    </td>\n                </tr>\n                <tr id=\"heightwidthrowIstrue\" class=\"table-row\">\n                    <td class=\"left-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>Width</span>\n                            <div class=\"input-item\">\n                                <input id=\"width\" type=\"text\">\n                            </div>\n                        </div>\n                    </td>\n                    <td class=\"right-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>Height</span>\n                            <div class=\"input-item\">\n                                <input id=\"height\" type=\"text\">\n                            </div>\n                        </div>\n                    </td>\n                </tr>\n                <tr id=\"X1Y1RowIstrue\" style=\"display: none;\" class=\"table-row\">\n                    <td class=\"left-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>X1 Position</span>\n                            <div class=\"input-item\">\n                                <input id=\"X1position\" type=\"text\">\n                            </div>\n                        </div>\n                    </td>\n                    <td class=\"right-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>Y1 Position</span>\n                            <div class=\"input-item\">\n                                <input id=\"Y1position\" type=\"text\">\n                            </div>\n                        </div>\n                    </td>\n                </tr>\n                <tr id=\"X2Y2RowIstrue\" style=\"display: none;\" class=\"table-row\">\n                    <td class=\"left-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>X2 Position</span>\n                            <div class=\"input-item\">\n                                <input id=\"X2position\" type=\"text\">\n                            </div>\n                        </div>\n                    </td>\n                    <td class=\"right-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>Y2 Position</span>\n                            <div class=\"input-item\">\n                                <input id=\"Y2position\" type=\"text\">\n                            </div>\n                        </div>\n                    </td>\n                </tr>\n                <tr style=\"display: flex;\">\n                    <td class=\"left-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>Shape Opacity</span>\n                            <div class=\"input-item\">\n                                <input id=\"shapeOpacity\" type=\"text\">\n                            </div>\n                        </div>\n                    </td>\n                    <td class=\"right-item\" id=\"colorFillerIstrue\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>Fill Color</span>\n                            <div class=\"input-item\">\n                                <input id=\"fillColorinput\" type=\"color\">\n                            </div>\n\n                        </div>\n                    </td>\n                </tr>\n                <tr id=\"strokethickenssIstrue\" class=\"table-row\">\n                    <td class=\"left-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>Stroke Thickness</span>\n                            <div class=\"input-item\">\n                                <input id=\"strokeThickenss\" type=\"text\">\n                            </div>\n                        </div>\n                    </td>\n                    <td class=\"right-item\">\n                        <div class=\"pdfviewer-text-content\">\n                            <span>Stroke Color</span>\n                            <div class=\"input-item\">\n                                <input id=\"strokeColorinput\" type=\"color\">\n                            </div>\n                        </div>\n                    </td>\n                </tr>\n            </tbody></table>\n\n            <div style=\"padding: 12px 12px 0 12px;\">\n                <!-- Table to display the bounds -->\n                <table id=\"pdfViewer-coordinate-table\" style=\"width: 100%; display: none; border-collapse: collapse; \">\n                    <!-- Table rows will be dynamically added here -->\n                </table>\n            </div>\n\n            <!-- Section for the buttons -->\n            <div id=\"deladdboundsButtonsIstrue\" style=\"display: none;\">\n                <div class=\"button-section\" style=\"padding: 12px 12px 0px 0; border: 0px;\">\n                    <button id=\"deletebutton\">Delete</button>\n                    <button id=\"addboundsbutton\">Add Bounds</button>\n                </div>\n            </div>\n            <div style=\"padding: 0px 12px 12px 12px; display: none;\" id=\"lineIstrue\">\n                <div class=\"pdfviewer-input-title\"><span>Line Head Start</span></div>\n                <div class=\"input-item\">\n                    <select id=\"lineHeadStartList\">\n                        <option value=\"None\">None</option>\n                        <option value=\"Arrow\">Closed Arrow</option>\n                        <option value=\"OpenArrow\">Open Arrow</option>\n                        <option value=\"Square\">Square</option>\n                        <option value=\"Diamond\">Diamond</option>\n                        <option value=\"Circle\">Round</option>\n                    </select>\n\n                </div>\n\n                <div class=\"pdfviewer-input-title\"><span>Line Head End</span></div>\n                <div class=\"input-item\">\n                    <select id=\"lineHeadEndList\">\n                        <option value=\"None\">None</option>\n                        <option value=\"Arrow\">Closed Arrow</option>\n                        <option value=\"OpenArrow\">Open Arrow</option>\n                        <option value=\"Square\">Square</option>\n                        <option value=\"Diamond\">Diamond</option>\n                        <option value=\"Circle\">Round</option>\n                    </select>\n                </div>\n                <div class=\"pdfviewer-input-title\" id=\"distanceIstrue\">\n                    <span>Leader Length</span>\n                    <div class=\"input-item\">\n                        <input id=\"leaderLength\" type=\"text\">\n                    </div>\n                </div>\n            </div>\n            <!--  -->\n            <!--  -->\n            <div style=\"padding: 12px 12px 0 12px;\">\n                <table id=\"pdfViewer-coordinate-table\" style=\"width: 100%; display: none; border-collapse: collapse; \">\n\n                </table>\n            </div>\n            <div id=\"polygonIstrue\" style=\"display: none;\">\n                <div class=\"button-section\" style=\"padding: 12px 12px 0px 0; border: 0px; \">\n                    <button id=\"vertexdelete\">Delete</button>\n                    <button id=\"addVertexButton\">Add Vertex</button>\n                </div>\n            </div>\n            <!--  -->\n        </div>\n        <!-- ink doprdown -->\n        <div style=\"padding: 0 0 0px 0px; display: none;\" id=\"inkAnnoatationIstrue\">\n            <div class=\"pdfviewer-input-title\"><span>Ink Annotation</span></div>\n            <div class=\"input-item\">\n                <select id=\"inkAnnoatationList\">\n                    <option value=\"Syncfusion\">Syncfusion</option>\n                    <option value=\"PdfViewer\">PdfViewer</option>\n                    <option value=\"Star\">Star</option>\n                </select>\n            </div>\n        </div>\n        <!-- strt -->\n        <div class=\"pdfviewer-input-title\" id=\"freeTextIstrue\" style=\"display: none;\"><span>Text Properties:</span>\n        </div>\n        <div class=\"inner-container\" id=\"innerfreeTextIstrue\" style=\"display: none;\">\n            <div class=\"pdfviewer-text-content\" style=\"margin-top: 0%;\"><span>Default Text</span></div>\n            <div class=\"input-item\">\n                <input id=\"defaultText\" type=\"text\">\n            </div>\n            <div class=\"pdfviewer-input-title\"><span>Font Family</span></div>\n            <div class=\"input-item\">\n                <select id=\"fontFamilyList\">\n                    <option value=\"Helvetica\">Helvetica</option>\n                    <option value=\"Courier\">Courier</option>\n                    <option value=\"Symbol\">Symbol</option>\n                    <option value=\"TimesNewRoman\">Times New Roman</option>\n                </select>\n\n            </div>\n            <div class=\"pdfviewer-input-title\"><span>Alignment</span></div>\n            <div class=\"input-item\">\n                <select id=\"textAlignmentList\">\n                    <option value=\"Center\">Center</option>\n                    <option value=\"Right\">Right</option>\n                    <option value=\"Left\">Left</option>\n                    <option value=\"Justify\">Justify</option>\n                </select>\n            </div>\n            <div class=\"pdfviewer-input-title\"><span>Font Style</span></div>\n            <div class=\"input-item\">\n                <select id=\"fontStyleList\">\n                    <option value=\"None\">None</option>\n                    <option value=\"Bold\">Bold</option>\n                    <option value=\"Underline\">Underline</option>\n                    <option value=\"Italic\">Italic</option>\n                    <option value=\"Strikethrough\">Strikethrough</option>\n                </select>\n            </div>\n            <div class=\"pdfviewer-input-title\">\n                <table class=\"inner-table\">\n                    <tbody><tr>\n                        <td style=\"width:50%;padding:0;\">\n                            <span>Font Size</span>\n                            <div class=\"input-item\">\n                                <input id=\"fontSize\" type=\"text\">\n                            </div>\n                        </td>\n                        <td style=\"padding:0;\">\n                            <div style=\"margin-left: 12px;\" class=\"text-content\">\n                                <span>Font Color</span>\n                                <div class=\"input-item\">\n                                    <input id=\"fontColorInput\" type=\"color\">\n                                </div>\n                            </div>\n                        </td>\n                    </tr>\n                </tbody></table>\n            </div>\n        </div>\n\n        <!-- end -->\n        <!-- sytrta0 -->\n        <div class=\"pdfviewer-input-title\">\n            <table>\n                <tbody><tr>\n                    <td class=\"check-box-row\"><input type=\"checkbox\" id=\"PrintAnnotation-isTrueCheckbox\"></td>\n                    <td class=\"check-box-row\"><span>Print Annotation</span></td>\n                </tr>\n                <tr>\n                    <td class=\"check-box-row\"><input type=\"checkbox\" id=\"LockAnnotation-isTrueCheckbox\"></td>\n                    <td class=\"check-box-row\"><span>Lock Annotation</span></td>\n                </tr>\n            </tbody></table>\n        </div>\n        <!-- end -->\n\n        <!-- strt -->\n        <div id=\"allowinstractionsIstrue\" style=\"display: none;\">\n            <div class=\"pdfviewer-input-title pdfviewer-text-content\"><span>Allow Interactions</span></div>\n            <div class=\"input-item\">\n                <input type=\"checkbox\" id=\"interactionDropdownTree\">\n            </div>\n        </div>\n        <!--  -->\n        <!-- strat -->\n        <div class=\"pdfviewer-input-title\"><span>Add Comments</span></div>\n        <div class=\"pdfviewer-input-title\"><span>Author</span></div>\n        <div class=\"input-item\">\n            <input id=\"authorName\" type=\"text\">\n        </div>\n        <div class=\"pdfviewer-input-title\"><span>Content</span></div>\n        <div class=\"input-item\">\n            <input id=\"comment\" type=\"text\">\n        </div>\n        <div class=\"pdfviewer-input-title\"><span>Status</span></div>\n        <div class=\"input-item\">\n            <select id=\"status\">\n                <option value=\"None\">None</option>\n                <option value=\"Accepted\">Accepted</option>\n                <option value=\"Cancelled\">Cancelled</option>\n                <option value=\"Completed\">Completed</option>\n                <option value=\"Rejected\">Rejected</option>\n            </select>\n        </div>\n        <div class=\"pdfviewer-input-title\">\n            <table>\n                <tbody><tr>\n                    <td class=\"check-box-row\">\n                        <input type=\"checkbox\" id=\"replyCheckbox-isTrue\">\n                    </td>\n                    <td class=\"check-box-row\"><span>Reply</span></td>\n                </tr>\n            </tbody></table>\n        </div>\n\n        <div>\n            <div class=\"pdfviewer-input-title\" id=\"repliesList\" hidden=\"\"></div>\n            <div class=\"inner-container replies\" id=\"repliesContainer\">\n            </div>\n            <div class=\"contextmenu-control\">\n                <div id=\"contextMenutarget\"></div>\n                <ul id=\"contextmenu\"></ul>\n            </div>\n        </div>\n\n        <div class=\"inner-container pdfViewer-checked-Content\" style=\"padding: 10px; display: none;\" id=\"ischeckedReplybox\">\n            <div class=\"pdfviewer-input-title\"><span>Author</span></div>\n            <div class=\"input-item\">\n                <input id=\"replyAuthorName\" type=\"text\">\n            </div>\n            <div class=\"pdfviewer-input-title\"><span>Content</span></div>\n            <div class=\"input-item\">\n                <input id=\"replyComment\" type=\"text\">\n            </div>\n            <div class=\"pdfviewer-input-title\"><span>Status</span></div>\n            <div class=\"input-item\">\n                <select id=\"replyStatus\">\n                    <option value=\"None\">None</option>\n                    <option value=\"Accepted\">Accepted</option>\n                    <option value=\"Cancelled\">Cancelled</option>\n                    <option value=\"Completed\">Completed</option>\n                    <option value=\"Rejected\">Rejected</option>\n                </select>\n            </div>\n            <div class=\"button-section\" style=\"padding: 12px 12px 0px 0px; border: 0px;\">\n                <button id=\"addreplyButton\">Add Reply</button>\n                <button id=\"updateReplyButton\" style=\"display: none;\">Update Reply</button>\n            </div>\n        </div>\n        <div class=\"property-panel-footer sb-content-tab-header\" style=\"border-bottom: none;\" id=\"pv-property-footer\">\n            <div class=\"button-section\">\n                <button id=\"updateannotationButton\">Update</button>\n                <button id=\"addAnnotationButton\">Add Annotation</button>\n            </div>\n        </div>\n        <!-- end -->\n\n\n    </div>\n    <!-- property panel ending here -->\n</div>\n<!-- col-3 ends here -->\n</div>\n\n\n<style>\n    .flex-container {\n        display: flex;\n        justify-content: flex-end;\n    }\n\n    .render-mode-info {\n        background: none;\n        border: none;\n        padding-left: 0px;\n    }\n\n    .render-mode-info .render-mode-info-icon {\n        height: 16px;\n        width: 16px;\n    }\n\n    .switchLabel {\n        font-family: \"Segoe UI\", \"GeezaPro\", \"DejaVu Serif\", sans-serif;\n        font-weight: 400;\n        line-height: 20px;\n        letter-spacing: 0.24px;\n        text-align: right;\n        font-size: 14px;\n    }\n\n    .render-mode-info .render-mode-info-icon::before {\n        line-height: 0.5rem;\n    }\n\n    .buttonSwitch {\n        Width: 40px;\n        Height: 24px;\n    }\n\n\n    .header-panel {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        position: sticky;\n        top: 0px;\n        z-index: 2;\n        background-color: white;\n        border-bottom: 1px solid #D7D7D7;\n        padding-bottom: 5px;\n        margin-bottom: 16px;\n    }\n\n    .inner-table td {\n        text-wrap: nowrap;\n        padding: 12px 12px 0 12px;\n        width: 50%;\n    }\n\n    .main-panel {\n        border-left: 1px solid #D7D7D7;\n        height: 700px;\n        overflow-y: scroll;\n        padding-bottom: 0px;\n\n    }\n\n    .control_wrapper {\n        max-width: 505px;\n        margin: auto;\n    }\n\n    #uploadicon {\n        cursor: pointer;\n        top: 5px;\n        left: 20px;\n        position: relative;\n    }\n\n    .e-file-select-wrap {\n        display: inline-block;\n    }\n\n    .e-upload {\n        border: none;\n        margin-top: 10px;\n        width: 100%;\n    }\n\n    #drop {\n        font-size: 14px;\n    }\n\n    .e-bigger #drop {\n        font-size: 15px;\n    }\n\n    #dropArea {\n        border: 1px dashed #c3c3cc;\n        position: relative;\n        text-align: center;\n\n    }\n\n    #dropArea .e-upload .e-upload-files {\n        text-align: initial;\n        border-top: none;\n    }\n\n    .e-upload .e-file-select-wrap .e-file-select,\n    .e-upload .e-file-select-wrap .e-file-select .e-uploader {\n        display: inline-block;\n        width: 0;\n    }\n\n    .input-item {\n        margin-top: 0px;\n    }\n\n    .inner-container {\n        margin-top: 15px;\n        border: 1px solid rgba(196, 199, 197, 1);\n        padding: 12px;\n    }\n\n    .inner-table {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n    }\n\n    #pdfViewer-coordinate-table {\n        border-spacing: 0px;\n        border-collapse: collapse;\n        width: 100%;\n    }\n\n    #pdfViewer-coordinate-table td {\n        border-top: 1px solid rgba(196, 199, 197, 1);\n        border-left: 1px solid rgba(196, 199, 197, 1);\n        border-right: 1px solid rgba(196, 199, 197, 1);\n        border-bottom: 1px solid rgba(196, 199, 197, 1);\n        padding: 5px;\n        font-size: 10px;\n        text-align: center;\n        width: 200px;\n    }\n\n    .property-panel-footer {\n        padding: 10px 0px 16px 0px;\n        position: sticky;\n        bottom: 0;\n        background-color: white;\n        z-index: 1;\n        border-top: 1px solid #D7D7D7;\n        margin-top: 16px;\n    }\n\n    .e-pv-table-items {\n        display: flex;\n        justify-content: space-evenly;\n        flex-wrap: wrap;\n        gap: 2px;\n    }\n\n    .button-section {\n        text-align: center;\n        display: flex;\n        justify-content: end;\n        gap: 12px;\n        margin-top: 5px;\n    }\n\n    .button-section button {\n        font-size: 12px;\n        padding: 8.2px 16px;\n    }\n\n    .pdfviewer-input-title .check-box-row {\n        padding: 5px;\n    }\n\n    .fileuploader {\n        margin-top: 5px;\n\n    }\n\n    .table-items {\n        display: flex;\n        justify-content: space-evenly;\n        flex-wrap: wrap;\n        gap: 2px;\n\n    }\n\n    /* this styling iss from component.css */\n\n    .flex-container {\n        display: flex;\n        justify-content: flex-end;\n    }\n\n    .render-mode-info {\n        background: none;\n        border: none;\n        padding-left: 0px;\n    }\n\n    .render-mode-info .render-mode-info-icon {\n        height: 16px;\n        width: 16px;\n    }\n\n    .switchLabel {\n        font-family: \"Segoe UI\", \"GeezaPro\", \"DejaVu Serif\", sans-serif;\n        font-weight: 400;\n        line-height: 20px;\n        letter-spacing: 0.24px;\n        text-align: right;\n        font-size: 14px;\n    }\n\n    .render-mode-info .render-mode-info-icon::before {\n        line-height: 0.5rem;\n    }\n\n    .buttonSwitch {\n        Width: 40px;\n        Height: 24px;\n    }\n\n    .pdfviewer-property-section {\n        padding: 20px 15px;\n    }\n\n    .pdfviewer-contextmenu-checkbox-label {\n        padding: 10px;\n    }\n\n    .pdfviewer-control-section {\n        border-right: 1px solid #D7D7D7;\n    }\n\n    .pdfviewer-property-container {\n        padding-bottom: 30px;\n\n    }\n\n    .header-pdfviewer {\n        font-weight: 600;\n        padding: 20px 2px;\n    }\n\n    .pdfviewer-input-title {\n        margin-top: 12px;\n        font-size: 12px;\n    }\n\n    .pdfviewer-text-content {\n        font-size: 12px;\n    }\n\n    .pdfviewer-table-input-title {\n        margin-top: 6px;\n        font-size: 11px;\n    }\n\n\n    .reply-container {\n        display: flex;\n        align-items: center;\n        gap: 10px;\n        justify-content: space-between;\n        padding: 12px;\n    }\n\n    .replies {\n        overflow-y: scroll;\n        overflow: auto;\n        max-height: 180px;\n        padding: 0px !important;\n        overflow: auto;\n    }\n\n    .inner-container {\n        margin-top: 15px;\n        border: 1px solid rgba(196, 199, 197, 1);\n        padding: 12px;\n    }\n\n    .reply-text {\n        width: 100%;\n        font-size: 12px;\n        word-break: break-word;\n    }\n\n    .more-container {\n        width: min-content;\n    }\n\n    #contextmenutarget {\n        padding: 10px;\n        position: relative;\n        text