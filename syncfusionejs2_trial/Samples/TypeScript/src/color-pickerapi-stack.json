{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"col-lg-8 control-section\">\n    <div id=\"colorpicker-control\">\n        <h4>Choose a color</h4>\n        <input id=\"color-picker\" type=\"color\">\n    </div>\n</div>\n<div class=\"col-lg-4 property-section\">\n    <table id=\"property\" title=\"Properties\" style=\"width: 100%\">\n        <tbody>\n            <tr>\n                <td style=\"width: 50%\">\n                    <div>Value</div>\n                </td>\n                <td style=\"width: 50%\">\n                    <div style=\"max-width: 200px\">\n                        <input id=\"hex-input\" aria-label=\"Value\" type=\"text\" maxlength=\"9\" spellcheck=\"false\" value=\"#0db1e7\">\n                    </div>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 50%;padding-top:10px\">\n                    <div>Mode</div>\n                </td>\n                <td style=\"width: 50%;padding-top:10px\">\n                    <div style=\"max-width: 200px\">\n                        <select id=\"ddl\">\n                            <option value=\"Picker\">Picker</option>\n                            <option value=\"Palette\">Palette</option>\n                        </select>\n                    </div>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 50%;padding-top:15px\">\n                    <div>Disable</div>\n                </td>\n                <td style=\"width: 50%;padding-top:15px\">\n                    <input id=\"disabled\" type=\"checkbox\" aria-label=\"Disable\">\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 50%;padding-top:15px\">\n                    <div>Show Buttons</div>\n                </td>\n                <td style=\"width: 50%;padding-top:15px\">\n                    <input id=\"show-btn\" type=\"checkbox\" aria-label=\"Show Buttons\">\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 50%;padding-top:15px\">\n                    <div>Mode Switcher</div>\n                </td>\n                <td style=\"width: 50%;padding-top:15px\">\n                    <input id=\"mode-switch\" type=\"checkbox\" aria-label=\"Mode Switcher\">\n                </td>\n            </tr>\n        </tbody>\n    </table>\n</div>\n\n\n\n</div></body></html>"}