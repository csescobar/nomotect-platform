{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div id=\"htmlTemplate\" class=\"col-lg-12 control-section\">\n    <!-- Tooltip element -->\n    <div id=\"customization\">\n        <!-- ListView element -->\n        <button class=\"text\" id=\"content\">HTML Template</button>\n    </div>\n</div>\n\n\n\n\n\n<style type=\"text/css\">\n    #htmlTemplate {\n        height: 385px;\n    }\n\n    body.material3 #htmlTemplate,\n    body.material3-dark #htmlTemplate {\n        height: 450px;\n    }\n\n    #htmlTemplate #customization {\n        display: table;\n        margin: 0 auto;\n    }\n\n    .e-tooltip-template-css {\n        filter: drop-shadow(2px 5px 5px rgba(0, 0, 0, 0.25));\n    }\n\n    #democontent {\n        padding-left: 12px;\n        padding-right: 5px;\n    }\n\n    .material #democontent,\n    .bootstrap #democontent {\n        border-color: #D2D2D2;\n    }\n\n    .fabric #democontent,\n    .highcontrast #democontent {\n        border-color: #CCCCCC;\n    }\n\n    #democontent a {\n        color: #62e0f7;\n    }\n    .bootstrap4 .e-tooltip-template-css {\n\t\tfilter: none;\n\t}\n\n</style>\n</div></body></html>"}