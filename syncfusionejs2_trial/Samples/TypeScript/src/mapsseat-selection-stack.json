m/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<main>\n    \n    <div class=\"col-lg-9 control-section\">\n        <div style=\"width:200px;margin:auto;padding-bottom:20px\">\n            <img alt=\"Bus icon\" src=\"//npmci.syncfusion.com/development/demos/src/maps/images/bus-icon.png\" style=\"width:25px;height:25px;float:left\">\n            <div style=\"padding-left:30px;font-size:20px;font-weight:400; font-family: Segoe UI;\">Bus seat selection</div>\n        </div>        \n        <div style=\"border: 3px solid darkgray;width:200px;display:block;margin:auto;border-radius:5px\">\n            <img alt=\"Steering wheel icon\" src=\"//npmci.syncfusion.com/development/demos/src/maps/images/wheel.png\" style=\"width:30px;height:30px;margin-left:18%;margin-top:10px\">\n            <div id=\"maps\"></div>            \n        </div>\n    \n    </div>\n\n    <div class=\"col-lg-3 property-section\">\n        <table id=\"property\" title=\"Seat Selection\" style=\"width: 100%;font-weight:400 !important\" role=\"none\">\n            <tbody>\n                <tr style=\"height: 30px\">\n                    <td>\n                        <div style=\"height:0;width:15px;padding-bottom:5px;background-color:gray;border-radius:25%\"></div>\n\n                        <div id=\"available\" style=\"margin-top: -25px;margin-left: 15px\">Available\n                    </div></td>\n                </tr>\n                <tr style=\"height: 30px\">\n                    <td>\n                        <div style=\"height:0;width:15px;padding-bottom:5px;background-color:Green;border-radius:25%\"></div>\n\n                        <div id=\"selected\" style=\"margin-top: -25px;margin-left: 15px\">Selected\n                    </div></td>\n                </tr>\n                <tr style=\"height: 30px\">\n                    <td>\n                        <div style=\"height:0;width:15px;padding-bottom:5px;background-color:Orange;border-radius:25%\"></div>\n\n                        <div id=\"booked\" style=\"margin-top: -25px;margin-left: 15px\">Booked\n                    </div></td>\n                </tr>\n            </tbody>\n        </table>\n        </div>\n        <div id=\"seat-parent\">\n            <span id=\"clear-btn\">Clear Selection</span><br><br>\n            <div id=\"selectedseats\"></div>\n        </div>\n\t\t\n                \n        <!-- style for bus seat-->\n        <style>\n            #control-container {\n                padding: 0px !important;\n            }\n            #seat-parent {\n                text-align: center;\n                cursor: pointer\n            }\n            #selectedseats {\n                padding: 10px;                \n            }\n            #selectedseats, #seat-info {             \n                font-size: 14px;\n            }\n            #clear-btn {\n                padding: 10px;\n                border: 2px solid rgb(241, 235, 247);\n                border-radius: 8px;\n                background: rgb(246, 245, 248);\n                color: black;\n                font-size: 14px;\n            }\n            .seats {\n                padding-top: 15px;\n                font-weight: bold;                \n            }\n        </style>\n</main>\n</div></body></html>"}