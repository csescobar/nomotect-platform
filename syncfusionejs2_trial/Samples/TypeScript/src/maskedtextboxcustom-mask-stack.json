{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"col-lg-12 control-section\">\n    <div class=\"content-wrapper\">\n        <div class=\"control-label\">Time (ex: 10:00 PM, 10:00 AM)\n        </div>\n        <!-- Initialize Masked Textbox -->\n        <input id=\"mask1\" type=\"text\">\n        <div class=\"control-label\">IP Address (ex: 212.212.111.222)</div>\n        <!-- Initialize Masked Textbox -->\n        <input id=\"mask2\" type=\"text\">\n    </div>\n</div>\n\n\n<style>\n    .content-wrapper {\n        width: 30%;\n        margin: 0 auto;\n        min-width: 185px;\n    }\n    \n    .control-label {\n        padding: 24px 0px 10px 0px;\n        font-size: 12px;\n    }\n</style>\n</div></body></html>"}