{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"control-section\">\n    <div id=\"default-rating-control\">\n        <div class=\"rating-content\">\n            <label>Basic</label><br>\n            <input id=\"rating1\">\n        </div>\n        <div class=\"rating-content\">\n            <label>Reset</label><br>\n            <input id=\"rating2\">\n        </div>\n        <div class=\"rating-content\">\n            <label>Single selection</label><br>\n            <input id=\"rating3\">\n        </div>\n        <div class=\"rating-content\">\n            <label>ReadOnly</label><br>\n            <input id=\"rating4\">\n        </div>\n        <div class=\"rating-content\">\n            <label>Disabled</label><br>\n            <input id=\"rating5\">\n        </div>\n        <div class=\"rating-content\">\n            <label>Item count</label><br>\n            <input id=\"rating6\">\n        </div>\n    </div>\n</div>\n\n\n<style>\n    #default-rating-control .rating-content {\n        width: 240px;\n        margin: 15px 0;\n        min-height: 75px;\n        padding:0;\n        text-align: center;\n    }\n    .e-bigger #default-rating-control .rating-content {\n        width: 330px;\n        margin: 15px 0;\n        min-height: 75px;\n        padding:0;\n        text-align: center;\n    }\n    #default-rating-control {\n        margin: 6% auto;\n        max-width: 800px;\n        display: flex;\n        flex-wrap: wrap;\n        justify-content: center;\n    }\n    .fluent2-dark #default-rating-control {\n        background-color: #1f1f1f;\n        color: #fff\n    }\n    .fluent2-highcontrast #default-rating-control {\n        background-color: #1C1B1F;\n        color: #fff\n    }\n</style>\n</div></body></html>"}