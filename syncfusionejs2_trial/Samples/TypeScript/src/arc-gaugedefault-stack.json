{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<main>\n    <div class=\"control-section\">\n        <div id=\"gauge\" align=\"center\"></div>\n    </div>\n    \n    \n    <style>\n        .titleText {\n            font-size: 22px;\n            margin-top: 8px;\n        }\n\n        .e-view.material3 div.titleText,\n        .e-view.material3-dark div.titleText {\n            margin-top: 10px;\n        }\n\n        .e-view.tailwind3 div.titleText,\n        .e-view.tailwind3-dark div.titleText {\n            margin-top: -1px;\n        }\n    \n        .annotation {\n            font-size: 18px;\n        }\n    \n        @media screen and (max-width: 420px) {\n            .titleText {\n                font-size: 15px;\n            }\n    \n            .annotation {\n                font-size: 13px;\n            }\n        }\n    </style>\n</main>\n</div></body></html>"}