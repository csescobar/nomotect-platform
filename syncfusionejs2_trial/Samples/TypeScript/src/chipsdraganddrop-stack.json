{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"control-section\">\n    <div id=\"chip-draganddrop-wrapper\">\n        <div class=\"chips-headers\">Customize your order with add-ons</div>\n\n        <div class=\"sample-padding\">\n            <div id=\"choice-container\" aria-label=\"choice-chips\"></div>\n            <div id=\"selection-container\" aria-label=\"selection-chips\"></div>\n        </div>\n    </div>\n</div>\n\n\n<style>\n    #chip-draganddrop-wrapper .sample-padding {\n        padding: 10px;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n    }\n\n    .chips-headers {\n        font-size: 12px;\n        text-align: center;\n        padding-top: 10px;\n    }\n\n    #choice-container {\n        width: 400px;\n        min-height: 100px;\n        min-width: 150px;\n        border: 2px solid #2C3E50;\n        border-radius: 10px;\n        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n        margin-right: 30px;\n    }\n\n    #selection-container {\n        width: 400px;\n        min-height: 100px;\n        min-width: 150px;\n        border: 2px solid #8E44AD;\n        border-radius: 10px;\n        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n    }\n</style>\n\n</div></body></html>"}