{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"col-lg-8 control-section\">\n    <div class=\"control-wrapper\">\n        <div style=\"padding-top:70px;\">\n            <select id=\"games\"> \n                <option value=\"Game1\">American Football</option>\n                <option value=\"Game2\">Badminton</option>\n                <option value=\"Game3\">Basketball</option>\n                <option value=\"Game4\">Cricket</option>\n                <option value=\"Game5\">Football</option>\n                <option value=\"Game6\">Golf</option>\n                <option value=\"Game7\">Hockey</option>\n                <option value=\"Game8\">Rugby</option>\n                <option value=\"Game9\">Snooker</option>\n                <option value=\"Game10\">Tennis</option>\n            </select>\n        </div>\n    </div>\n</div>\n<div class=\"col-lg-4 property-section\">\n    <table id=\"property\" title=\"Properties\" style=\"width: 100%; margin:10px\">\n        <tbody><tr>\n            <td class=\"left-side\">Value</td>\n            <td>:<span id=\"value\" class=\"right-side\"></span></td>\n        </tr>\n        <tr>\n            <td class=\"left-side\">Text</td>\n            <td>:<span id=\"text\" class=\"right-side\"></span></td>\n        </tr>\n    </tbody></table>\n</div>\n\n\n\n\n<!-- custom code start -->\n<style>\n    .control-wrapper {\n        margin: 0 auto;\n        width: 250px;\n    }\n\n    .property-section .right-side {\n        padding-left: 10px;\n    }\n\n    .property-section .left-side {\n        padding: 5px;\n        width: 25%\n    }\n</style>\n<!-- custom code end-->\n</div></body></html>"}