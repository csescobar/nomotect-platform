{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n﻿<div class=\"col-lg-12 control-section toast-action-center-section\">\n    <div class=\"layoutWrapper\">\n        <div class=\"speaker\">\n            <div class=\"camera\"></div>\n        </div>\n        <div class=\"layout\">\n            <div id=\"list-container\">\n                <div class=\"notification_panel\">\n                    <div id=\"action_notify\" style=\"display: none\">\n                        <div id=\"action_panel\">\n                            <div id=\"clearAll\"> Clear all\n                                <span class=\"e-cancel e-icons\"></span>\n                            </div>\n                            <div id=\"collapseAll\">\n                                Collapse all\n                                <span class=\"e-toast-collapse e-icons\"></span>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"toast_action_center_target\"></div>\n                    <div id=\"toast_action_center\"></div>\n                    <div class=\"device_notification\">\n                        <div class=\"notify_intication\">\n                            <div class=\"intication\"></div>\n                            <div class=\"intication\"></div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"swipe_division\">\n                    <div id=\"swipe_indicator\">\n                        <div class=\"swipe_dir\">\n                            Swipe Down\n                        </div>\n                        <span class=\"e-icons e-swipe-down\"></span>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"outerButton\"> </div>\n    </div>\n    <div id=\"toast_message_template\" style=\"display: none\">\n        <div class=\"horizontal-align\">\n            <div class=\"e-icons e-laura\"></div>\n            <div class=\"toast-content\">\n                <div class=\"toast-title\">\n                    Marc Durand\n                </div>\n                <div class=\"toast-message\">Can we move our meeting to 4 PM? </div>\n            </div>\n            <div class=\"toast-date\">\n                <div> 1:21 PM</div>\n            </div>\n        </div>\n    </div>\n    <div id=\"toast_message_template2\" style=\"display: none\">\n        <div class=\"horizontal-align\">\n            <div class=\"e-icons e-janat\"></div>\n            <div class=\"toast-content\">\n                <div class=\"toast-title\">\n                    Brittany Kirby\n                </div>\n                <div class=\"toast-message\">I taught Duke how to play fetch yesterday! </div>\n            </div>\n            <div class=\"toast-date\">\n                <div> 4:40 PM</div>\n            </div>\n        </div>\n    </div>\n    <div id=\"toast_message_template3\" style=\"display: none\">\n        <div class=\"horizontal-align\">\n            <div class=\"e-icons e-michael\"></div>\n            <div class=\"toast-content\">\n                <div class=\"toast-title\">\n                    Andrew Fuller\n                </div>\n                <div class=\"toast-message\">Have you watched latest hollywood movies? </div>\n            </div>\n            <div class=\"toast-date\">\n                <div> 6:30 PM</div>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n\n<style>\n    .toast-action-center-section #swipe_indicator {\n        display: inline-block;\n        padding: 7px;\n        font-size: 16px;\n    }\n\n    .toast-action-center-section .swipe_division {\n        text-align: center;\n    }\n\n    .toast-action-center-section #swipe_indicator .e-swipe-down::before {\n        content: \"\\e239\";\n    }\n\n    .toast-action-center-section .e-laura,\n    .toast-action-center-section .e-janat,\n    .toast-action-center-section .e-michael {\n        border-radius: 50%;\n        background-repeat: no-repeat;\n        background-size: cover;\n        height: 29px !important;\n        width: 40px !important;\n        margin-right: 5px;\n        position: absolute;\n        left: 0;\n    }\n\n    .toast-action-center-section .e-laura {\n        background-image: url('//npmci.syncfusion.com/development/demos/src/toast/resource/laura.png');\n    }\n\n    .toast-action-center-section .e-janat {\n        background-image: url('//npmci.syncfusion.com/development/demos/src/toast/resource/janat.png');\n    }\n\n    .toast-action-center-section .e-michael {\n        background-image: url('//npmci.syncfusion.com/development/demos/src/toast/resource/michael.png');\n    }\n\n    .toast-action-center-section .layoutWrapper.e-device-layout {\n        visibility: visible;\n    }\n\n    .toast-action-center-section .e-visbile-layer {\n        visibility: visible;\n    }\n\n    .toast-action-center-section .horizontal-align {\n        display: inline-block;\n        flex-direction: row;\n        padding: 0 40px;\n    }\n\n    .toast-action-center-section #toast_message_template,\n    .toast-action-center-section #toast_message_template2,\n    .toast-action-center-section #toast_message_template3 {\n        font-size: 11px;\n    }\n\n    .toast-action-center-section .e-input-arrow::before {\n        content: \"\\e301\";\n        font-size: 15px;\n    }\n\n    .toast-action-center-section #collapseAll {\n        height: 20px;\n        cursor: pointer;\n        display: inline-block;\n        position: absolute;\n        right: 10px;\n    }\n\n    .toast-action-center-section #clearAll {\n        height: 20px;\n        cursor: pointer;\n        display: inline-block;\n    }\n\n    .toast-action-center-section #action_notify {\n        height: 30px;\n    }\n\n    .toast-action-center-section #action_panel {\n        display: inline-flex;\n        align-items: center;\n        width: 100%;\n        height: inherit;\n        padding: 0 10px;\n    }\n\n    .toast-action-center-section .toast-date {\n        font-size: 11px;\n        width: 50px;\n        position: relative;\n        position: absolute;\n        min-height: 45px;\n        right: 0;\n        top: 2px;\n    }\n\n\n    .toast-action-center-section .toast-date>div {\n        margin-left: 5px;\n        font-size: 10px;\n        white-space: nowrap;\n    }\n\n    .toast-action-center-section .e-cancel::before {\n        content: '\\e825';\n    }\n\n    .toast-action-center-section .e-toast-collapse::before {\n        content: \"\\e85e\";\n    }\n\n    .toast-action-center-section #action_panel span {\n        margin-left: 5px;\n        align-items: center;\n        position: relative;\n        top: 2px;\n    }\n\n    .toast-action-center-section #toast_action_center_target .e-toast-container .e-toast {\n        padding: 5px;\n        margin: 0;\n        border-radius: 0;\n        width: 100%;\n        box-shadow: none;\n    }\n\n    .toast-action-center-section #toast_action_center_target .toast-content {\n        margin: 0 5px;\n    }\n\n    .toast-action-center-section .layoutWrapper {\n        border: 1px solid black;\n        width: 285px;\n        height: 505px;\n        margin: auto;\n        margin-bottom: 15px;\n        border-radius: 28px;\n        position: relative;\n    }\n\n    .toast-action-center-section .device_notification {\n        height: 15px;\n        background-color: blue;\n        width: 100%;\n    }\n\n    .toast-action-center-section .notification_panel {\n        position: relative;\n        overflow: hidden;\n        background-color: inherit;\n    }\n\n    .material .toast-action-center-section .notification_panel {\n      background-color: #323232;\n    }\n\n    .fabric .toast-action-center-section .notification_panel {\n      background-color: #f4f4f4;\n    }\n\n    .toast-action-center-section #action_notify {\n        color: #000;\n    }\n\n    .material .toast-action-center-section #action_notify,\n    .highcontrast .toast-action-center-section #action_notify {\n        color: #fff;\n    }\n\n    .toast-action-center-section .device_notification .notify_intication {\n        padding-top: 8px;\n    }\n\n    .toast-action-center-section .device_notification .notify_intication .intication {\n        width: 15px;\n        border-bottom: 1px solid white;\n        margin: auto;\n    }\n\n    .toast-action-center-section .device_notification .notify_intication .intication:last-child {\n        margin-top: 2px;\n    }\n\n    .toast-action-center-section .speaker {\n        border: 1px solid black;\n        border-radius: 5px;\n        width: 33.33333333%;\n        height: 5px;\n        margin: 15px auto 0px auto;\n        position: relative;\n    }\n\n    .toast-action-center-section .outerButton {\n        width: 30px;\n        height: 30px;\n        border: 1px solid black;\n        border-radius: 50%;\n        position: absolute;\n        bottom: calc(0% + 10px);\n        left: calc(50% - 15px);\n    }\n\n    .toast-action-center-section .camera {\n        position: absolute;\n        left: calc(-15% - 10px);\n        top: -100%;\n        width: 10px;\n        height: 10px;\n        border-radius: 50%;\n        border: 1px solid black;\n    }\n\n    .toast-action-center-section .layoutWrapper .layout {\n        border: 1px solid black;\n        margin: 20px 13px 0px 13px;\n\n    }\n\n    .toast-action-center-section #list-container {\n        height: 405px;\n        touch-action: none;\n    }\n\n    .material .toast-action-center-section .e-toast .e-input-arrow {\n        color: white;\n    }\n\n    .highcontrast .toast-action-center-section .layoutWrapper .layout,\n    .highcontrast .toast-action-center-section .layoutWrapper .camera,\n    .highcontrast .toast-action-center-section .layoutWrapper .outerButton,\n    .highcontrast .toast-action-center-section .layoutWrapper .speaker,\n    .highcontrast .toast-action-center-section .layoutWrapper {\n        border-color: white;\n    }\n</style>\n</div></body></html>"}