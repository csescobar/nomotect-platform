{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"col-lg-9 control-section\" style=\"overflow:auto;\">\n    <div class=\"content-wrapper\">\n        <div id=\"PivotView\" style=\"height:100%;\">\n        </div>\n    </div>\n</div>\n\n<div class=\"col-lg-3 property-section pivot-property-section\">\n    <table id=\"property\" title=\"Properties\" style=\"width: 100%;height:100%;\" class=\"pivot-property-panel-table\">\n        <tbody>\n            <tr style=\"height: 50px\">\n                <td>\n                    <div class=\"hdrlabel\">Pager Position\n                    </div>\n                </td>\n                <td>\n                    <div>\n                        <input type=\"text\" tabindex=\"0\" id=\"Pager_Position\">\n                    </div>\n                </td>\n            </tr>\n            <tr style=\"height: 50px\">\n                <td>\n                    <div class=\"hdrlabel\">Show Pager\n                    </div>\n                </td>\n                <td>\n                    <div>\n                        <input type=\"text\" tabindex=\"0\" id=\"Pager_View\">\n                    </div>\n                </td>\n            </tr>\n            <tr style=\"height: 50px\">\n                <td>\n                    <div class=\"hdrlabel\">Show Page Size\n                    </div>\n                </td>\n                <td>\n                    <div>\n                        <input type=\"text\" tabindex=\"0\" id=\"Page_Size\">\n                    </div>\n                </td>\n            </tr>\n            <tr style=\"height: 50px\">\n                <td>\n                    <div class=\"hdrlabel\">Compact View\n                    </div>\n                </td>\n                <td>\n                    <div>\n                        <input id=\"Compact_View\" type=\"checkbox\" aria-label=\"multiselect\">\n                    </div>\n                </td>\n            </tr>\n            <tr style=\"height: 50px\">\n                <td>\n                    <div class=\"hdrlabel\">Inverse Pager\n                    </div>\n                </td>\n                <td>\n                    <div>\n                        <input id=\"Inverse\" type=\"checkbox\" aria-label=\"multiselect\">\n                    </div>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n</div>\n\n\n\n<style>\n    .sb-sample-content-area {\n        min-height: 255px !important;\n    }\n\n    .control-section {\n        min-height: 255px !important;\n    }\n\n    #PivotViewcontainerwrapper {\n        height: auto !important;\n    }\n\n    .e-bigger .e-float-input.e-control-wrapper {\n        width: 100% !important;\n    }\n\n    .pivot-property-panel-table div {\n        padding: 0;\n    }\n\n    .pivot-property-panel-table {\n        margin-left: 10px;\n    }\n</style>\n</div></body></html>"}