{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"col-lg-8  control-section\">\n    <div class=\"sample-container\">\n        <!-- Initialize FileManager -->\n        <div id=\"file\"></div>\n    </div>\n</div>\n<div class=\"col-lg-4 property-section\" id=\"all-option-table\">\n        <table id=\"property\" title=\"Properties\">\n            <tbody>\n                <tr id=\"rangeSelectionRow\">\n                    <td style=\"width: 50%\">\n                        <div id=\"checkboxElement\">Enable Range Selection</div>\n                    </td>\n                    <td style=\"width: 50%;padding-right: 10px;text-align: center;\">\n                        <div>\n                            <input id=\"rangeSelection\" type=\"checkbox\">\n                        </div>\n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"width: 50%\">\n                        <div id=\"checkboxElement\">Toolbar</div>\n                    </td>\n                    <td style=\"width: 50%;padding-right: 10px;text-align: center;\">\n                        <div>\n                            <input id=\"toolbar\" type=\"checkbox\">\n                        </div>\n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"width: 50%\">\n                        <div id=\"checkboxElement\">Show File Extension</div>\n                    </td>\n                    <td style=\"width: 50%;padding-right: 10px;text-align: center;\">\n                        <div>\n                            <input id=\"fileExtension\" type=\"checkbox\">\n                        </div>\n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"width: 50%\">\n                        <div id=\"checkboxElement\">Show Thumbnail</div>\n                    </td>\n                    <td style=\"width: 50%;padding-right: 10px;text-align: center;\">\n                        <div>\n                            <input id=\"thumbnail\" type=\"checkbox\">\n                        </div>\n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"width: 50%\">\n                        <div id=\"checkboxElement\">Disable Toolbar Item</div>\n                    </td>\n                    <td style=\"width: 50%;padding-left: 10px;text-align: center;\">\n                        <div>\n                            <input id=\"disable\" type=\"text\">\n                        </div>\n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"width: 50%\">\n                        <div id=\"checkboxElement\">Enable Toolbar Item</div>\n                    </td>\n                    <td style=\"width: 50%;padding-left: 10px;text-align: center;\">\n                        <div>\n                            <input id=\"enable\" type=\"text\">\n                        </div>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n</div>\n\n\n\n\n\n\n<style>\n    .property-panel-table div {\n        padding-left: 0;\n        padding-top: 0;\n    }\n\n    #all-option-table .property-panel-section .property-panel-content table#property tr {\n        height: 50px;\n    }\n    #checkboxElement {\n        font-size:14px;\n    }\n\n     @media (max-width: 550px) {\n        #rangeSelectionRow {\n            display: none ;\n        }\n    }\n\n</style>\n\n</div></body></html>"}