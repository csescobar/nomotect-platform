{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<main>\n    <div class=\"control-section\" align=\"center\">\n        <div id=\"gauge\" class=\"row\">\n            <div class=\"cols-sample-area\" align=\"center\">\n                <div class=\"divide\">\n                    <div class=\"col-lg-9 col-md-9\" id=\"column1\" style=\"margin-left: -5%\">\n                        <div id=\"gauge1\"></div>\n                    </div>\n                </div>\n                <div class=\"col-lg-3 col-md-3\" style=\"margin-left: -9%\">\n                    <div class=\"panel\" id=\"panel1\" align=\"center\">\n                        <div class=\"subgauge\" id=\"gauge2\" style=\"float: left;margin-top: 2%\"></div>\n                        <div class=\"borderContent\">\n                            <span class=\"firstcontent\" style=\"font-size: 17px;\">MOVE</span>\n                            <span class=\"firstcontent\" style=\"font-size: 17px;color: #fa114f;\">65%</span><br>\n                            <span class=\"secondcontent\" style=\"color: #fa114f; font-size: 19px\">338/520 CAL</span>\n                        </div>\n                    </div>\n                    <div class=\"panel\" id=\"panel2\" align=\"center\">\n                        <div class=\"subgauge\" id=\"gauge3\" style=\"float: left;margin-top: 2%\"></div>\n                        <div class=\"borderContent\">\n                            <span class=\"firstcontent\" style=\"font-size: 17px;\">EXERCISE</span>\n                            <span class=\"firstcontent\" style=\"font-size: 17px;color: #99ff01;\">43%</span><br>\n                            <span class=\"secondcontent\" style=\"color: #99ff01;; font-size: 19px\">13/30 MIN</span>\n                        </div>\n                    </div>\n                    <div class=\"panel\" id=\"panel3\" align=\"center\">\n                        <div class=\"subgauge\" id=\"gauge4\" style=\"float: left;margin-top: 2%\"></div>\n                        <div class=\"borderContent\">\n                            <span class=\"firstcontent\" style=\"font-size: 17px;\">STAND</span>\n                            <span class=\"firstcontent\" style=\"font-size: 17px;color: #00d8fe\">58%</span><br>\n                            <span class=\"secondcontent\" style=\"color: #00d8fe; font-size: 19px\">7/12 HR</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n    \n    \n    \n    <style>\n        .divide {\n            margin-left: 0%;\n        }\n    \n        .panel {\n            width: 190px !important;\n            height: 70px !important;\n            margin-left: 5% !important;\n            margin-top: 10% !important;\n            border-color: lightgray;\n            float: left;\n            background-color: transparent;\n        }\n    \n        .borderContent {\n            float: left !important;\n            margin-left: 65px !important;\n            margin-top: -62px !important;\n            text-align: left !important;\n            width: 126px;\n            height: auto;\n        }\n    \n        @media screen and (max-width: 1160px) {\n            .panel {\n                width: 165px !important;\n            }\n    \n            .firstcontent {\n                font-size: 13px !important;\n            }\n    \n            .secondcontent {\n                font-size: 15px !important;\n            }\n    \n            .borderContent {\n                margin-top: -62px !important;\n            }\n    \n            .divide {\n                margin-left: 0%;\n            }\n        }\n    \n        @media screen and (max-width: 990px) {\n            .panel {\n                width: 190px !important;\n                height: 70px !important;\n                margin-left: 37% !important;\n                margin-top: 0% !important;\n            }\n    \n            .subgauge {\n                margin-left: 0% !important;\n                margin-top: 1% !important;\n            }\n    \n            .borderContent {\n                margin-left: 63px !important;\n                margin-top: -63px !important;\n            }\n    \n            .firstcontent {\n                font-size: 16px !important;\n            }\n    \n            .secondcontent {\n                font-size: 18px !important;\n            }\n    \n            .divide {\n                margin-left: 0%;\n            }\n        }\n    \n        @media screen and (min-width: 768px) {\n            .divide {\n                margin-left: 10%;\n            }\n        }\n    \n        @media screen and (max-width: 410px) {\n            .divide {\n                margin-left: 10%;\n            }\n    \n            #column1 {\n                margin-left: -9% !important;\n            }\n    \n            .subgauge {\n                margin-left: 3% !important;\n            }\n    \n            .panel {\n                width: 165px !important;\n            }\n    \n            .borderContent {\n                margin-top: -35% !important;\n            }\n        }\n\n        .e-view.highcontrast div.annotation5 {\n            margin-left: 2px;\n            margin-top: -2px;\n        }\n\n\n        .e-view.fluent2 div.annotation4,\n        .e-view.fluent2-dark div.annotation4,\n        .e-view.fluent2-dark div.annotation5\n        {\n            margin-left: 1px;\n        }\n\n        .e-view.fluent2-dark div.annotation6\n        {\n            margin-top: -1px;\n        }\n    \n        .e-view.fabric div.annotation4,\n        .e-view.fabric-dark div.annotation4 {\n            height: 17px;\n            width: 17px;\n            margin-left: 2px;\n            margin-bottom: 2px;\n            margin-top: -3px;\n        }\n\n        .e-view.fabric div.annotation5,\n        .e-view.fabric-dark div.annotation5 {\n            height: 17px;\n            width: 17px;\n            margin-left: 2px;\n            margin-bottom: 4px;\n        }\n\n        .e-view.fabric div.annotation6,\n        .e-view.fabric-dark div.annotation6 {\n            height: 17px;\n            width: 17px;\n            margin-top: -7px;\n            margin-left: 1px;\n        }\n    \n        .e-view.bootstrap5 div.annotation4,\n        .e-view.bootstrap5-dark div.annotation4 {\n            margin-left: 4px;\n            margin-top: 2px;\n            height: 17px;\n            width: 17px;\n        }\n    \n        .e-view.bootstrap5 div.annotation5,\n        .e-view.bootstrap5-dark div.annotation5 {\n            height: 17px;\n            width: 17px;\n            margin-left: 1px;\n            margin-top: 2px;\n        }\n    \n        .e-view.bootstrap5 div.annotation6,\n        .e-view.bootstrap5-dark div.annotation6 {\n            margin-top: -1px;\n            margin-left: 1px;\n        }\n    \n        .e-view.material div.annotation4,\n        .e-view.material-dark div.annotation4,\n        .e-view.bootstrap div.annotation4,\n        .e-view.bootstrap-dark div.annotation4,\n        .e-view.bootstrap4 div.annotation4 {\n            height: 17px;\n            width: 17px;\n            margin-left: 2px;\n            margin-top: 1px;\n        }\n    \n        .e-view.highcontrast div.annotation4 {\n            margin-left: 2px;\n            margin-top: 1px;\n        }\n    \n        .e-view.material div.annotation5,\n        .e-view.material-dark div.annotation5,\n        .e-view.bootstrap div.annotation5,\n        .e-view.bootstrap-dark div.annotation5,\n        .e-view.bootstrap4 div.annotation5 {\n            height: 17px;\n            width: 17px;\n            margin-left: 2px;\n            margin-top: 2px;\n        }\n    </style>\n</main>\n</div></body></html>"}