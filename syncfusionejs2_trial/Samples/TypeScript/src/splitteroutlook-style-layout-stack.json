{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div id=\"target\" class=\"control-section\">\n    <div id=\"splitter1\">\n        <div>\n            <div class=\"outlook-layout-content\">\n                <div id=\"tree\"></div>\n            </div>\n        </div>\n        <div>\n            <div class=\"outlook-layout-content\">\n                <div id=\"groupedList\" tabindex=\"1\"></div>\n            </div>\n        </div>\n        <div>\n            <div class=\"outlook-layout-content\">\n                <div style=\"width: 100%; padding: 15px;\">\n                    <table role=\"presentation\">\n                        <tbody><tr>\n                            <td><button class=\"e-btn e-flat e-outline\">To...</button></td>\n                            <td><input id=\"firstname\" aria-label=\"firstname\"></td>\n                        </tr>\n                        <tr>\n                            <td><button class=\"e-btn e-flat e-outline\">Cc...</button></td>\n                            <td><input id=\"lastname\" aria-label=\"lastname\"></td>\n                        </tr>\n                        <tr>\n                            <td><div id=\"subject-text\">Subject</div></td>\n                            <td><input id=\"subject\" aria-label=\"subject\"></td>\n                        </tr>\n                    </tbody></table>\n                </div>\n                <div class=\"forum\">\n                    <div id=\"createpostholder\">\n                        <div id=\"defaultRTE\"> </div>\n                        <div id=\"buttonSection\">\n                            <button class=\"e-btn e-primary\" id=\"send\">Send</button>\n                            <button class=\"e-btn\" id=\"discard\">Discard</button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n\n    <!-- Template to render tree node -->\n    <script id=\"treeTemplate\" type=\"text/x-template\">\n        <div>\n            <div class=\"treeviewdiv\">\n                <div style=\"float:left\">\n                    <span class=\"treeName\">${name}</span>\n                </div>\n                ${if(count)}\n                    <div style=\"margin-right: 5px; float:right\">\n                        <span class=\"treeCount e-badge e-badge-primary\">${count}</span>\n                    </div>\n                ${/if}\n            </div>\n        </div>\n    </script>\n    <style>\n    #discard {\n        margin-left: 7px;\n    }\n    .outlook-layout-content table {\n        width: 100%;\n    }\n    .outlook-layout-content td {\n        padding: 2px;\n    }\n    .control-section{            \n        min-height: 370px;  \n    }\n    .outlook-layout-content .e-treeview .e-list-text {\n        width: 100%;\n    }\n    #groupedList.e-listview .e-list-group-item {\n        height: 0;\n    }\n    #splitter1 .settings.e-list-wrapper.e-list-multi-line.e-list-avatar {\n        padding: 15px;\n    }\n    #buttonSection {\n        padding: 7px;\n    }\n    .outlook-layout-content #createpostholder {\n        padding-right: 4px;\n        padding-left: 3px;\n    }\n\t#splitter1 #tree ul.e-list-parent.e-ul {\n\t\tpadding: 0 0 0 16px;\n\t}\n    .material3-dark .e-listview.e-list-template .e-list-wrapper.e-list-multi-line .e-list-item-header,\n    .material-dark .e-listview.e-list-template .e-list-wrapper.e-list-multi-line .e-list-item-header {\n        color : #fff;\n    }\n\n    .material3-dark .e-listview.e-list-template .e-list-wrapper.e-list-multi-line .e-list-content,\n    .material-dark .e-listview.e-list-template .e-list-wrapper.e-list-multi-line .e-list-content {\n        color : #9ca3af;\n    }\n\n    .material3-dark .e-listview.e-list-template .e-list-item.e-hover .e-list-content,\n    .material-dark .e-listview.e-list-template .e-list-item.e-hover .e-list-content {\n        color : #fff;\n    }\n\n    .tailwind .e-list-parent.e-ul,\n    .tailwind-dark .e-list-parent.e-ul,\n    .tailwind3 .e-list-parent.e-ul,\n    .tailwind3-dark .e-list-parent.e-ul {\n        overflow : hidden;\n    }\n</style>\n\n\n\n</div></body></html>"}