{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"control-section\">\n    <div class=\"row skeleton-default\">\n        <div class=\"col-sm-6\">\n            <p class=\"displayText\">Circle</p>\n            <div id=\"skeletonCircleSmall\"></div>\n            <div id=\"skeletonCircleMedium\"></div>\n            <div id=\"skeletonCircleLarge\"></div>\n            <div id=\"skeletonCircleLarger\"></div>\n        </div>\n        <div class=\"col-sm-6\">\n            <p class=\"displayText\">Square</p>\n            <div id=\"skeletonSquareSmall\"></div>\n            <div id=\"skeletonSquareMedium\"></div>\n            <div id=\"skeletonSquareLarge\"></div>\n            <div id=\"skeletonSquareLarger\"></div>\n        </div>\n    </div>\n    <div class=\"row skeleton-default\">\n        <div class=\"col-sm-6\">\n            <p class=\"displayText\">Text</p>\n            <div id=\"skeletonText\"></div>\n            <div id=\"skeletonTextMedium\"></div>\n            <br>\n            <div id=\"skeletonTextSmall\"></div>\n            <br>\n            <div id=\"skeletonTextMedium1\"></div>\n            <br>\n            <div id=\"skeletonTextSmall1\"></div>\n        </div>\n        <div class=\"col-sm-6\">\n            <p class=\"displayText\">Rectangle</p>\n            <div id=\"skeletonRectangle\"></div>\n            <div id=\"skeletonRectangleMedium\" style=\"float:left;\"></div>\n            <div id=\"skeletonRectangleMediumRight\" style=\"float:right;\"></div>\n        </div>\n    </div>\n</div>\n\n\n\n\n<style>\n    .skeleton-default .col-sm-6 {\n        padding: 20px;\n        min-height: 150px;\n        position: relative;\n    }\n    \n    p.displayText {\n        margin: 10px 0px;\n        font-weight: 500;\n    }\n</style>\n</div></body></html>"}