{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div id=\"target\" class=\"control-section\">\n    <button class=\"e-control e-btn\" id=\"dialogBtn\" role=\"button\" e-ripple=\"true\" style=\"position: absolute;\">Open Dialog</button>\n    <div id=\"dialog\">\n      <table id=\"poschange\">\n      <tbody><tr> \n        <td><input id=\"radio1\" type=\"radio\" name=\"xy\"></td> \n        <td><input id=\"radio2\" type=\"radio\" name=\"xy\"></td> \n        <td><input id=\"radio3\" type=\"radio\" name=\"xy\"></td> \n      </tr> \n      <tr> \n        <td><input id=\"radio4\" type=\"radio\" name=\"xy\"></td>\n        <td><input id=\"radio5\" type=\"radio\" name=\"xy\"></td>\n        <td><input id=\"radio6\" type=\"radio\" name=\"xy\"></td>\n      </tr> \n      <tr> \n        <td><input id=\"radio7\" type=\"radio\" name=\"xy\"></td>\n        <td><input id=\"radio8\" type=\"radio\" name=\"xy\"></td>\n        <td><input id=\"radio9\" type=\"radio\" name=\"xy\"></td>\n      </tr>\n      </tbody></table>\n    </div>\n</div>\n\n\n<style>\n    .control-section{            \n        min-height: 370px;\n        margin-bottom: 15px;\n        margin-top: 10px;    \n    }\n\n    .fluent.e-bigger .control-section .e-dialog,\n    .fluent-dark.e-bigger .control-section .e-dialog {\n      width: 502px !important;\n    }\n\n    #poschange {\n      width: 405px;\n    }\n\n    .fluent.e-bigger #poschange,\n    .fluent-dark.e-bigger #poschange {\n      width: 455px;\n    }\n\n    #dialog table,\n    #dialog th,\n    #dialog td {\n        border: 1px solid #D8D8D8;\n        border-collapse: collapse;\n    }\n\n    #dialog.e-dialog .e-footer-content {\n        padding: 0px 10px 10px;\n    }\n\n    .e-dialog .e-dlgcontent{\n        padding: 10px 16px 10px;\n    }     \n\n    .e-radio +label .e-label {\n    line-height:18px;\n    }\n\n    td {\n    padding: 6px;\n    }\n    .bootstrap .e-dialog .e-footer-content {\n    padding: 5px;\n    }\n    .fabric .e-dialog .e-footer-content, .highcontrast .e-dialog .e-footer-content {\n        padding-left: 2px;\n    }\n    .fabric .control-section, .highcontrast .control-section {\n        min-height: 370px;\n        margin-bottom: 38px;\n        margin-top: 10px;\n    }\n    .highcontrast .e-dialog .e-dlg-content, .fabric .e-dialog .e-dlg-content {\n        padding: 28px 19px 20px;\n    }\n\n</style>\n\n\n\n</div></body></html>"}