{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"control-section\">\n    <div id=\"dropdown-control\" style=\"margin-bottom:5px;\">\n        <table style=\"width: 300px; margin-left: 10px;\">\n            <tbody>\n                <tr style=\"height: 50px\">\n                    <td>\n                        <div><b>Content Type:</b>\n                        </div>\n                    </td>\n                    <td>\n                        <div>\n                            <select id=\"contenttype\" name=\"ddl-view-mode\">\n                                <option value=\"JSON\" selected=\"\">JSON</option>\n                                <option value=\"CSV\">CSV</option>\n                            </select>\n                        </div>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    <div class=\"content-wrapper\">\n        <div id=\"PivotView1\" style=\"height:100%;\">\n        </div>\n    </div>\n</div>\n\n\n\n\n\n<style>\n    .control-section {\n        padding-top: 10px;\n    }\n</style>\n</div></body></html>"}