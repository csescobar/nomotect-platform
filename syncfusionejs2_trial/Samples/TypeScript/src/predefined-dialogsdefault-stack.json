{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div id=\"predefinedDialogDefault\" class=\"col-lg-12 control-section\">\n    <!-- Buttons to open corresponding Dialog -->\n    <button id=\"alertBtn\" class=\"dlgbtn\" type=\"button\">Alert</button>\n    <button id=\"confirmBtn\" class=\"dlgbtn\" type=\"button\">Confirm</button>\n    <button id=\"promptBtn\" class=\"dlgbtn\" type=\"button\">Prompt</button>\n    <span id=\"statusText\"></span>\n</div>\n\n\n\n\n</div></body></html>"}