{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"col-lg-12 control-section\" style=\"padding-bottom: 100px\">\n    <div class=\"e-sample-resize-container toolbar-type-section\">\n        <h1 style=\"display: inline-block\">Simple Toolbar</h1>\n        <div id=\"toolbar_default\">\n        </div> <br><br>\n        <h1 style=\"display: inline-block\">Scrollable Toolbar</h1>\n        <div id=\"toolbar_Scrollable\">\n        </div> <br><br>\n        <h1 style=\"display: inline-block\">Popup Toolbar</h1>\n        <div id=\"toolbar_popup\">\n        </div> <br><br>\n        <h1 style=\"display: inline-block\">MultiRow Toolbar</h1>\n        <div id=\"toolbar_MultiRow\">\n        </div> <br><br>\n        <h1 style=\"display: inline-block\">Extended Toolbar</h1>\n        <div id=\"toolbar_Extended\">\n        </div>\n    </div>\n</div>\n\n\n\n<style>\n    /* Toolbar Styles */\n\n    .control-wrapper {\n        flex-direction: inherit\n    }\n\n    .toolbar-type-section h1 {\n        font-size: 18px;\n    }\n\n    @media only screen and (min-width: 1224px) {\n        .e-sample-resize-container {\n            margin: auto;\n            width: 80%;\n        }\n    }\n\n    @media only screen and (min-width: 1824px) {\n        .e-sample-resize-container {\n            width: 50%;\n        }\n    }\n</style>\n\n</div></body></html>"}