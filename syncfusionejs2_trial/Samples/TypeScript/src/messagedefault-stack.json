{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n﻿<div class=\"col-lg-12 control-section msg-default-section\">\n    <div class=\"content-section\">\n        <div id=\"msg_default\"></div>\n        <div id=\"msg_info\"></div>\n        <div id=\"msg_success\"></div>\n        <div id=\"msg_warning\"></div>\n        <div id=\"msg_error\"></div>\n    </div>\n</div>\n\n\n\n<style>\n    .msg-default-section .content-section {\n        margin: 0 auto;\n        max-width: 520px;\n        padding-top: 10px;\n    }\n\n    .msg-default-section .e-message {\n        margin: 10px 0;\n    }\n</style>\n</div></body></html>"}