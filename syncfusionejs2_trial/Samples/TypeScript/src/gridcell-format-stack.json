{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div class=\"control-section\">\n    <div class=\"content-wrapper\">\n        <table style=\"width: 100%\">\n            <tbody><tr>\n                <td style=\"width: 33.3%\">\n                    <select id=\"Number\" class=\"form-control\">\n                        <option value=\"N2\" style=\"height: 32px;\">Rounding - N2</option>\n                        <option value=\"N3\">Rounding - N3</option>\n                        <option value=\"N5\">Rounding - N5</option>\n                    </select>\n                </td>\n                <td style=\"width: 33.3%\">\n                    <select id=\"Currency\" class=\"form-control\">\n                        <option value=\"C2\">Rounding - C2</option>\n                        <option value=\"C3\">Rounding - C3</option>\n                        <option value=\"C5\">Rounding - C5</option>\n                    </select>\n                </td>\n                <td style=\"width: 33.3%\">\n                    <select id=\"Date\" class=\"form-control\">\n                        <option value=\"MM/dd/yyyy\">MM/dd/yyyy</option>\n                        <option value=\"dd/MM/yyyy\">dd/MM/yyyy</option>\n                        <option value=\"dd/MM/yy\">dd/MM/yy</option>\n                    </select>\n                </td>\n            </tr>\n            <tr>\n                <td colspan=\"3\">\n                    <div id=\"Grid\"> </div>\n                </td>\n            </tr>\n        </tbody></table>\n    </div>\n</div>\n</div></body></html>"}