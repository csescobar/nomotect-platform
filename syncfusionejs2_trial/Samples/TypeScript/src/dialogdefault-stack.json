{"index.html":"<html><head><link href=\"https://cdn.syncfusion.com/ej2/28.1.33/{{theme}}.css\" rel=\"stylesheet\">\n\n    <link href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <style>\n            body{\n                touch-action:none;\n            }\n            .control-section{\n                margin-top:100px;\n            }\n        </style></head><body><div class=\"stackblitz-container {{theme}}\">\n<div id=\"target\" class=\"col-lg-12 control-section\" style=\"height:100%; width:100%;\">\n<div style=\"position:relative; top:10px; left:10px;\">\n        <!-- Button to open the default Dialog -->\n        <button id=\"dialogBtn\" type=\"button\">Open</button>\n    </div>\n    <!-- Initialize default Dialog -->\n    <div id=\"defaultDialog\">\n        <p>\n            In the Succinctly series, Syncfusion created a robust, free library of more than 130 technical e-books formatted for PDF, Kindle, and EPUB. <br><br> The Succinctly series was born in 2012 out of a desire to provide concise technical e-books for software developers.\n            Each title in the Succinctly series is written by a carefully chosen expert and provides essential content in about 100 pages.\n        </p>\n    </div>\n</div>   \n\n\n<style>\n    .e-btn-hide {\n\t    display: none;\n\t}\n</style>\n\n\n</div></body></html>"}