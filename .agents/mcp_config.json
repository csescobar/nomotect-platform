{
  "mcpServers": {
    "nomotect-repository-intelligence": {
      "command": "bash",
      "args": [
        "-lc",
        "exec \"$(git rev-parse --show-toplevel)/bin/nomotect-mcp\""
      ],
      "env": {
        "MCP_ALLOW_WRITES": "false",
        "CODE_GRAPH_PROVIDER": "null"
      }
    }
  }
}
