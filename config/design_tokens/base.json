{
  "control.height": "2.75rem",
  "font.family.body": "Inter, ui-sans-serif, system-ui, sans-serif",
  "font.family.heading": "Manrope, Inter, ui-sans-serif, system-ui, sans-serif",
  "font.family.mono": "\"JetBrains Mono\", \"SFMono-Regular\", Consolas, monospace",
  "font.family.sans": "Inter, ui-sans-serif, system-ui, sans-serif",
  "font.size.lg": "1.25rem",
  "font.size.md": "1rem",
  "font.size.sm": "0.875rem",
  "font.size.xl": "1.5rem",
  "font.size.xs": "0.75rem",
  "font.size.xxl": "1.875rem",
  "font.weight.bold": "700",
  "font.weight.medium": "500",
  "font.weight.regular": "400",
  "font.weight.semibold": "600",
  "line.height.body": "1.5",
  "line.height.code": "1.45",
  "line.height.heading": "1.2",
  "radius.full": "9999px",
  "radius.lg": "0.75rem",
  "radius.md": "0.5rem",
  "radius.sm": "0.25rem",
  "shadow.lg": "0 10px 15px rgb(15 23 42 / 0.12), 0 4px 6px rgb(15 23 42 / 0.08)",
  "shadow.md": "0 4px 6px rgb(15 23 42 / 0.10), 0 1px 3px rgb(15 23 42 / 0.08)",
  "shadow.sm": "0 1px 2px rgb(15 23 42 / 0.08)",
  "space.lg": "1.5rem",
  "space.md": "1rem",
  "space.sm": "0.5rem",
  "space.xl": "2rem",
  "space.xs": "0.25rem",
  "space.xxl": "3rem",
  "transition.fast": "120ms ease",
  "transition.medium": "250ms ease",
  "transition.slow": "400ms ease"
}
