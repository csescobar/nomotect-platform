<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("application.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="app-header">
      <strong><%= t("application.name") %></strong>
      <% if authenticated? %>
        <%= button_to t("authentication.sign_out"), session_path, method: :delete, class: "button button--secondary" %>
      <% end %>
    </header>

    <main class="app-main">
      <% flash.each do |type, message| %>
        <div class="flash flash--<%= type %>" role="status"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
