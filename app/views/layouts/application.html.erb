<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("application.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script nonce="<%= content_security_policy_nonce %>">
      (() => {
        const preference = localStorage.getItem("rails-hotwire-platform-theme");
        if (preference === "light" || preference === "dark") {
          document.documentElement.dataset.theme = preference;
        }
      })();
    </script>
    <%= stylesheet_link_tag "design_tokens", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% if authenticated? %>
      <% navigation_items = [ { label: t("layout.dashboard"), href: root_path, active: current_page?(root_path) } ] %>
      <% account_actions = capture do %>
        <%= button_to t("authentication.sign_out"), session_path, method: :delete, class: "button button--secondary" %>
      <% end %>

      <%= render Ui::Layout::ApplicationShellComponent.new(
        navigation_items: navigation_items,
        current_user: Current.user,
        account_actions: account_actions
      ) do %>
        <% flash.each do |type, message| %>
          <div class="flash flash--<%= type %>" role="status"><%= message %></div>
        <% end %>
        <%= yield %>
      <% end %>
    <% else %>
      <header class="app-header">
        <strong><%= t("application.name") %></strong>
        <div class="app-header__actions">
          <%= render Ui::ThemeSwitcherComponent.new %>
        </div>
      </header>

      <main class="app-main" id="main-content">
        <% flash.each do |type, message| %>
          <div class="flash flash--<%= type %>" role="status"><%= message %></div>
        <% end %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
