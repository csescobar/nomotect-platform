<% content_for :title, t("grid_engine.#{@definition.key}.title") %>
<% current_columns = Array(params[:columns]).presence || @preferences["columns"] %>

<%= render Ui::Layout::PageHeaderComponent.new(
  title: t("grid_engine.#{@definition.key}.title"),
  description: t("grid_engine.#{@definition.key}.description")
) %>

<%# ── EJ2 Grid (Syncfusion) ────────────────────────────────────────────────── %>
<%#
  Columns are serialized server-side so the EJ2 Grid knows field names, types,
  sorting and filtering capabilities without an extra HTTP round-trip.
  The JSON endpoint uses ?adapter=syncfusion to return { result:, count: } as
  required by EJ2 Custom Data Binding / UrlAdaptor.
%>
<% columns_json = GridEngine::SyncfusionAdapter.new(@definition).columns.to_json %>
<% syncfusion_url = grid_path(@definition.key, format: :json, adapter: :syncfusion) %>

<section class="showcase__section grid-page-section" aria-labelledby="grid-results-heading">
  <h2 id="grid-results-heading" class="visually-hidden"><%= t("grid_engine.#{@definition.key}.title") %></h2>

  <div
    data-controller="ej2-grid"
    data-ej2-grid-url-value="<%= syncfusion_url %>"
    data-ej2-grid-columns-value="<%= columns_json %>"
    data-ej2-grid-page-size-value="25"
    class="ej2-grid-container"
    aria-label="<%= t("grid_engine.#{@definition.key}.title") %>"
    id="ej2-grid-<%= @definition.key %>"
  ></div>

  <%# Accessible HTML fallback — rendered for screen readers, no-JS, print and tests %>
  <noscript>
    <turbo-frame id="grid-results">
      <p aria-live="polite"><%= t("grid_engine.results", count: @result.total_count) %></p>
      <%= GridEngine::HtmlRenderer.new(@definition, @result.records, columns: current_columns).call %>
    </turbo-frame>
  </noscript>
</section>
