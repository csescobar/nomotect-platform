<% content_for :title, t("grid_engine.#{@definition.key}.title") %>

<%= render Ui::Layout::PageHeaderComponent.new(
  title: t("grid_engine.#{@definition.key}.title"),
  description: t("grid_engine.#{@definition.key}.description")
) do %>
  <%= link_to t("grid_engine.actions.export"), grid_path(@definition.key, format: :csv, view_id: @selected_view&.id), class: "button button--secondary" %>
<% end %>

<section class="showcase__section" aria-labelledby="grid-controls-heading">
  <h2 id="grid-controls-heading"><%= t("grid_engine.controls.title") %></h2>

  <%= form_with url: grid_path(@definition.key), method: :get, data: { turbo_frame: "grid-results" }, html: { class: "showcase__form" } do |form| %>
    <%= form.label :name_filter, t("grid_engine.controls.name_filter") %>
    <%= form.search_field :name_filter, value: params[:name_filter], class: "ui-input" %>
    <%= form.hidden_field "filters[][column]", value: "name" %>
    <%= form.hidden_field "filters[][operator]", value: "contains" %>
    <%= form.hidden_field "filters[][value]", value: params[:name_filter] %>

    <%= form.label :sort_direction, t("grid_engine.controls.sort_direction") %>
    <%= form.select :sort_direction,
      [[ t("grid_engine.sort.asc"), "asc" ], [ t("grid_engine.sort.desc"), "desc" ]],
      { selected: params[:sort_direction] || "asc" },
      class: "ui-input" %>
    <%= form.hidden_field "sorts[][column]", value: "name" %>
    <%= form.hidden_field "sorts[][direction]", value: params[:sort_direction] || "asc" %>

    <fieldset class="ui-field">
      <legend class="ui-field__label"><%= t("grid_engine.controls.columns") %></legend>
      <% selected = Array(@preferences["columns"]).presence || @definition.columns.values.select(&:visible).map(&:key) %>
      <% @definition.columns.each_value do |column| %>
        <label class="ui-checkbox-field__label">
          <%= check_box_tag "columns[]", column.key, selected.include?(column.key), id: "column_#{column.key}", class: "ui-checkbox" %>
          <span><%= column.label || column.key.humanize %></span>
        </label>
      <% end %>
    </fieldset>

    <%= form.submit t("grid_engine.actions.apply"), class: "button button--primary" %>
  <% end %>
</section>

<section class="showcase__section" aria-labelledby="saved-views-heading">
  <h2 id="saved-views-heading"><%= t("grid_engine.saved_views.title") %></h2>

  <% if @saved_views.any? %>
    <ul>
      <% @saved_views.each do |saved_view| %>
        <li>
          <%= link_to saved_view.name, grid_path(@definition.key, view_id: saved_view.id) %>
          <% if saved_view.default? %><span class="badge"><%= t("grid_engine.saved_views.default") %></span><% end %>
          <%= button_to t("grid_engine.actions.delete"), grid_grid_saved_view_path(@definition.key, saved_view), method: :delete, class: "button button--danger button--small" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with url: grid_grid_saved_views_path(@definition.key), scope: :grid_saved_view, html: { class: "showcase__form" } do |form| %>
    <%= form.label :name, t("grid_engine.saved_views.name") %>
    <%= form.text_field :name, required: true, maxlength: 80, class: "ui-input" %>
    <%= form.hidden_field :query_json, value: @query_params.to_json %>
    <%= form.hidden_field :preferences_json, value: { columns: Array(params[:columns]).presence || @preferences["columns"] }.to_json %>
    <label class="ui-checkbox-field__label">
      <%= form.check_box :default, class: "ui-checkbox" %>
      <span><%= t("grid_engine.saved_views.make_default") %></span>
    </label>
    <%= form.submit t("grid_engine.actions.save_view"), class: "button button--secondary" %>
  <% end %>
</section>

<%= turbo_frame_tag "grid-results" do %>
  <p aria-live="polite"><%= t("grid_engine.results", count: @result.total_count) %></p>
  <%= GridEngine::HtmlRenderer.new(
    @definition,
    @result.records,
    columns: Array(params[:columns]).presence || @preferences["columns"]
  ).call %>
<% end %>
