<%# ── EJ2 Toasts Section ────────────────────────────────────────────────────────── %>
<div class="ej2-showcase-section">
  <header class="ej2-showcase-section__header">
    <h2 class="ej2-showcase-section__title"><%= t("ej2_showcase.toasts.title") %></h2>
    <p class="ej2-showcase-section__desc"><%= t("ej2_showcase.toasts.description") %></p>
  </header>

  <div class="ej2-showcase-card" id="ej2-toasts-demo">
    <div class="ej2-showcase-card__header">
      <h3 class="ej2-showcase-card__title"><%= t("ej2_showcase.toasts.demo.title") %></h3>
      <p class="ej2-showcase-card__desc"><%= t("ej2_showcase.toasts.demo.description") %></p>
    </div>
    <div class="ej2-showcase-card__demo" data-controller="ej2-toast">
      <div class="ej2-button-group">
        <button type="button"
                class="e-btn e-success-btn"
                data-action="click->ej2-toast#showSuccess"
                data-ej2-toast-message-param="<%= t("ej2_showcase.toasts.demo.success_msg") %>">
          <%= t("ej2_showcase.toasts.demo.success_btn") %>
        </button>

        <button type="button"
                class="e-btn e-danger"
                data-action="click->ej2-toast#showError"
                data-ej2-toast-message-param="<%= t("ej2_showcase.toasts.demo.danger_msg") %>">
          <%= t("ej2_showcase.toasts.demo.danger_btn") %>
        </button>

        <button type="button"
                class="e-btn e-warning-btn"
                data-action="click->ej2-toast#showWarning"
                data-ej2-toast-message-param="<%= t("ej2_showcase.toasts.demo.warning_msg") %>">
          <%= t("ej2_showcase.toasts.demo.warning_btn") %>
        </button>

        <button type="button"
                class="e-btn e-info-btn"
                data-action="click->ej2-toast#showInfo"
                data-ej2-toast-message-param="<%= t("ej2_showcase.toasts.demo.info_msg") %>">
          <%= t("ej2_showcase.toasts.demo.info_btn") %>
        </button>
      </div>

      <div class="ej2-toast-container"></div>
    </div>
  </div>

  <%# ── Feedback & Overlays (Phase 2 Pacote B) ─────────────────────────────── %>
  <div class="ej2-showcase-card" id="ej2-overlays-demo">
    <div class="ej2-showcase-card__header">
      <h3 class="ej2-showcase-card__title">Feedback & Overlays (Syncfusion ViewComponents)</h3>
      <p class="ej2-showcase-card__desc">Componentes Ui::Syncfusion::ToastComponent, TooltipComponent, SpinnerComponent e PopoverComponent</p>
    </div>
    <div class="ej2-showcase-card__demo">
      <div class="ej2-showcase-grid">
        <div class="ej2-showcase-grid__item">
          <h4 class="ej2-showcase-grid__title">Ui::Syncfusion::TooltipComponent</h4>
          <%= render Ui::Syncfusion::TooltipComponent.new(message: "Alerta de segurança ativo", position: "TopCenter") do %>
            <button type="button" class="button button--secondary">Passe o mouse aqui</button>
          <% end %>
        </div>

        <div class="ej2-showcase-grid__item">
          <h4 class="ej2-showcase-grid__title">Ui::Syncfusion::PopoverComponent</h4>
          <%= render Ui::Syncfusion::PopoverComponent.new(title: "Detalhes do Sistema", trigger_text: "Informações") do %>
            <p style="font-size: 0.875rem; color: var(--color-text-muted);">Servidor operando com 99.9% de uptime sob o protocolo NomoTect.</p>
          <% end %>
        </div>

        <div class="ej2-showcase-grid__item">
          <h4 class="ej2-showcase-grid__title">Ui::Syncfusion::SpinnerComponent</h4>
          <div style="min-height: 4.5rem; position: relative; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: var(--space-sm); display: flex; align-items: center; justify-content: center;">
            <%= render Ui::Syncfusion::SpinnerComponent.new(label: "Sincronizando...", size: "small", auto_hide: 3000) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
