<%# ── EJ2 Forms Section ────────────────────────────────────────────────────── %>
<div class="ej2-showcase-section">
  <header class="ej2-showcase-section__header">
    <h2 class="ej2-showcase-section__title"><%= t("ej2_showcase.forms.title") %></h2>
    <p class="ej2-showcase-section__desc"><%= t("ej2_showcase.forms.description") %></p>
  </header>

  <%# ── Checkbox, Radio, Switch, Slider & InputGroup ───────────────────────── %>
  <div class="ej2-showcase-card" id="ej2-forms-basic">
    <div class="ej2-showcase-card__header">
      <h3 class="ej2-showcase-card__title">Controles de Formulários Básicos (Syncfusion ViewComponents)</h3>
      <p class="ej2-showcase-card__desc">Componentes Checkbox, RadioGroup, Toggle (Switch), Slider e InputGroup emparelhados sob Ui::Syncfusion::*</p>
    </div>
    <div class="ej2-showcase-card__demo">
      <div class="showcase__grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.5rem; width: 100%;">
        <div>
          <h4>Ui::Syncfusion::CheckboxComponent</h4>
          <%= render Ui::Syncfusion::CheckboxComponent.new(name: "ej2_demo[alerts]", label: t("showcase.examples.checkbox_label"), checked: true, help_text: t("showcase.examples.checkbox_help")) %>
        </div>
        <div>
          <h4>Ui::Syncfusion::RadioGroupComponent</h4>
          <%= render Ui::Syncfusion::RadioGroupComponent.new(
            name: "ej2_demo[risk]",
            legend: t("showcase.examples.radio_legend"),
            options: [
              { label: t("showcase.examples.radio_low"), value: "low", checked: true },
              { label: t("showcase.examples.radio_high"), value: "high" }
            ]
          ) %>
        </div>
        <div>
          <h4>Ui::Syncfusion::ToggleComponent (Switch)</h4>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <%= render Ui::Syncfusion::ToggleComponent.new(name: "ej2_demo[notifications]", label: t("showcase.examples.toggle_notifications"), checked: true) %>
            <%= render Ui::Syncfusion::ToggleComponent.new(name: "ej2_demo[dark_mode]", label: t("showcase.examples.toggle_dark_mode"), checked: false) %>
          </div>
        </div>
        <div>
          <h4>Ui::Syncfusion::SliderComponent</h4>
          <%= render Ui::Syncfusion::SliderComponent.new(name: "ej2_demo[threshold]", label: t("showcase.examples.slider_threshold"), value: 65, min: 0, max: 100, step: 5) %>
        </div>
        <div>
          <h4>Ui::Syncfusion::InputGroupComponent</h4>
          <%= render Ui::Syncfusion::InputGroupComponent.new(name: "ej2_demo[contract]", value: "150.000", prefix: "R$", suffix: ",00", label: t("showcase.examples.input_group_price")) %>
        </div>
      </div>
    </div>
  </div>

  <%# ── TextBox ──────────────────────────────────────────────────────────────── %>
  <div class="ej2-showcase-card" id="ej2-forms-textbox">
    <div class="ej2-showcase-card__header">
      <h3 class="ej2-showcase-card__title"><%= t("ej2_showcase.forms.text_input.title") %></h3>
      <p class="ej2-showcase-card__desc"><%= t("ej2_showcase.forms.text_input.description") %></p>
    </div>
    <div class="ej2-showcase-card__demo">
      <div class="ej2-form-group"
           data-controller="ej2-textbox"
           data-ej2-textbox-placeholder-value="<%= t("ej2_showcase.forms.text_input.placeholder") %>">
        <label for="demo-textbox" class="ej2-form-group__label">
          <%= t("ej2_showcase.forms.text_input.label") %>
        </label>
        <input
          id="demo-textbox"
          type="text"
          aria-describedby="demo-textbox-help"
        >
        <p class="ej2-form-group__help" id="demo-textbox-help">
          <%= t("ej2_showcase.forms.text_input.help") %>
        </p>
      </div>

      <div class="ej2-form-group"
           data-controller="ej2-textbox"
           data-ej2-textbox-placeholder-value="<%= t("ej2_showcase.forms.text_input.placeholder") %>"
           data-ej2-textbox-value-value="Acme Corporation"
           data-ej2-textbox-readonly-value="true">
        <label for="demo-textbox-readonly" class="ej2-form-group__label">
          <%= t("ej2_showcase.forms.text_input.label") %> (Read-only)
        </label>
        <input
          id="demo-textbox-readonly"
          type="text"
        >
      </div>
    </div>
  </div>

  <%# ── NumericTextBox ──────────────────────────────────────────────────────── %>
  <div class="ej2-showcase-card" id="ej2-forms-numeric">
    <div class="ej2-showcase-card__header">
      <h3 class="ej2-showcase-card__title"><%= t("ej2_showcase.forms.numeric_input.title") %></h3>
      <p class="ej2-showcase-card__desc"><%= t("ej2_showcase.forms.numeric_input.description") %></p>
    </div>
    <div class="ej2-showcase-card__demo">
      <div class="ej2-form-group"
           data-controller="ej2-numeric"
           data-ej2-numeric-placeholder-value="<%= t("ej2_showcase.forms.numeric_input.placeholder") %>"
           data-ej2-numeric-value-value="1"
           data-ej2-numeric-min-value="1"
           data-ej2-numeric-max-value="1000">
        <label for="demo-numeric" class="ej2-form-group__label">
          <%= t("ej2_showcase.forms.numeric_input.label") %>
        </label>
        <input
          id="demo-numeric"
          type="text"
          aria-describedby="demo-numeric-help"
        >
        <p class="ej2-form-group__help" id="demo-numeric-help">
          <%= t("ej2_showcase.forms.numeric_input.help") %>
        </p>
      </div>
    </div>
  </div>

  <%# ── DropDownList ────────────────────────────────────────────────────────── %>
  <div class="ej2-showcase-card" id="ej2-forms-dropdown">
    <div class="ej2-showcase-card__header">
      <h3 class="ej2-showcase-card__title"><%= t("ej2_showcase.forms.dropdown.title") %></h3>
      <p class="ej2-showcase-card__desc"><%= t("ej2_showcase.forms.dropdown.description") %></p>
    </div>
    <div class="ej2-showcase-card__demo">
      <div class="ej2-form-group"
           data-controller="ej2-dropdown"
           data-ej2-dropdown-placeholder-value="<%= t("ej2_showcase.forms.dropdown.placeholder") %>"
           data-ej2-dropdown-items-value="<%= [
             { value: "active",   text: t("ej2_showcase.forms.dropdown.options.active") },
             { value: "inactive", text: t("ej2_showcase.forms.dropdown.options.inactive") },
             { value: "pending",  text: t("ej2_showcase.forms.dropdown.options.pending") },
             { value: "archived", text: t("ej2_showcase.forms.dropdown.options.archived") }
           ].to_json %>">
        <label for="demo-dropdown" class="ej2-form-group__label">
          <%= t("ej2_showcase.forms.dropdown.label") %>
        </label>
        <input
          id="demo-dropdown"
          type="text"
          aria-describedby="demo-dropdown-help"
        >
        <p class="ej2-form-group__help" id="demo-dropdown-help">
          <%= t("ej2_showcase.forms.dropdown.help") %>
        </p>
      </div>
    </div>
  </div>

  <%# ── DatePicker ──────────────────────────────────────────────────────────── %>
  <div class="ej2-showcase-card" id="ej2-forms-datepicker">
    <div class="ej2-showcase-card__header">
      <h3 class="ej2-showcase-card__title"><%= t("ej2_showcase.forms.datepicker.title") %></h3>
      <p class="ej2-showcase-card__desc"><%= t("ej2_showcase.forms.datepicker.description") %></p>
    </div>
    <div class="ej2-showcase-card__demo">
      <div class="ej2-form-group"
           data-controller="ej2-datepicker"
           data-ej2-datepicker-placeholder-value="<%= t("ej2_showcase.forms.datepicker.placeholder") %>"
           data-ej2-datepicker-format-value="<%= I18n.locale == :"pt-BR" ? "dd/MM/yyyy" : "MM/dd/yyyy" %>">
        <label for="demo-datepicker" class="ej2-form-group__label">
          <%= t("ej2_showcase.forms.datepicker.label") %>
        </label>
        <input
          id="demo-datepicker"
          type="text"
          aria-describedby="demo-datepicker-help"
        >
        <p class="ej2-form-group__help" id="demo-datepicker-help">
          <%= t("ej2_showcase.forms.datepicker.help") %>
        </p>
      </div>
    </div>
  </div>

  <%# ── MultiSelect ────────────────────────────────────────────────────────── %>
  <div class="ej2-showcase-card" id="ej2-forms-multiselect">
    <div class="ej2-showcase-card__header">
      <h3 class="ej2-showcase-card__title"><%= t("ej2_showcase.forms.multiselect.title") %></h3>
      <p class="ej2-showcase-card__desc"><%= t("ej2_showcase.forms.multiselect.description") %></p>
    </div>
    <div class="ej2-showcase-card__demo">
      <div class="ej2-form-group"
           data-controller="ej2-multiselect"
           data-ej2-multiselect-placeholder-value="<%= t("ej2_showcase.forms.multiselect.placeholder") %>"
           data-ej2-multiselect-items-value="<%= [
             { value: "critical", text: t("ej2_showcase.forms.multiselect.options.critical") },
             { value: "high",     text: t("ej2_showcase.forms.multiselect.options.high") },
             { value: "medium",   text: t("ej2_showcase.forms.multiselect.options.medium") },
             { value: "low",      text: t("ej2_showcase.forms.multiselect.options.low") },
             { value: "review",   text: t("ej2_showcase.forms.multiselect.options.review") }
           ].to_json %>">
        <label for="demo-multiselect" class="ej2-form-group__label">
          <%= t("ej2_showcase.forms.multiselect.label") %>
        </label>
        <input
          id="demo-multiselect"
          type="text"
          aria-describedby="demo-multiselect-help"
        >
        <p class="ej2-form-group__help" id="demo-multiselect-help">
          <%= t("ej2_showcase.forms.multiselect.help") %>
        </p>
      </div>
    </div>
  </div>
</div>
