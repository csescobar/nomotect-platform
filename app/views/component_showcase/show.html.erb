<% content_for :title, t("showcase.title") %>

<div class="showcase">
  <%= render Ui::Layout::PageHeaderComponent.new(title: t("showcase.title"), description: t("showcase.description")) %>

  <%# ── Navigation Index Bar ───────────────────────────────── %>
  <nav class="showcase__nav-index" aria-label="Showcase Navigation">
    <a href="#showcase-typography" class="showcase__nav-link"><%= t("showcase.sections.typography") %></a>
    <a href="#showcase-colors" class="showcase__nav-link"><%= t("showcase.sections.colors") %></a>
    <a href="#showcase-spacing" class="showcase__nav-link"><%= t("showcase.sections.spacing") %></a>
    <a href="#showcase-buttons" class="showcase__nav-link"><%= t("showcase.sections.buttons") %></a>
    <a href="#showcase-basic-controls" class="showcase__nav-link"><%= t("showcase.sections.basic_controls") %></a>
    <a href="#showcase-pickers" class="showcase__nav-link"><%= t("showcase.sections.pickers") %></a>
    <a href="#showcase-advanced-inputs" class="showcase__nav-link"><%= t("showcase.sections.advanced_inputs") %></a>
    <a href="#showcase-avatars" class="showcase__nav-link"><%= t("showcase.sections.avatars") %></a>
    <a href="#showcase-navigation" class="showcase__nav-link"><%= t("showcase.sections.navigation") %></a>
    <a href="#showcase-progress" class="showcase__nav-link"><%= t("showcase.sections.progress") %></a>
    <a href="#showcase-overlays" class="showcase__nav-link"><%= t("showcase.sections.overlays") %></a>
    <a href="#showcase-feedback" class="showcase__nav-link"><%= t("showcase.sections.feedback") %></a>
    <a href="#showcase-containers" class="showcase__nav-link"><%= t("showcase.sections.containers") %></a>
    <a href="#showcase-formatting" class="showcase__nav-link"><%= t("showcase.sections.formatting") %></a>
  </nav>

  <%# ── Typography ──────────────────────────────────────────── %>
  <section class="showcase__section" id="showcase-typography" aria-labelledby="showcase-typography-heading">
    <h2 id="showcase-typography-heading"><%= t("showcase.sections.typography") %></h2>
    <p class="showcase__section-desc"><%= t("showcase.typography_desc") %></p>
    <div class="showcase__typo-scale">
      <div class="showcase__typo-row">
        <span class="showcase__typo-label">font-size-xxl</span>
        <span class="showcase__typo--xxl">Heading Display</span>
      </div>
      <div class="showcase__typo-row">
        <span class="showcase__typo-label">font-size-xl</span>
        <span class="showcase__typo--xl">Section Title</span>
      </div>
      <div class="showcase__typo-row">
        <span class="showcase__typo-label">font-size-lg</span>
        <span class="showcase__typo--lg">Large Body Text</span>
      </div>
      <div class="showcase__typo-row">
        <span class="showcase__typo-label">font-size-md</span>
        <span class="showcase__typo--md">Regular Body Text — the quick brown fox jumps over the lazy dog</span>
      </div>
      <div class="showcase__typo-row">
        <span class="showcase__typo-label">font-size-sm</span>
        <span class="showcase__typo--sm">Small / Help Text</span>
      </div>
      <div class="showcase__typo-row">
        <span class="showcase__typo-label">font-size-xs</span>
        <span class="showcase__typo--xs">Extra-small / Label Text</span>
      </div>
      <div class="showcase__typo-row">
        <span class="showcase__typo-label">font-family-mono</span>
        <code class="showcase__typo--mono">const greeting = "Hello, World!"</code>
      </div>
      <div class="showcase__typo-row">
        <span class="showcase__typo-label">font-weight-bold</span>
        <span class="showcase__typo--bold">Bold weight text</span>
      </div>
      <div class="showcase__typo-row">
        <span class="showcase__typo-label">font-weight-semibold</span>
        <span class="showcase__typo--semibold">Semibold weight text</span>
      </div>
    </div>
  </section>

  <%# ── Colors ─────────────────────────────────────────────── %>
  <section class="showcase__section" id="showcase-colors" aria-labelledby="showcase-colors-heading">
    <h2 id="showcase-colors-heading"><%= t("showcase.sections.colors") %></h2>
    <p class="showcase__section-desc"><%= t("showcase.colors_desc") %></p>
    <div class="showcase__swatches">
      <% [
        "background", "surface", "surface-subtle", "text", "text-muted",
        "border", "primary", "on-primary", "success", "on-success",
        "warning", "on-warning", "danger", "on-danger", "focus"
      ].each do |name| %>
        <div class="showcase__swatch">
          <div class="showcase__swatch-color showcase__swatch-color--<%= name %>"></div>
          <span class="showcase__swatch-name"><%= name %></span>
        </div>
      <% end %>
    </div>
  </section>

  <%# ── Spacing ─────────────────────────────────────────────── %>
  <section class="showcase__section" id="showcase-spacing" aria-labelledby="showcase-spacing-heading">
    <h2 id="showcase-spacing-heading"><%= t("showcase.sections.spacing") %></h2>
    <p class="showcase__section-desc"><%= t("showcase.spacing_desc") %></p>
    <div class="showcase__spacing-scale">
      <% [
        ["space-xs",  "0.25rem"],
        ["space-sm",  "0.5rem"],
        ["space-md",  "1rem"],
        ["space-lg",  "1.5rem"],
        ["space-xl",  "2rem"],
        ["space-xxl", "3rem"],
      ].each do |name, size| %>
        <div class="showcase__spacing-row">
          <span class="showcase__spacing-label"><%= name %> — <%= size %></span>
          <div class="showcase__spacing-bar showcase__spacing-bar--<%= name %>"></div>
        </div>
      <% end %>
    </div>
  </section>

  <%# ── Buttons ─────────────────────────────────────────────── %>
  <section class="showcase__section" id="showcase-buttons" aria-labelledby="showcase-buttons-heading">
    <h2 id="showcase-buttons-heading"><%= t("showcase.sections.buttons") %></h2>
    <div class="showcase__row">
      <% Ui::ButtonComponent::VARIANTS.each do |variant| %>
        <%= render Ui::ButtonComponent.new(label: variant.to_s.humanize, variant: variant) %>
      <% end %>
      <%= render Ui::ButtonComponent.new(label: t("showcase.disabled"), disabled: true) %>
    </div>
  </section>

  <%# ── Selection & Entry Controls ───────────────────────────── %>
  <section class="showcase__section" id="showcase-basic-controls" aria-labelledby="showcase-basic-controls-heading">
    <h2 id="showcase-basic-controls-heading"><%= t("showcase.sections.basic_controls") %></h2>
    <div class="showcase__grid">
      <div>
        <h3>CheckboxComponent</h3>
        <%= render Ui::Forms::CheckboxComponent.new(label: t("showcase.examples.checkbox_label"), input_id: "showcase_checkbox", input_html: check_box_tag("showcase[audit_alerts]", "1", true, id: "showcase_checkbox"), help_text: t("showcase.examples.checkbox_help")) %>
      </div>
      <div>
        <h3>RadioGroupComponent</h3>
        <%= render Ui::Forms::RadioGroupComponent.new(legend: t("showcase.examples.radio_legend"), input_id: "showcase_radio", options_html: safe_join([ label_tag("risk_low", class: "ui-radio-option") { safe_join([ radio_button_tag("showcase[risk]", "low", true, id: "risk_low"), tag.span(t("showcase.examples.radio_low")) ]) }, label_tag("risk_high", class: "ui-radio-option") { safe_join([ radio_button_tag("showcase[risk]", "high", false, id: "risk_high"), tag.span(t("showcase.examples.radio_high")) ]) } ])) %>
      </div>
      <div>
        <h3>ToggleComponent (Switch)</h3>
        <div class="showcase__stack">
          <%= render Ui::Forms::ToggleComponent.new(name: "showcase_notifications", label: t("showcase.examples.toggle_notifications"), checked: true) %>
          <%= render Ui::Forms::ToggleComponent.new(name: "showcase_dark_mode", label: t("showcase.examples.toggle_dark_mode"), checked: false) %>
        </div>
      </div>
      <div>
        <h3>SliderComponent</h3>
        <%= render Ui::Forms::SliderComponent.new(name: "showcase_slider", value: 65, min: 0, max: 100, step: 5, label: t("showcase.examples.slider_threshold")) %>
      </div>
      <div>
        <h3>InputGroupComponent</h3>
        <%= render Ui::Forms::InputGroupComponent.new(name: "showcase_contract", value: "150.000", prefix: "R$", suffix: ",00", label: t("showcase.examples.input_group_price")) %>
      </div>
    </div>
  </section>

  <%# ── Date & Time Pickers ──────────────────────────────────── %>
  <section class="showcase__section" id="showcase-pickers" aria-labelledby="showcase-pickers-heading">
    <h2 id="showcase-pickers-heading"><%= t("showcase.sections.pickers") %></h2>
    <div class="showcase__grid">
      <div>
        <h3>DatePickerComponent</h3>
        <%= render Ui::Forms::DatePickerComponent.new(name: "showcase_date", value: Date.today, placeholder: t("showcase.examples.select_date")) %>
      </div>
      <div>
        <h3>DateRangePickerComponent</h3>
        <%= render Ui::Forms::DateRangePickerComponent.new(start_name: "showcase_start", end_name: "showcase_end", start_value: Date.today, end_value: Date.today + 14, placeholder: t("showcase.examples.select_date_range")) %>
      </div>
      <div>
        <h3>TimePickerComponent</h3>
        <%= render Ui::Forms::TimePickerComponent.new(name: "showcase_time", value: "15:30", placeholder: t("showcase.examples.select_time")) %>
      </div>
    </div>
  </section>

  <%# ── Advanced Inputs ───────────────────────────────────────── %>
  <section class="showcase__section" id="showcase-advanced-inputs" aria-labelledby="showcase-advanced-inputs-heading">
    <h2 id="showcase-advanced-inputs-heading"><%= t("showcase.sections.advanced_inputs") %></h2>
    <div class="showcase__grid">
      <div>
        <h3>AutocompleteComponent</h3>
        <%= render Ui::Forms::AutocompleteComponent.new(name: "showcase_country", suggestions: [t("showcase.examples.country_brazil"), t("showcase.examples.country_usa"), t("showcase.examples.country_germany"), t("showcase.examples.country_japan"), t("showcase.examples.country_canada")], placeholder: t("showcase.examples.start_typing")) %>
      </div>
      <div>
        <h3>ComboboxComponent</h3>
        <%= render Ui::Forms::ComboboxComponent.new(name: "showcase_category", options: [{ label: t("showcase.examples.cat_tech"), value: "tech" }, { label: t("showcase.examples.cat_fin"), value: "fin" }], selected: "fin", placeholder: t("showcase.examples.select_category")) %>
      </div>
      <div>
        <h3>MultiSelectComponent</h3>
        <%= render Ui::Forms::MultiSelectComponent.new(name: "showcase_tags", options: [{ label: "Ruby", value: "ruby" }, { label: "Rails", value: "rails" }], selected: ["ruby", "rails"], placeholder: t("showcase.examples.select_tags")) %>
      </div>
      <div>
        <h3>TagInputComponent</h3>
        <%= render Ui::Forms::TagInputComponent.new(name: "showcase_skills", tags: ["Ruby", "Rails", "Design System"], placeholder: t("showcase.examples.add_tag")) %>
      </div>
      <div>
        <h3>FileUploadComponent</h3>
        <%= render Ui::Forms::FileUploadComponent.new(name: "showcase_file", label: t("showcase.examples.upload_file"), accept: ".pdf,.png") %>
      </div>
    </div>
  </section>

  <%# ── Avatars & Badges ─────────────────────────────────────── %>
  <section class="showcase__section" id="showcase-avatars" aria-labelledby="showcase-avatars-heading">
    <h2 id="showcase-avatars-heading"><%= t("showcase.sections.avatars") %></h2>
    <div class="showcase__row">
      <%= render Ui::AvatarComponent.new(name: "Cesar Escobar", size: :sm) %>
      <%= render Ui::AvatarComponent.new(name: "Cesar Escobar", size: :md) %>
      <%= render Ui::AvatarComponent.new(name: "Cesar Escobar", size: :lg) %>
      <%= render Ui::AvatarGroupComponent.new(avatars: [ { name: "Alice Smith" }, { name: "Bob Jones" }, { name: "Charlie Brown" }, { name: "Diana Prince" } ]) %>
      <%= render Ui::RoleBadgeComponent.new(role: "admin") %>
      <%= render Ui::RoleBadgeComponent.new(role: "member") %>
    </div>
  </section>

  <%# ── Navigation & Steppers ────────────────────────────────── %>
  <section class="showcase__section" id="showcase-navigation" aria-labelledby="showcase-navigation-heading">
    <h2 id="showcase-navigation-heading"><%= t("showcase.sections.navigation") %></h2>
    <div class="showcase__stack">
      <div>
        <h3>StepperComponent</h3>
        <%= render Ui::StepperComponent.new(steps: [ { id: "1", label: t("showcase.examples.step_1") }, { id: "2", label: t("showcase.examples.step_2") }, { id: "3", label: t("showcase.examples.step_3") } ], current_step: "2") %>
      </div>
      <div>
        <h3>TabsComponent</h3>
        <%= render Ui::TabsComponent.new(tabs: [ { id: "general", label: t("showcase.examples.tab_general"), content: t("showcase.examples.tab_general_content") }, { id: "security", label: t("showcase.examples.tab_security"), content: t("showcase.examples.tab_security_content") } ], active_tab: "general") %>
      </div>
    </div>
  </section>

  <%# ── Progress & Skeletons ──────────────────────────────────── %>
  <section class="showcase__section" id="showcase-progress" aria-labelledby="showcase-progress-heading">
    <h2 id="showcase-progress-heading"><%= t("showcase.sections.progress") %></h2>
    <div class="showcase__stack">
      <div>
        <h3>ProgressBarComponent</h3>
        <%= render Ui::ProgressBarComponent.new(value: 85, show_label: true, label: t("showcase.examples.assurance_score")) %>
      </div>
      <div class="showcase__row">
        <h3>ProgressSpinnerComponent</h3>
        <%= render Ui::ProgressSpinnerComponent.new(size: :sm) %>
        <%= render Ui::ProgressSpinnerComponent.new(size: :md) %>
        <%= render Ui::ProgressSpinnerComponent.new(size: :lg) %>
      </div>
      <div>
        <h3>SkeletonComponent</h3>
        <div class="showcase__stack">
          <%= render Ui::SkeletonComponent.new(variant: :text) %>
          <%= render Ui::SkeletonComponent.new(variant: :card) %>
        </div>
      </div>
    </div>
  </section>

  <%# ── Overlays & Command Palette ───────────────────────────── %>
  <section class="showcase__section" id="showcase-overlays" aria-labelledby="showcase-overlays-heading">
    <h2 id="showcase-overlays-heading"><%= t("showcase.sections.overlays") %></h2>
    <div class="showcase__row">
      <div>
        <h3>TooltipComponent</h3>
        <%= render Ui::TooltipComponent.new(text: t("showcase.examples.tooltip_hint"), position: :top) do %>
          <%= render Ui::ButtonComponent.new(label: t("showcase.examples.hover_tooltip"), variant: :secondary) %>
        <% end %>
      </div>
      <div>
        <h3>PopoverComponent</h3>
        <%= render Ui::PopoverComponent.new(title: t("showcase.examples.popover_title")) do |popover| %>
          <% popover.with_trigger_slot { render Ui::ButtonComponent.new(label: t("showcase.examples.popover_button"), variant: :ghost) } %>
          <% popover.with_body_slot { t("showcase.examples.popover_content") } %>
        <% end %>
      </div>
    </div>
    <div>
      <h3>DangerZoneComponent</h3>
      <%= render Ui::DangerZoneComponent.new(id: "danger-showcase", title: t("showcase.examples.danger_zone_title"), description: t("showcase.examples.danger_zone_desc")) do %>
        <%= render Ui::ButtonComponent.new(label: t("showcase.examples.danger_zone_button"), variant: :danger) %>
      <% end %>
    </div>
  </section>

  <%# ── Feedback ─────────────────────────────────────────────── %>
  <section class="showcase__section" id="showcase-feedback" aria-labelledby="showcase-feedback-heading">
    <h2 id="showcase-feedback-heading"><%= t("showcase.sections.feedback") %></h2>
    <div class="showcase__stack">
      <% Ui::AlertComponent::VARIANTS.each do |variant| %>
        <%= render Ui::AlertComponent.new(title: variant.to_s.humanize, variant: variant).with_content(t("showcase.alert_body")) %>
      <% end %>
      <div class="showcase__row">
        <% Ui::BadgeComponent::VARIANTS.each do |variant| %>
          <%= render Ui::BadgeComponent.new(label: variant.to_s.humanize, variant: variant) %>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── Containers ──────────────────────────────────────────── %>
  <section class="showcase__section" id="showcase-containers" aria-labelledby="showcase-containers-heading">
    <h2 id="showcase-containers-heading"><%= t("showcase.sections.containers") %></h2>
    <div class="showcase__grid">
      <% Ui::CardComponent::VARIANTS.each do |variant| %>
        <%= render Ui::CardComponent.new(variant: variant) do %>
          <h3><%= variant.to_s.humanize %></h3>
          <p><%= t("showcase.card_body") %></p>
        <% end %>
      <% end %>
    </div>
    <%= render Ui::EmptyStateComponent.new(title: t("showcase.empty_title"), description: t("showcase.empty_description")) do %>
      <%= render Ui::ButtonComponent.new(label: t("showcase.empty_action")) %>
    <% end %>
  </section>

  <%# ── Formatting ───────────────────────────────────────────── %>
  <section class="showcase__section" id="showcase-formatting" aria-labelledby="showcase-formatting-heading">
    <h2 id="showcase-formatting-heading"><%= t("showcase.sections.formatting") %></h2>
    <dl class="showcase__grid">
      <div><dt><%= t("showcase.formatting.date") %></dt><dd><%= format_local_date(Date.new(2026, 7, 25)) %></dd></div>
      <div><dt><%= t("showcase.formatting.time") %></dt><dd><%= format_local_time(Time.utc(2026, 7, 25, 18, 30)) %></dd></div>
      <div><dt><%= t("showcase.formatting.number") %></dt><dd><%= format_local_number(12345.67) %></dd></div>
      <div><dt><%= t("showcase.formatting.percentage") %></dt><dd><%= format_local_percentage(42.5) %></dd></div>
      <div><dt><%= t("showcase.formatting.currency") %></dt><dd><%= format_local_currency(1234.5) %></dd></div>
    </dl>
  </section>
</div>
