#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "NomoTect MCP must be started from a NomoTect Git workspace." >&2
  exit 1
}

if [[ ! -f "$ROOT/bin/repository-intelligence" || ! -f "$ROOT/VISION.md" ]]; then
  echo "The current Git workspace is not a NomoTect platform repository." >&2
  exit 1
fi

if [[ "${MCP_ALLOW_WRITES:-false}" != "false" ]]; then
  echo "NomoTect adoption bootstrap requires MCP_ALLOW_WRITES=false." >&2
  exit 1
fi

export MCP_ALLOW_WRITES=false
export CODE_GRAPH_PROVIDER="${CODE_GRAPH_PROVIDER:-null}"
cd "$ROOT"
exec ruby bin/repository-intelligence mcp
