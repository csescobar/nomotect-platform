#!/usr/bin/env bash
set -euo pipefail

ruby -rjson -e 'ARGV.each { |path| JSON.parse(File.read(path)) }' \
  docs/contracts/epic-10-validation-plan.schema.json \
  docs/contracts/epic-10-finding.schema.json \
  docs/contracts/epic-10-certification.schema.json

bundle exec rails test test/services/epic_10/contract_validator_test.rb

grep -q '"additionalProperties": false' docs/contracts/epic-10-validation-plan.schema.json
grep -q '"critical", "high", "medium", "low"' docs/contracts/epic-10-finding.schema.json
grep -q 'passed certification requires every phase complete' app/services/epic_10/contract_validator.rb
grep -q 'critical and high findings cannot be accepted' app/services/epic_10/contract_validator.rb
grep -q 'must never publish automatically' docs/roadmap/epic-10-plan.md

printf 'Epic 10 validation contracts certified\n'
