#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require_relative "../lib/repository_intelligence/manifest_generator"
require_relative "../lib/repository_intelligence/providers/null_provider"
require_relative "../lib/repository_intelligence/platform"
require_relative "../lib/repository_intelligence/mcp_server"

root = File.expand_path("..", __dir__)
commit = ENV["GITHUB_SHA"].to_s
commit = Open3.capture2("git", "rev-parse", "HEAD", chdir: root).first.strip if commit.empty?
command = ARGV.shift || "generate"
manifest = RepositoryIntelligence::ManifestGenerator.new(repository_path: root, repository_commit: commit).generate
provider = RepositoryIntelligence::Providers::NullProvider.new.index(repository_path: root, repository_commit: commit)
graph = RepositoryIntelligence::GovernanceScanner.new(repository_path: root, manifest:, provider_result: provider).scan
contracts = RepositoryIntelligence::ContractRegistry.new(File.join(root, "config/ai/contracts"))
playbooks = RepositoryIntelligence::PlaybookRegistry.new(File.join(root, "config/ai/playbooks"))
report = RepositoryIntelligence::ReadinessReport.new(
  manifest:, graph:, contract_errors: contracts.validate, playbook_errors: playbooks.validate,
  indexed_commit: provider.repository_commit, current_commit: commit
).to_h

case command
when "generate"
  writer = RepositoryIntelligence::SnapshotWriter.new(output_directory: File.join(root, "docs/ai/generated"))
  writer.write("architecture-manifest", manifest)
  writer.write("repository-graph", graph.to_h.merge(repository_commit: commit))
  writer.write("contracts", contracts.load)
  writer.write("readiness-report", report)
  abort JSON.pretty_generate(report) unless report.fetch(:status) == "ready"
when "validate"
  abort JSON.pretty_generate(report) unless report.fetch(:status) == "ready"
  puts JSON.generate(report)
when "mcp"
  RepositoryIntelligence::McpServer.new(
    manifest:, graph:, contracts: contracts.load, playbooks: playbooks.load, readiness: report
  ).run
else
  abort "Usage: bin/repository-intelligence [generate|validate|mcp]"
end
