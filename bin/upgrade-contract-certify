#!/usr/bin/env bash
set -euo pipefail

ruby -rjson -e 'ARGV.each { |path| JSON.parse(File.read(path)) }' \
  docs/contracts/upgrade-manifest.schema.json \
  docs/contracts/upgrade-history.schema.json \
  docs/contracts/installed-platform-state.schema.json

bundle exec rails test \
  test/services/upgrades/version_test.rb \
  test/services/upgrades/manifest_test.rb \
  test/services/upgrades/planner_test.rb \
  test/services/upgrades/installed_state_detector_test.rb \
  test/services/upgrades/inspector_test.rb

grep -q 'additionalProperties": false' docs/contracts/upgrade-manifest.schema.json
grep -q 'recovery_required' docs/contracts/upgrade-history.schema.json
grep -q 'pending_migrations' docs/contracts/installed-platform-state.schema.json
grep -q 'does not execute arbitrary shell commands' docs/upgrades/architecture.md
grep -q 'inspection and preflight are read-only' config/ai/contracts/upgrades.yml
test -x bin/upgrade

printf 'Upgrade inspection and contract foundation certified\n'
